<Page x:Class="Uno.Themes.Samples.Content.OmarchyPaletteSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  mc:Ignorable="d"
	  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<!-- The "Theme" page of the flutter_omarchy gallery: pick a palette, see its colors and faces. -->
	<Page.Resources>
		<Style x:Key="SwatchStyle"
			   TargetType="Border">
			<Setter Property="Width" Value="20" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Margin" Value="0,0,8,8" />
		</Style>
	</Page.Resources>

	<ScrollViewer>
		<StackPanel Spacing="24"
					Margin="24,0"
					MaxWidth="1200">

			<StackPanel Spacing="12"
						Margin="0,16,0,0">
				<TextBlock Text="Palette"
						   Style="{StaticResource HeadlineSmall}" />
				<TextBlock Text="Every stock Omarchy palette. Switching one is the equivalent of `omarchy theme set`: the brushes are rewritten in place and everything on screen repaints."
						   TextWrapping="Wrap" />
				<ComboBox x:Name="PaletteSelector"
						  DisplayMemberPath="Name"
						  SelectionChanged="PaletteSelector_SelectionChanged"
						  HorizontalAlignment="Left"
						  MinWidth="240" />
				<TextBlock x:Name="ModeText"
						   Style="{StaticResource CaptionLarge}" />
			</StackPanel>

			<StackPanel Spacing="12">
				<TextBlock Text="Colors"
						   Style="{StaticResource TitleMedium}" />
				<StackPanel Orientation="Horizontal">
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBackgroundBrush}"
							BorderBrush="{ThemeResource OmarchyNormalBlackBrush}"
							BorderThickness="1"
							ToolTipService.ToolTip="background" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyForegroundBrush}"
							ToolTipService.ToolTip="foreground" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyAccentBrush}"
							ToolTipService.ToolTip="accent" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchySelectionBrush}"
							ToolTipService.ToolTip="selection" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyMutedBrush}"
							ToolTipService.ToolTip="muted" />
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyNormalBlackBrush}"
							ToolTipService.ToolTip="normal.black" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyNormalWhiteBrush}"
							ToolTipService.ToolTip="normal.white" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyNormalRedBrush}"
							ToolTipService.ToolTip="normal.red" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyNormalGreenBrush}"
							ToolTipService.ToolTip="normal.green" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyNormalBlueBrush}"
							ToolTipService.ToolTip="normal.blue" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyNormalCyanBrush}"
							ToolTipService.ToolTip="normal.cyan" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyNormalMagentaBrush}"
							ToolTipService.ToolTip="normal.magenta" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyNormalYellowBrush}"
							ToolTipService.ToolTip="normal.yellow" />
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBrightBlackBrush}"
							ToolTipService.ToolTip="bright.black" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBrightWhiteBrush}"
							ToolTipService.ToolTip="bright.white" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBrightRedBrush}"
							ToolTipService.ToolTip="bright.red" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBrightGreenBrush}"
							ToolTipService.ToolTip="bright.green" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBrightBlueBrush}"
							ToolTipService.ToolTip="bright.blue" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBrightCyanBrush}"
							ToolTipService.ToolTip="bright.cyan" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBrightMagentaBrush}"
							ToolTipService.ToolTip="bright.magenta" />
					<Border Style="{StaticResource SwatchStyle}"
							Background="{ThemeResource OmarchyBrightYellowBrush}"
							ToolTipService.ToolTip="bright.yellow" />
				</StackPanel>
			</StackPanel>

			<StackPanel Spacing="8"
						Margin="0,0,0,24">
				<TextBlock Text="Text"
						   Style="{StaticResource TitleMedium}" />
				<TextBlock Text="normal"
						   Style="{StaticResource BodyLarge}" />
				<TextBlock Text="bold"
						   Style="{StaticResource TitleMedium}" />
				<TextBlock Text="italic"
						   Style="{StaticResource CaptionLarge}"
						   FontSize="{ThemeResource BodyLargeFontSize}" />
			</StackPanel>

		</StackPanel>
	</ScrollViewer>
</Page>
