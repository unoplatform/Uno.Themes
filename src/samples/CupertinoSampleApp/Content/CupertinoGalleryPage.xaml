<Page x:Class="Uno.Themes.Samples.Content.CupertinoGalleryPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  Background="{ThemeResource BackgroundBrush}">
	<ScrollViewer x:Name="GalleryScroll">
		<StackPanel MaxWidth="560"
					Padding="20"
					Spacing="24"
					HorizontalAlignment="Stretch">
			<TextBlock Text="Cupertino"
					   Style="{StaticResource DisplayMedium}" />
			<TextBlock Text="Controls for your everyday tasks."
					   Style="{StaticResource BodyLarge}"
					   TextWrapping="Wrap" />
			<!-- Holds every switch knob and slider thumb in its Pressed (glass) state, to inspect the lens without a finger on it. -->
			<CheckBox x:Name="HoldKnobs"
					  Content="Hold knobs pressed (for screenshots)"
					  Checked="HoldKnobsChanged"
					  Unchecked="HoldKnobsChanged" />
			<StackPanel Spacing="8">
				<TextBlock Text="Preferences"
						   Style="{StaticResource TitleMedium}" />
				<Border Background="{ThemeResource SurfaceBrush}"
						CornerRadius="26"
						Padding="16,8">
					<StackPanel>
						<Grid MinHeight="56"
							  ColumnDefinitions="*,Auto">
							<TextBlock Text="Notifications"
									   Style="{StaticResource BodyLarge}"
									   VerticalAlignment="Center" />
							<ToggleSwitch Grid.Column="1"
										  IsOn="True"
										  AutomationProperties.Name="Notifications" />
						</Grid>
						<Rectangle Height="0.5"
								   Fill="{ThemeResource OutlineVariantBrush}"
								   UseLayoutRounding="False" />
						<Grid MinHeight="56"
							  ColumnDefinitions="*,Auto">
							<TextBlock Text="Background refresh"
									   Style="{StaticResource BodyLarge}"
									   VerticalAlignment="Center" />
							<ToggleSwitch Grid.Column="1"
										  AutomationProperties.Name="Background refresh" />
						</Grid>
						<Rectangle Height="0.5"
								   Fill="{ThemeResource OutlineVariantBrush}"
								   UseLayoutRounding="False" />
						<Grid MinHeight="56"
							  ColumnDefinitions="*,Auto">
							<TextBlock Text="Managed setting"
									   Style="{StaticResource BodyLarge}"
									   VerticalAlignment="Center" />
							<ToggleSwitch Grid.Column="1"
										  IsOn="True"
										  IsEnabled="False"
										  AutomationProperties.Name="Managed setting" />
						</Grid>
					</StackPanel>
				</Border>
			</StackPanel>
			<StackPanel Spacing="8">
				<TextBlock Text="Volume"
						   Style="{StaticResource TitleMedium}" />
				<Slider Value="55"
						HorizontalAlignment="Stretch"
						AutomationProperties.Name="Volume" />
				<Slider Value="30"
						IsEnabled="False"
						HorizontalAlignment="Stretch"
						AutomationProperties.Name="Unavailable volume" />
			</StackPanel>
			<StackPanel Spacing="12">
				<TextBlock Text="Your details"
						   Style="{StaticResource TitleMedium}" />
				<TextBox Header="Name"
						 Text="Alex Morgan"
						 Style="{StaticResource FilledTextBoxStyle}" />
				<PasswordBox Header="Password"
							 Password="password"
							 Style="{StaticResource FilledPasswordBoxStyle}" />
				<NumberBox Header="Guests"
						   Value="2"
						   Minimum="1"
						   Maximum="12"
						   HorizontalAlignment="Stretch" />
				<ComboBox Header="Destination"
						  SelectedIndex="0"
						  HorizontalAlignment="Stretch">
					<ComboBoxItem Content="Cupertino" />
					<ComboBoxItem Content="San Francisco" />
					<ComboBoxItem Content="New York" />
				</ComboBox>
				<CalendarDatePicker Header="Arrival"
									PlaceholderText="Choose a date" />
				<DatePicker Header="Departure" />
			</StackPanel>
			<StackPanel Spacing="12">
				<TextBlock Text="Actions"
						   Style="{StaticResource TitleMedium}" />
				<StackPanel Orientation="Horizontal"
							Spacing="8">
					<Button Content="Continue"
							Style="{StaticResource FilledButtonStyle}" />
					<Button Content="Later"
							Style="{StaticResource FilledTonalButtonStyle}" />
					<Button Content="Cancel"
							Style="{StaticResource TextButtonStyle}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal"
							Spacing="8">
					<ToggleButton Content="Favorites"
								  Style="{StaticResource TextToggleButtonStyle}"
								  IsChecked="True" />
					<ToggleButton Content="Downloads"
								  Style="{StaticResource TextToggleButtonStyle}" />
				</StackPanel>
				<Button Content="Show alert"
						Click="ShowAlert" />
				<Button Content="More actions">
					<Button.Flyout>
						<MenuFlyout>
							<MenuFlyoutItem Text="Copy">
								<MenuFlyoutItem.Icon>
									<SymbolIcon Symbol="Copy" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem Text="Share">
								<MenuFlyoutItem.Icon>
									<SymbolIcon Symbol="Share" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<ToggleMenuFlyoutItem Text="Keep offline"
												  IsChecked="True" />
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Text="Delete"
											Foreground="{ThemeResource ErrorBrush}">
								<MenuFlyoutItem.Icon>
									<SymbolIcon Symbol="Delete" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
			<StackPanel Spacing="12">
				<TextBlock Text="Library"
						   Style="{StaticResource TitleMedium}" />
				<ListView SelectionMode="Single"
						  SelectedIndex="1">
					<x:String>Recently added</x:String>
					<x:String>Favorites</x:String>
					<x:String>Downloads</x:String>
				</ListView>
				<PipsPager NumberOfPages="5"
						   SelectedPageIndex="2"
						   HorizontalAlignment="Center" />
				<ProgressBar Value="60"
							 HorizontalAlignment="Stretch" />
				<ProgressRing IsActive="True"
							  HorizontalAlignment="Center" />
			</StackPanel>
			<CommandBar DefaultLabelPosition="Collapsed">
				<AppBarButton Icon="Add"
							  Label="Add" />
				<AppBarButton Icon="Share"
							  Label="Share" />
				<CommandBar.SecondaryCommands>
					<AppBarButton Icon="Copy"
								  Label="Copy"
								  KeyboardAcceleratorTextOverride="Ctrl+C" />
					<AppBarButton Icon="Delete"
								  Label="Delete" />
				</CommandBar.SecondaryCommands>
			</CommandBar>
			<StackPanel Spacing="8">
				<TextBlock Text="Library options"
						   Style="{StaticResource TitleMedium}" />
				<CheckBox Content="Keep downloads"
						  IsChecked="True" />
				<RadioButton Content="Sort by title"
							 GroupName="SortOrder"
							 IsChecked="True" />
				<RadioButton Content="Sort by date"
							 GroupName="SortOrder" />
				<RatingControl Caption="Your rating"
							   Value="3"
							   AutomationProperties.Name="Your rating" />
				<HyperlinkButton Content="About your library"
								 NavigateUri="https://platform.uno"
								 ToolTipService.ToolTip="Visit Uno Platform" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</Page>
