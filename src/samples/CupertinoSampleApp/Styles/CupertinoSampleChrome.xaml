<!--
	The Cupertino head's sample chrome. Merged after the shared sample dictionaries, it replaces their Fluent-looking
	page layout, overview cards, sample boxes and appearance toggle with iOS / iPadOS ones built from the theme's
	semantic brushes, type slots and tokens. The shared dictionaries stay as they are for the Material and Simple heads.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="using:Uno.Themes.Samples"
					xmlns:smtx="using:ShowMeTheXAML">

	<ResourceDictionary.ThemeDictionaries>
		<!-- Pages paint the grouped background (systemGroupedBackground); samples sit on inset group surfaces over it. -->
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="ApplicationPageBackgroundThemeBrush" ResourceKey="BackgroundBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="ApplicationPageBackgroundThemeBrush" ResourceKey="BackgroundBrush" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!-- Unstyled sample text takes the theme's typeface instead of the framework fallback. -->
	<Style TargetType="TextBlock"
		   BasedOn="{StaticResource DefaultTextBlockStyle}">
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
	</Style>

	<!-- The appearance toggle is an iOS switch whose knob carries a sun or a moon. -->
	<Style x:Key="DarkLightToggleTheme"
		   TargetType="ToggleButton">
		<Setter Property="Width" Value="51" />
		<Setter Property="Height" Value="31" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid x:Name="Root"
						  Background="{ThemeResource CupertinoSecondarySystemFillBrush}"
						  CornerRadius="15.5">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver" />
								<VisualState x:Name="Pressed" />
								<VisualState x:Name="Disabled" />
								<VisualState x:Name="Checked">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource CupertinoToggleSwitchOnBackgroundBrush}" />
										<Setter Target="Knob.HorizontalAlignment" Value="Right" />
										<Setter Target="LightSymbol.Visibility" Value="Collapsed" />
										<Setter Target="DarkSymbol.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource CupertinoToggleSwitchOnBackgroundBrush}" />
										<Setter Target="Knob.HorizontalAlignment" Value="Right" />
										<Setter Target="LightSymbol.Visibility" Value="Collapsed" />
										<Setter Target="DarkSymbol.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPressed">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource CupertinoToggleSwitchOnBackgroundBrush}" />
										<Setter Target="Knob.HorizontalAlignment" Value="Right" />
										<Setter Target="LightSymbol.Visibility" Value="Collapsed" />
										<Setter Target="DarkSymbol.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<Grid x:Name="Knob"
							  Width="27"
							  Height="27"
							  Margin="2"
							  HorizontalAlignment="Left"
							  Background="{ThemeResource CupertinoToggleSwitchOnButtonBrush}"
							  CornerRadius="13.5">
							<Viewbox Width="15"
									 Height="15">
								<Grid>
									<Path x:Name="LightSymbol"
										  Data="{StaticResource LightModePathStyle}"
										  Fill="{ThemeResource CupertinoPrimaryGrayBrush}" />
									<Path x:Name="DarkSymbol"
										  Data="{StaticResource DarkModePathStyle}"
										  Fill="{ThemeResource CupertinoPrimaryGrayBrush}"
										  Visibility="Collapsed" />
								</Grid>
							</Viewbox>
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- "See XAML" is a footnote-sized plain button under each sample; its flyout keeps the shared behavior. -->
	<Style x:Key="SeeXamlFlyoutButtonStyle"
		   TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Button Content="See XAML"
							Padding="0"
							MinHeight="0"
							FontSize="{ThemeResource BodySmallFontSize}"
							Style="{StaticResource TextButtonStyle}">
						<Button.Flyout>
							<Flyout Placement="LeftEdgeAlignedBottom">
								<Flyout.FlyoutPresenterStyle>
									<Style TargetType="FlyoutPresenter"
										   BasedOn="{StaticResource FlyoutPresenterStyle}">
										<Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
										<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
										<Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
										<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
										<Setter Property="MinHeight" Value="0" />
										<Setter Property="MinWidth" Value="0" />
										<Setter Property="Margin" Value="40,100,40,40" />
									</Style>
								</Flyout.FlyoutPresenterStyle>
								<ScrollViewer HorizontalScrollMode="Enabled"
											  HorizontalScrollBarVisibility="Visible"
											  VerticalScrollMode="Enabled"
											  VerticalScrollBarVisibility="Visible">
									<TextBlock Text="{TemplateBinding Content}"
											   IsTextSelectionEnabled="True"
											   TextWrapping="NoWrap"
											   Style="{StaticResource BodySmall}"
											   Margin="16" />
								</ScrollViewer>
							</Flyout>
						</Button.Flyout>
					</Button>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Each sample sits on an inset group surface, with its "See XAML" link beneath. -->
	<Style x:Key="XamlDisplayBelowStyle"
		   TargetType="smtx:XamlDisplay">
		<Setter Property="Margin" Value="0,12,0,0" />
		<Setter Property="Formatter" Value="{StaticResource NiceFormatter}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="smtx:XamlDisplay">
					<StackPanel Spacing="6">
						<Border Background="{ThemeResource SurfaceBrush}"
								CornerRadius="{ThemeResource CupertinoGroupCornerRadius}"
								Padding="16">
							<ContentPresenter Content="{TemplateBinding Content}" />
						</Border>
						<Button Content="{TemplateBinding Xaml}"
								Margin="16,0"
								Style="{StaticResource SeeXamlFlyoutButtonStyle}" />
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="ExpandingXamlDisplayStyle"
		   TargetType="smtx:XamlDisplay"
		   BasedOn="{StaticResource XamlDisplayBelowStyle}">
		<Setter Property="Formatter" Value="{x:Null}" />
	</Style>

	<Style x:Key="XamlDisplayOnTheSideStyle"
		   TargetType="smtx:XamlDisplay">
		<Setter Property="Margin" Value="0,10,0,0" />
		<Setter Property="Formatter" Value="{StaticResource NiceFormatter}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="smtx:XamlDisplay">
					<StackPanel Orientation="Horizontal"
								Spacing="12">
						<ContentPresenter Content="{TemplateBinding Content}" />
						<Button Content="{TemplateBinding Xaml}"
								VerticalAlignment="Center"
								Style="{StaticResource SeeXamlFlyoutButtonStyle}" />
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="smtx:XamlDisplay"
		   BasedOn="{StaticResource XamlDisplayOnTheSideStyle}" />

	<!-- The header under the large title: the sample's description in the secondary label color. -->
	<DataTemplate x:Key="CupertinoSamplePageLayoutHeaderTemplate">
		<TextBlock Text="{Binding Description}"
				   Foreground="{ThemeResource OnSurfaceVariantBrush}"
				   Style="{StaticResource BodyLarge}"
				   Visibility="{Binding Description, Converter={StaticResource IsNullOrEmptyToCollapsed}, FallbackValue=Collapsed}"
				   Margin="0,0,0,8" />
	</DataTemplate>

	<!--
		An iPadOS detail page: a large title over the grouped background, then the Cupertino sample. The Material
		tabs, sticky tabs, mobile top bar and version picker are code-behind parts, so they stay, collapsed.
	-->
	<Style TargetType="local:SamplePageLayout">
		<Setter Property="HeaderTemplate" Value="{StaticResource CupertinoSamplePageLayoutHeaderTemplate}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:SamplePageLayout">
					<Grid Background="{ThemeResource BackgroundBrush}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<TextBlock x:Name="StickyTitle"
								   Text="{TemplateBinding Title}"
								   MaxLines="1"
								   TextWrapping="NoWrap"
								   Style="{StaticResource DisplayMedium}"
								   Margin="20,12,20,8" />

						<Grid x:Name="PART_MobileTopBar"
							  Visibility="Collapsed" />

						<ScrollViewer x:Name="PART_ScrollViewer"
									  Grid.Row="1">
							<StackPanel x:Name="ScrollingContent"
										Margin="20,0,20,24">

								<TextBlock x:Name="ScrollingTitle"
										   Text="{TemplateBinding Title}"
										   MaxLines="1"
										   TextWrapping="NoWrap"
										   Style="{StaticResource DisplayMedium}"
										   Margin="0,12,0,8"
										   Visibility="Collapsed" />

								<ContentPresenter Content="{TemplateBinding Content}"
												  ContentTemplate="{TemplateBinding HeaderTemplate}" />

								<StackPanel x:Name="PART_ScrollingTabs"
											Visibility="Collapsed">
									<RadioButton x:Name="PART_MaterialRadioButton" />
									<RadioButton x:Name="PART_CupertinoRadioButton" />
								</StackPanel>

								<ComboBox x:Name="MaterialVersionComboBox"
										  Visibility="Collapsed">
									<x:String>M2</x:String>
									<x:String>M3</x:String>
								</ComboBox>

								<ContentPresenter x:Name="CupertinoContentPresenter"
												  Content="{TemplateBinding Content}"
												  ContentTemplate="{TemplateBinding CupertinoTemplate}" />

								<TextBlock Foreground="{ThemeResource OnSurfaceVariantBrush}"
										   Style="{StaticResource BodySmall}"
										   Visibility="{Binding DocumentationLink, Converter={StaticResource IsNullOrEmptyToCollapsed}}"
										   Margin="16,24,16,0">
									<Run Text="For more information, see the " /><Hyperlink NavigateUri="{Binding DocumentationLink}"
											   Foreground="{ThemeResource PrimaryBrush}"
											   UnderlineStyle="None">
										official documentation
									</Hyperlink><Run Text="." />
								</TextBlock>
							</StackPanel>
						</ScrollViewer>

						<StackPanel x:Name="PART_StickyTabs"
									Grid.Row="1"
									Visibility="Collapsed">
							<RadioButton x:Name="PART_StickyMaterialRadioButton"
										 Visibility="Collapsed" />
							<RadioButton x:Name="PART_StickyCupertinoRadioButton"
										 Visibility="Collapsed" />
						</StackPanel>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="FormFactors">
								<VisualState x:Name="Desktop">
									<VisualState.StateTriggers>
										<AdaptiveTrigger MinWindowWidth="{StaticResource DesktopAdaptiveThresholdWidth}" />
									</VisualState.StateTriggers>
								</VisualState>
								<VisualState x:Name="Mobile">
									<VisualState.StateTriggers>
										<AdaptiveTrigger MinWindowWidth="0" />
									</VisualState.StateTriggers>
									<VisualState.Setters>
										<Setter Target="ScrollingContent.Margin" Value="16,0,16,24" />
										<Setter Target="ScrollingTitle.Visibility" Value="Visible" />
										<Setter Target="StickyTitle.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- An Overview entry is an inset group: a header, the sample, a "View component" row, and the description as footer. -->
	<Style TargetType="local:OverviewSampleView">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:OverviewSampleView">
					<StackPanel Margin="0,12,0,12"
								Spacing="8">
						<TextBlock Text="{Binding Sample.Title, RelativeSource={RelativeSource TemplatedParent}}"
								   Style="{StaticResource TitleMedium}"
								   Margin="16,0" />
						<Border Background="{ThemeResource SurfaceBrush}"
								CornerRadius="{ThemeResource CupertinoGroupCornerRadius}">
							<StackPanel>
								<ContentControl Content="{TemplateBinding Content}"
												ContentTemplate="{TemplateBinding ContentTemplate}"
												Padding="16"
												HorizontalContentAlignment="Stretch" />
								<Rectangle Height="0.5"
										   Margin="16,0,0,0"
										   Fill="{ThemeResource CupertinoSeparatorBrush}"
										   UseLayoutRounding="False" />
								<!-- The whole row is the button; the plain button centers its content, so the chevron is laid over it. -->
								<Grid>
									<Button x:Name="PART_ViewButton"
											MinHeight="{ThemeResource CupertinoRowMinHeight}"
											Padding="16,0"
											CornerRadius="0"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Left"
											Content="View component"
											FontFamily="{ThemeResource BodyLargeFontFamily}"
											FontSize="{ThemeResource BodyLargeFontSize}"
											FontWeight="{ThemeResource BodyLargeFontWeight}"
											Style="{StaticResource TextButtonStyle}" />
									<FontIcon Glyph="&#xE76C;"
											  FontSize="14"
											  Margin="0,0,16,0"
											  HorizontalAlignment="Right"
											  VerticalAlignment="Center"
											  IsHitTestVisible="False"
											  FontFamily="{ThemeResource SymbolThemeFontFamily}"
											  Foreground="{ThemeResource CupertinoTertiaryLabelBrush}" />
								</Grid>
							</StackPanel>
						</Border>
						<TextBlock Text="{Binding Sample.Description, RelativeSource={RelativeSource TemplatedParent}}"
								   Visibility="{Binding Sample.Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IsNullOrEmptyToCollapsed}, FallbackValue=Collapsed}"
								   Foreground="{ThemeResource OnSurfaceVariantBrush}"
								   Style="{StaticResource BodySmall}"
								   Margin="16,0" />
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
