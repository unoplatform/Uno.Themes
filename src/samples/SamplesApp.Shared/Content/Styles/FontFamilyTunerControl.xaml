<UserControl x:Class="Uno.Themes.Samples.Content.Styles.FontFamilyTunerControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="using:Uno.Themes.Samples.Content.Styles">

	<StackPanel Spacing="8">

		<TextBlock Text="Set the theme's font family. One value regenerates both root typeface tokens and every type-scale family key derived from them, so the samples below re-render in place."
				   Style="{StaticResource BodySmall}"
				   TextWrapping="Wrap"
				   Opacity="0.6" />

		<ComboBox x:Name="FamilyCombo"
				  Header="DefaultFontFamily"
				  HorizontalAlignment="Stretch"
				  SelectionChanged="OnFamilySelectionChanged" />

		<TextBlock x:Name="StatusText"
				   Style="{StaticResource CaptionMedium}"
				   TextWrapping="Wrap"
				   Opacity="0.7" />

	</StackPanel>
</UserControl>
