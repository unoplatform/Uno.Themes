<Page x:Class="Uno.Themes.Samples.Content.Controls.RadioButtonSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Uno.Themes.Samples.Shared.Content"
	  xmlns:sample="using:Uno.Themes.Samples"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:android="http://uno.ui/android"
	  xmlns:ios="http://uno.ui/ios"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:smtx="using:ShowMeTheXAML"
	  mc:Ignorable="d android ios">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<sample:SamplePageLayout>
			<sample:SamplePageLayout.MaterialTemplate>
				<DataTemplate>
					<StackPanel>

						<!-- Primary -->
						<TextBlock Text="Primary"
								   Style="{StaticResource MaterialSubtitle2}"
								   Margin="12,16,12,4" />

						<!-- RadioButton OFF -->
						<smtx:XamlDisplay UniqueKey="Material_RadioButtonSamplePage_Unchecked">
							<RadioButton GroupName="Material_Primary_a"
										 Content="UNCHECKED"
										 Style="{StaticResource MaterialRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- RadioButton ON -->
						<smtx:XamlDisplay UniqueKey="Material_RadioButtonSamplePage_Checked">
							<RadioButton GroupName="Material_Primary_a"
										 Content="CHECKED"
										 Style="{StaticResource MaterialRadioButtonStyle}"
										 IsChecked="True" />
						</smtx:XamlDisplay>

						<!-- RadioButton OFF Disabled -->
						<smtx:XamlDisplay UniqueKey="Material_RadioButtonSamplePage_UncheckedDisabled">
							<RadioButton GroupName="Material_Primary_b"
										 Content="UNCHECKED DISABLED"
										 IsEnabled="False"
										 Style="{StaticResource MaterialRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- RadioButton ON Disabled -->
						<smtx:XamlDisplay UniqueKey="Material_RadioButtonSamplePage_CheckedDisabled">
							<RadioButton GroupName="Material_Primary_b"
										 Content="CHECKED DISABLED"
										 IsChecked="True"
										 IsEnabled="False"
										 Style="{StaticResource MaterialRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- Secondary -->
						<TextBlock Text="Secondary"
								   Style="{StaticResource MaterialSubtitle2}"
								   Margin="12,16,12,4" />

						<!-- RadioButton OFF -->
						<smtx:XamlDisplay UniqueKey="Material_RadioButtonSamplePage_SecondaryUnchecked">
							<RadioButton GroupName="Material_Secondary_a"
										 Content="UNCHECKED"
										 Style="{StaticResource MaterialSecondaryRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- RadioButton ON -->
						<smtx:XamlDisplay UniqueKey="Material_RadioButtonSamplePage_SecondaryChecked">
							<RadioButton GroupName="Material_Secondary_a"
										 Content="CHECKED"
										 Style="{StaticResource MaterialSecondaryRadioButtonStyle}"
										 IsChecked="True" />
						</smtx:XamlDisplay>

						<!-- RadioButton OFF Disabled -->
						<smtx:XamlDisplay UniqueKey="Material_RadioButtonSamplePage_SecondaryUncheckedDisabled">
							<RadioButton GroupName="Material_Secondary_b"
										 Content="UNCHECKED DISABLED"
										 IsEnabled="False"
										 Style="{StaticResource MaterialSecondaryRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- RadioButton ON Disabled -->
						<smtx:XamlDisplay UniqueKey="Material_RadioButtonSamplePage_SecondaryCheckedDisabled">
							<RadioButton GroupName="Material_Secondary_b"
										 Content="CHECKED DISABLED"
										 IsChecked="True"
										 IsEnabled="False"
										 Style="{StaticResource MaterialSecondaryRadioButtonStyle}" />
						</smtx:XamlDisplay>
					</StackPanel>
				</DataTemplate>
			</sample:SamplePageLayout.MaterialTemplate>
			<sample:SamplePageLayout.M3MaterialTemplate>
				<DataTemplate>
					<StackPanel>

						<!-- Primary -->
						<TextBlock Text="Primary"
								   Style="{StaticResource TitleSmall}"
								   Margin="12,16,12,4" />

						<!-- RadioButton OFF -->
						<smtx:XamlDisplay UniqueKey="M3Material_RadioButtonSamplePage_Unchecked">
							<RadioButton GroupName="Material_Primary_a"
										 Content="Unchecked"
										 Style="{StaticResource MaterialRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- RadioButton ON -->
						<smtx:XamlDisplay UniqueKey="M3Material_RadioButtonSamplePage_Checked">
							<RadioButton GroupName="Material_Primary_a"
										 Content="Checked"
										 Style="{StaticResource MaterialRadioButtonStyle}"
										 IsChecked="True" />
						</smtx:XamlDisplay>

						<!-- RadioButton OFF Disabled -->
						<smtx:XamlDisplay UniqueKey="M3Material_RadioButtonSamplePage_UncheckedDisabled">
							<RadioButton GroupName="Material_Primary_b"
										 Content="Unchecked Disabled"
										 IsEnabled="False"
										 Style="{StaticResource MaterialRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- RadioButton ON Disabled -->
						<smtx:XamlDisplay UniqueKey="M3Material_RadioButtonSamplePage_CheckedDisabled">
							<RadioButton GroupName="Material_Primary_b"
										 Content="Checked Disabled"
										 IsChecked="True"
										 IsEnabled="False"
										 Style="{StaticResource MaterialRadioButtonStyle}" />
						</smtx:XamlDisplay>
					</StackPanel>
				</DataTemplate>
			</sample:SamplePageLayout.M3MaterialTemplate>
			<sample:SamplePageLayout.CupertinoTemplate>
				<DataTemplate>
					<StackPanel>

						<!-- RadioButton OFF -->
						<smtx:XamlDisplay UniqueKey="Cupertino_RadioButtonSamplePage_Unchecked">
							<RadioButton GroupName="Cupertino_Primary_a"
										 Content="UNCHECKED"
										 Style="{StaticResource CupertinoRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- RadioButton ON -->
						<smtx:XamlDisplay UniqueKey="Cupertino_RadioButtonSamplePage_Checked">
							<RadioButton GroupName="Cupertino_Primary_a"
										 Content="CHECKED"
										 Style="{StaticResource CupertinoRadioButtonStyle}"
										 IsChecked="True" />
						</smtx:XamlDisplay>

						<!-- RadioButton OFF Disabled -->
						<smtx:XamlDisplay UniqueKey="Cupertino_RadioButtonSamplePage_UncheckedDisabled">
							<RadioButton GroupName="Cupertino_Primary_b"
										 Content="UNCHECKED DISABLED"
										 IsEnabled="False"
										 Style="{StaticResource CupertinoRadioButtonStyle}" />
						</smtx:XamlDisplay>

						<!-- RadioButton ON Disabled -->
						<smtx:XamlDisplay UniqueKey="Cupertino_RadioButtonSamplePage_CheckedDisabled">
							<RadioButton GroupName="Cupertino_Primary_b"
										 Content="CHECKED DISABLED"
										 IsChecked="True"
										 IsEnabled="False"
										 Style="{StaticResource CupertinoRadioButtonStyle}" />
						</smtx:XamlDisplay>

					</StackPanel>
				</DataTemplate>
			</sample:SamplePageLayout.CupertinoTemplate>
			<sample:SamplePageLayout.SimpleTemplate>
				<DataTemplate>
					<StackPanel>
						<!-- Basic RadioButtons -->
						<smtx:XamlDisplay UniqueKey="Simple_RadioButton_Basic"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<StackPanel Spacing="12">
								<RadioButton Content="Option 1" GroupName="SimpleGroup1" IsChecked="True" />
								<RadioButton Content="Option 2" GroupName="SimpleGroup1" />
								<RadioButton Content="Option 3" GroupName="SimpleGroup1" />
							</StackPanel>
						</smtx:XamlDisplay>

						<!-- Disabled -->
						<smtx:XamlDisplay UniqueKey="Simple_RadioButton_Disabled"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<StackPanel Spacing="12">
								<RadioButton Content="Disabled Selected" GroupName="SimpleGroup2" IsChecked="True" IsEnabled="False" />
								<RadioButton Content="Disabled Unselected" GroupName="SimpleGroup2" IsEnabled="False" />
							</StackPanel>
						</smtx:XamlDisplay>

						<!-- Horizontal Layout -->
						<smtx:XamlDisplay UniqueKey="Simple_RadioButton_Horizontal"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<StackPanel Orientation="Horizontal" Spacing="16">
								<RadioButton Content="A" GroupName="SimpleGroup3" IsChecked="True" />
								<RadioButton Content="B" GroupName="SimpleGroup3" />
								<RadioButton Content="C" GroupName="SimpleGroup3" />
							</StackPanel>
						</smtx:XamlDisplay>
					</StackPanel>
				</DataTemplate>
			</sample:SamplePageLayout.SimpleTemplate>
			<sample:SamplePageLayout.OmarchyTemplate>
				<DataTemplate>
					<StackPanel>
						<!-- Neutral radio (the implicit style) -->
						<smtx:XamlDisplay UniqueKey="Omarchy_RadioButton_Basic"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<StackPanel Spacing="12">
								<RadioButton Content="Option 1"
											 GroupName="OmarchyGroup1"
											 IsChecked="True"
											 Style="{StaticResource OmarchyRadioButtonStyle}" />
								<RadioButton Content="Option 2"
											 GroupName="OmarchyGroup1"
											 Style="{StaticResource OmarchyRadioButtonStyle}" />
								<RadioButton Content="Option 3"
											 GroupName="OmarchyGroup1"
											 Style="{StaticResource OmarchyRadioButtonStyle}" />
							</StackPanel>
						</smtx:XamlDisplay>

						<!-- Disabled -->
						<smtx:XamlDisplay UniqueKey="Omarchy_RadioButton_Disabled"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<StackPanel Spacing="12">
								<RadioButton Content="Disabled Selected"
											 GroupName="OmarchyGroup2"
											 IsChecked="True"
											 IsEnabled="False"
											 Style="{StaticResource OmarchyRadioButtonStyle}" />
								<RadioButton Content="Disabled Unselected"
											 GroupName="OmarchyGroup2"
											 IsEnabled="False"
											 Style="{StaticResource OmarchyRadioButtonStyle}" />
							</StackPanel>
						</smtx:XamlDisplay>

						<!-- ANSI accent variants (one group each so every color shows its selected state) -->
						<smtx:XamlDisplay UniqueKey="Omarchy_RadioButton_Ansi"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<StackPanel Spacing="12">
								<StackPanel Orientation="Horizontal"
											Spacing="16">
									<RadioButton Content="Black"
												 GroupName="OmarchyAnsiBlack"
												 IsChecked="True"
												 Style="{StaticResource OmarchyRadioButtonBlackStyle}" />
									<RadioButton Content="White"
												 GroupName="OmarchyAnsiWhite"
												 IsChecked="True"
												 Style="{StaticResource OmarchyRadioButtonWhiteStyle}" />
									<RadioButton Content="Red"
												 GroupName="OmarchyAnsiRed"
												 IsChecked="True"
												 Style="{StaticResource OmarchyRadioButtonRedStyle}" />
									<RadioButton Content="Green"
												 GroupName="OmarchyAnsiGreen"
												 IsChecked="True"
												 Style="{StaticResource OmarchyRadioButtonGreenStyle}" />
								</StackPanel>
								<StackPanel Orientation="Horizontal"
											Spacing="16">
									<RadioButton Content="Yellow"
												 GroupName="OmarchyAnsiYellow"
												 IsChecked="True"
												 Style="{StaticResource OmarchyRadioButtonYellowStyle}" />
									<RadioButton Content="Blue"
												 GroupName="OmarchyAnsiBlue"
												 IsChecked="True"
												 Style="{StaticResource OmarchyRadioButtonBlueStyle}" />
									<RadioButton Content="Magenta"
												 GroupName="OmarchyAnsiMagenta"
												 IsChecked="True"
												 Style="{StaticResource OmarchyRadioButtonMagentaStyle}" />
									<RadioButton Content="Cyan"
												 GroupName="OmarchyAnsiCyan"
												 IsChecked="True"
												 Style="{StaticResource OmarchyRadioButtonCyanStyle}" />
								</StackPanel>
							</StackPanel>
						</smtx:XamlDisplay>
					</StackPanel>
				</DataTemplate>
			</sample:SamplePageLayout.OmarchyTemplate>
		</sample:SamplePageLayout>
	</Grid>
</Page>
