<Page x:Class="Uno.Themes.Samples.Content.Controls.NavigationViewSamplePage_MUX"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:sample="using:Uno.Themes.Samples"
	  xmlns:smtx="using:ShowMeTheXAML"
	  xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
	  mc:Ignorable="d">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<sample:SamplePageLayout>
			<sample:SamplePageLayout.MaterialTemplate>
				<DataTemplate>
					<smtx:XamlDisplay UniqueKey="Material_NavigationViewSamplePage_MUX_NavigationView"
									  Style="{StaticResource XamlDisplayBelowStyle}">
						<sample:ClippedGrid MinHeight="400">
							<muxc:NavigationView OpenPaneLength="260"
												 IsBackButtonVisible="Collapsed"
												 IsBackEnabled="False"
												 Style="{StaticResource MaterialNavigationViewStyle}">
								<muxc:NavigationView.MenuItems>
									<muxc:NavigationViewItem Icon="Library"
															 Content="Parent for 1~3"
															 SelectsOnInvoked="False"
															 Style="{StaticResource MaterialNavigationViewItemStyle}">
										<muxc:NavigationViewItem.MenuItems>
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 1"
																	 Style="{StaticResource MaterialNavigationViewItemStyle}" />
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 2"
																	 Style="{StaticResource MaterialNavigationViewItemStyle}" />
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 3"
																	 Style="{StaticResource MaterialNavigationViewItemStyle}" />
										</muxc:NavigationViewItem.MenuItems>
									</muxc:NavigationViewItem>
									<muxc:NavigationViewItem Icon="Placeholder"
															 Content="Item 4"
															 Style="{StaticResource MaterialNavigationViewItemStyle}" />
								</muxc:NavigationView.MenuItems>
							</muxc:NavigationView>
						</sample:ClippedGrid>
					</smtx:XamlDisplay>
				</DataTemplate>
			</sample:SamplePageLayout.MaterialTemplate>
			<sample:SamplePageLayout.M3MaterialTemplate>
				<DataTemplate>
					<smtx:XamlDisplay UniqueKey="M3_Material_NavigationViewSamplePage_MUX_NavigationView"
									  Style="{StaticResource XamlDisplayBelowStyle}">
						<sample:ClippedGrid MinHeight="400">
							<muxc:NavigationView OpenPaneLength="260"
												 IsBackButtonVisible="Collapsed"
												 IsBackEnabled="False"
												 Style="{StaticResource MaterialNavigationViewStyle}">
								<muxc:NavigationView.MenuItems>
									<!-- First Header -->
									<muxc:NavigationViewItemHeader Content="Main Section" />

									<!-- First Group of Items -->
									<muxc:NavigationViewItem Icon="Library"
															 Content="Parent for 1~3"
															 SelectsOnInvoked="False"
															 Style="{StaticResource MaterialNavigationViewItemStyle}">
										<muxc:NavigationViewItem.MenuItems>
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 1"
																	 Style="{StaticResource MaterialNavigationViewItemStyle}" />
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 2"
																	 Style="{StaticResource MaterialNavigationViewItemStyle}" />
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 3"
																	 Style="{StaticResource MaterialNavigationViewItemStyle}" />
										</muxc:NavigationViewItem.MenuItems>
									</muxc:NavigationViewItem>
									<muxc:NavigationViewItem Icon="Placeholder"
															 Content="Item 4"
															 Style="{StaticResource MaterialNavigationViewItemStyle}" />

									<!-- Separator -->
									<muxc:NavigationViewItemSeparator />

									<!-- Second Header -->
									<muxc:NavigationViewItemHeader Content="Secondary Section" />

									<!-- Second Group of Items -->
									<muxc:NavigationViewItem Icon="Placeholder"
															 Content="Item 5"
															 Style="{StaticResource MaterialNavigationViewItemStyle}" />
									<muxc:NavigationViewItem Icon="Placeholder"
															 Content="Item 6 (disabled)"
															 IsEnabled="False"
															 Style="{StaticResource MaterialNavigationViewItemStyle}" />
								</muxc:NavigationView.MenuItems>
							</muxc:NavigationView>

						</sample:ClippedGrid>
					</smtx:XamlDisplay>
				</DataTemplate>
			</sample:SamplePageLayout.M3MaterialTemplate>
			<sample:SamplePageLayout.CupertinoTemplate>
				<DataTemplate>
					<smtx:XamlDisplay UniqueKey="Cupertino_NavigationViewSamplePage_MUX_NavigationView"
									  Style="{StaticResource XamlDisplayBelowStyle}">
						<sample:ClippedGrid MinHeight="400">
							<muxc:NavigationView OpenPaneLength="260"
												 PaneDisplayMode="Left"
												 IsSettingsVisible="False"
												 IsBackButtonVisible="Collapsed"
												 IsBackEnabled="False"
												 Style="{StaticResource CupertinoNavigationViewStyle}">
								<muxc:NavigationView.MenuItems>
									<!-- First Header -->
									<muxc:NavigationViewItemHeader Content="Library" />

									<!-- First Group of Items -->
									<muxc:NavigationViewItem Icon="Library"
															 Content="Media"
															 SelectsOnInvoked="False"
															 Style="{StaticResource CupertinoNavigationViewItemStyle}">
										<muxc:NavigationViewItem.MenuItems>
											<muxc:NavigationViewItem Icon="Audio"
																	 Content="Music"
																	 Style="{StaticResource CupertinoNavigationViewItemStyle}" />
											<muxc:NavigationViewItem Icon="Video"
																	 Content="Videos"
																	 Style="{StaticResource CupertinoNavigationViewItemStyle}" />
											<muxc:NavigationViewItem Icon="Pictures"
																	 Content="Photos"
																	 Style="{StaticResource CupertinoNavigationViewItemStyle}" />
										</muxc:NavigationViewItem.MenuItems>
									</muxc:NavigationViewItem>
									<muxc:NavigationViewItem Icon="Download"
															 Content="Downloads"
															 Style="{StaticResource CupertinoNavigationViewItemStyle}" />

									<!-- Separator -->
									<muxc:NavigationViewItemSeparator />

									<!-- Second Header -->
									<muxc:NavigationViewItemHeader Content="Accounts" />

									<!-- Second Group of Items -->
									<muxc:NavigationViewItem Icon="Mail"
															 Content="Mail"
															 Style="{StaticResource CupertinoNavigationViewItemStyle}" />
									<muxc:NavigationViewItem Icon="Calendar"
															 Content="Calendar (disabled)"
															 IsEnabled="False"
															 Style="{StaticResource CupertinoNavigationViewItemStyle}" />
								</muxc:NavigationView.MenuItems>
							</muxc:NavigationView>

						</sample:ClippedGrid>
					</smtx:XamlDisplay>
				</DataTemplate>
			</sample:SamplePageLayout.CupertinoTemplate>
			<sample:SamplePageLayout.SimpleTemplate>
				<DataTemplate>
					<smtx:XamlDisplay UniqueKey="Simple_NavigationView_MUX"
									  Style="{StaticResource XamlDisplayBelowStyle}">
						<sample:ClippedGrid MinHeight="400">
							<muxc:NavigationView OpenPaneLength="260"
												 IsBackButtonVisible="Collapsed"
												 IsBackEnabled="False">
								<muxc:NavigationView.MenuItems>
									<muxc:NavigationViewItemHeader Content="Main Section" />
									<muxc:NavigationViewItem Icon="Library"
															 Content="Parent for 1~3"
															 SelectsOnInvoked="False">
										<muxc:NavigationViewItem.MenuItems>
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 1" />
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 2" />
											<muxc:NavigationViewItem Icon="Placeholder"
																	 Content="Item 3" />
										</muxc:NavigationViewItem.MenuItems>
									</muxc:NavigationViewItem>
									<muxc:NavigationViewItem Icon="Placeholder"
															 Content="Item 4" />
									<muxc:NavigationViewItemSeparator />
									<muxc:NavigationViewItemHeader Content="Secondary Section" />
									<muxc:NavigationViewItem Icon="Placeholder"
															 Content="Item 5" />
									<muxc:NavigationViewItem Icon="Placeholder"
															 Content="Item 6 (disabled)"
															 IsEnabled="False" />
								</muxc:NavigationView.MenuItems>
							</muxc:NavigationView>
						</sample:ClippedGrid>
					</smtx:XamlDisplay>
				</DataTemplate>
			</sample:SamplePageLayout.SimpleTemplate>
		</sample:SamplePageLayout>
	</Grid>
</Page>
