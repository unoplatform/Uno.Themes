<Page x:Class="Uno.Themes.Samples.Content.Controls.TimePickerSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Uno.Themes.Samples.Shared.Content"
	  xmlns:sample="using:Uno.Themes.Samples"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:smtx="using:ShowMeTheXAML"
	  mc:Ignorable="d">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<sample:SamplePageLayout>
			<sample:SamplePageLayout.MaterialTemplate>
				<DataTemplate>
					<StackPanel>

						<!-- Default -->
						<TextBlock Text="Default"
								   Style="{StaticResource MaterialSubtitle2}"
								   Margin="12,16,12,4" />

						<!-- TimePicker -->
						<smtx:XamlDisplay UniqueKey="TimePickerSamplePage_Default"
										  Style="{StaticResource XamlDisplayBelowStyle}">

							<TimePicker Header="Select a Time"
										Style="{StaticResource MaterialTimePickerStyle}" />
						</smtx:XamlDisplay>

						<!-- Disabled -->
						<TextBlock Text="Disabled"
								   Style="{StaticResource MaterialSubtitle2}"
								   Margin="12,8,12,4" />

						<!-- TimePicker -->
						<smtx:XamlDisplay UniqueKey="TimePickerSamplePage_Disabled"
										  Style="{StaticResource XamlDisplayBelowStyle}">

							<TimePicker Header="Select a Time"
										Style="{StaticResource MaterialTimePickerStyle}"
										IsEnabled="False" />
						</smtx:XamlDisplay>
					</StackPanel>
				</DataTemplate>
			</sample:SamplePageLayout.MaterialTemplate>
			<sample:SamplePageLayout.CupertinoTemplate>
				<DataTemplate>
					<StackPanel>
						<!-- The compact time: a gray capsule that opens the time wheel -->
						<smtx:XamlDisplay UniqueKey="Cupertino_TimePickerSamplePage_Default"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<TimePicker Header="Alarm"
										ClockIdentifier="12HourClock"
										SelectedTime="07:30:00" />
						</smtx:XamlDisplay>

						<smtx:XamlDisplay UniqueKey="Cupertino_TimePickerSamplePage_24Hour"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<TimePicker Header="24-hour clock"
										ClockIdentifier="24HourClock"
										SelectedTime="18:45:00" />
						</smtx:XamlDisplay>

						<smtx:XamlDisplay UniqueKey="Cupertino_TimePickerSamplePage_Disabled"
										  Style="{StaticResource XamlDisplayBelowStyle}">
							<TimePicker Header="Disabled"
										SelectedTime="09:41:00"
										IsEnabled="False" />
						</smtx:XamlDisplay>
					</StackPanel>
				</DataTemplate>
			</sample:SamplePageLayout.CupertinoTemplate>
		</sample:SamplePageLayout>
	</Grid>
</Page>
