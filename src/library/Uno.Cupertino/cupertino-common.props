<Project>
	<PropertyGroup>
		<AllowedOutputExtensionsInPackageBuildOutputFolder>.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<GenerateLibraryLayout>true</GenerateLibraryLayout>
		<UnoXamlResourcesTrimming Condition="'$(Configuration)'=='Release' and !('$(MSBuildRuntimeType)'!='Core' and $([MSBuild]::IsOSPlatform('osx')))">true</UnoXamlResourcesTrimming>
	</PropertyGroup>

	<ItemGroup>
		<UnoSourceGeneratorAdditionalProperty Include="UseWinUI" />
	</ItemGroup>

	<Choose>
		<When Condition="$(_IsIOS) or $(_IsAndroid)">
			<ItemGroup>
				<IncludeXamlNamespaces Include="mobile" />
				<ExcludeXamlNamespaces Include="not_mobile" />
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<IncludeXamlNamespaces Include="not_mobile" />
				<ExcludeXamlNamespaces Include="mobile" />
			</ItemGroup>
		</Otherwise>
	</Choose>


	<ItemGroup>
		<LottieJson Include="Assets\CupertinoProgressRing.json" />
	</ItemGroup>

	<ItemGroup Condition="$(_IsWindows)">
		<Content Include="@(LottieJson)" />
	</ItemGroup>

	<ItemGroup Condition="!$(_IsWindows)">
		<EmbeddedResource Include="@(LottieJson)" />
		<IncludeXamlNamespaces Include="lottie_not_win" />
		<ExcludeXamlNamespaces Include="lottie_win" />
	</ItemGroup>

	<ItemGroup>
		<UpToDateCheckInput Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Uno.Fonts.Inter" />
	</ItemGroup>

	<ItemGroup>
		<XamlMergeOutputFiles Include="Generated\mergedpages.xaml" />
		<XamlMergeOutputFiles Include="Generated\mergedpages.v1.xaml" />

		<XamlMergeInput Include="Styles\Controls\**\*.xaml" Exclude="Styles\Controls\v1\**" MergeFile="mergedpages.xaml" />
		<XamlMergeInput Include="Styles\Application\**\*.xaml" Exclude="Styles\Application\v1\**" MergeFile="mergedpages.xaml" />
		<None Remove="Styles\Controls\_Resources.xaml" />
		<XamlMergeInput Remove="Styles\Application\CupertinoBrushes.xaml" />
		<XamlMergeInput Remove="Styles\Application\ColorPalette.xaml" />
		<XamlMergeInput Remove="Styles\Application\Fonts.xaml" />
		<XamlMergeInput Remove="Styles\Application\Typography.xaml" />

		<!-- CupertinoResourcesV1: the frozen pre-CupertinoTheme generation -->
		<XamlMergeInput Include="Styles\Controls\v1\**\*.xaml" MergeFile="mergedpages.v1.xaml" />
		<XamlMergeInput Include="Styles\Application\v1\**\*.xaml" MergeFile="mergedpages.v1.xaml" />
		<None Remove="Styles\Controls\v1\_Resources.xaml" />
		<XamlMergeInput Remove="Styles\Application\v1\CupertinoColorsV1.xaml" />
		<XamlMergeInput Remove="Styles\Application\v1\ColorPalette.xaml" />
		<XamlMergeInput Remove="Styles\Application\v1\Fonts.xaml" />
	</ItemGroup>

	<ItemGroup>
		<UpToDateCheckInput Remove="Styles\Application\CupertinoBrushes.xaml" />
		<UpToDateCheckInput Remove="Styles\Controls\_Resources.xaml" />
		<UpToDateCheckInput Remove="Styles\Application\v1\CupertinoColorsV1.xaml" />
		<UpToDateCheckInput Remove="Styles\Controls\v1\_Resources.xaml" />
	</ItemGroup>

	<ItemGroup Condition="'$(ImplicitUsings)'=='true' OR '$(ImplicitUsings)'=='enable'">
		<Using Include="Uno.Cupertino" />
	</ItemGroup>

	<Import Project="..\xamlmerge.targets" />
</Project>
