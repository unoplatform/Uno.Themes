<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		This palette contains the default colors and opacity levels for the different state overlays
		All of them can be overriden by the application consuming this library
		
		All variations of this palette are offered as brushes in Colors.xaml.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- Light Theme -->
		<ResourceDictionary x:Key="Light">
			<!--
				Shared semantic roles (SharedColorPalette.xaml overrides). Every role is opaque: SharedColors.xaml
				multiplies each one by the state opacities, so Apple's alpha-based fills are pre-composited here.
			-->
			<!-- Primary -->
			<Color x:Key="PrimaryColor">#0088FF</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#D9EDFF</Color>
			<Color x:Key="OnPrimaryContainerColor">#000000</Color>
			<Color x:Key="PrimaryInverseColor">#0091FF</Color>
			<Color x:Key="PrimaryVariantDarkColor">#0074D9</Color>
			<Color x:Key="PrimaryVariantLightColor">#4BB7FF</Color>
			<!-- Secondary -->
			<Color x:Key="SecondaryColor">#8E8E93</Color>
			<Color x:Key="OnSecondaryColor">#FFFFFF</Color>
			<Color x:Key="SecondaryContainerColor">#EFEFF0</Color>
			<Color x:Key="OnSecondaryContainerColor">#000000</Color>
			<Color x:Key="SecondaryVariantDarkColor">#636366</Color>
			<Color x:Key="SecondaryVariantLightColor">#AEAEB2</Color>
			<!-- Tertiary -->
			<Color x:Key="TertiaryColor">#6155F5</Color>
			<Color x:Key="OnTertiaryColor">#FFFFFF</Color>
			<Color x:Key="TertiaryContainerColor">#E7E6FE</Color>
			<Color x:Key="OnTertiaryContainerColor">#000000</Color>
			<!-- Error -->
			<Color x:Key="ErrorColor">#FF383C</Color>
			<Color x:Key="OnErrorColor">#FFFFFF</Color>
			<Color x:Key="ErrorContainerColor">#FFE1E2</Color>
			<Color x:Key="OnErrorContainerColor">#FF383C</Color>
			<!-- Background / surface -->
			<Color x:Key="BackgroundColor">#F2F2F7</Color>
			<Color x:Key="OnBackgroundColor">#000000</Color>
			<Color x:Key="SurfaceColor">#FFFFFF</Color>
			<Color x:Key="OnSurfaceColor">#000000</Color>
			<Color x:Key="SurfaceVariantColor">#F2F2F7</Color>
			<Color x:Key="OnSurfaceVariantColor">#8A8A8E</Color>
			<Color x:Key="SurfaceInverseColor">#1C1C1E</Color>
			<Color x:Key="OnSurfaceInverseColor">#FFFFFF</Color>
			<Color x:Key="SurfaceTintColor">#0088FF</Color>
			<!-- Outline -->
			<Color x:Key="OutlineColor">#C6C6C8</Color>
			<Color x:Key="OutlineVariantColor">#E5E5EA</Color>

			<!-- Basic colors -->
			<Color x:Key="CupertinoBlueColor">#0088FF</Color>
			<Color x:Key="CupertinoGreenColor">#34C759</Color>
			<Color x:Key="CupertinoIndigoColor">#6155F5</Color>
			<Color x:Key="CupertinoOrangeColor">#FF8D28</Color>
			<Color x:Key="CupertinoPinkColor">#FF2D55</Color>
			<Color x:Key="CupertinoPurpleColor">#CB30E0</Color>
			<Color x:Key="CupertinoRedColor">#FF383C</Color>
			<Color x:Key="CupertinoTealColor">#00C3D0</Color>
			<Color x:Key="CupertinoYellowColor">#FFCC00</Color>
			<Color x:Key="CupertinoMintColor">#00C8B3</Color>
			<Color x:Key="CupertinoCyanColor">#00C0E8</Color>
			<Color x:Key="CupertinoBrownColor">#AC7F5E</Color>
			<Color x:Key="CupertinoWhiteColor">#FFFFFF</Color>
			<Color x:Key="CupertinoBlackColor">#000000</Color>

			<!-- Types of gray colors -->
			<Color x:Key="CupertinoPrimaryGrayColor">#8E8E93</Color>
			<Color x:Key="CupertinoSecondaryGrayColor">#AEAEB2</Color>
			<Color x:Key="CupertinoTertiaryGrayColor">#C7C7CC</Color>
			<Color x:Key="CupertinoQuaternaryGrayColor">#D1D1D6</Color>
			<Color x:Key="CupertinoQuinaryGrayColor">#E5E5EA</Color>
			<Color x:Key="CupertinoSenaryGrayColor">#F2F2F7</Color>

			<!-- Controls colors -->
			<Color x:Key="LabelColor">#000000</Color>
			<Color x:Key="SecondaryLabelColor">#993c3c43</Color>
			<Color x:Key="TertiaryLabelColor">#4c3c3c43</Color>
			<Color x:Key="QuaternaryLabelColor">#2d3c3c43</Color>
			<Color x:Key="SystemFillColor">#33787880</Color>
			<Color x:Key="SecondarySystemFillColor">#28787880</Color>
			<Color x:Key="TertiarySystemFillColor">#1e767680</Color>
			<Color x:Key="QuaternarySystemFillColor">#14747480</Color>
			<Color x:Key="PlaceholderTextColor">#4c3c3c43</Color>
			<Color x:Key="SystemBackgroundColor">#FFFFFF</Color>
			<Color x:Key="SecondarySystemBackgroundColor">#f2f2f7</Color>
			<Color x:Key="TertiarySystemBackgroundColor">#FFFFFF</Color>
			<Color x:Key="SystemGroupedBackgroundColor">#f2f2f7</Color>
			<Color x:Key="SecondarySystemGroupedBackgroundColor">#FFFFFF</Color>
			<Color x:Key="TertiarySystemGroupedBackgroundColor">#f2f2f7</Color>
			<Color x:Key="SeparatorColor">#493c3c43</Color>
			<Color x:Key="OpaqueSeparatorColor">#c6c6c8</Color>
			<Color x:Key="LinkColor">#0088FF</Color>
			<Color x:Key="ShadowColor">#33000000</Color>
			<Color x:Key="RadioButtonBackgroundColor">#FFFFFF</Color>
		</ResourceDictionary>

		<!-- Dark Theme -->
		<ResourceDictionary x:Key="Default">
			<!--
				Shared semantic roles (SharedColorPalette.xaml overrides). Every role is opaque: SharedColors.xaml
				multiplies each one by the state opacities, so Apple's alpha-based fills are pre-composited here.
			-->
			<!-- Primary -->
			<Color x:Key="PrimaryColor">#0091FF</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#001D33</Color>
			<Color x:Key="OnPrimaryContainerColor">#FFFFFF</Color>
			<Color x:Key="PrimaryInverseColor">#0088FF</Color>
			<Color x:Key="PrimaryVariantDarkColor">#007BDB</Color>
			<Color x:Key="PrimaryVariantLightColor">#3A9BFF</Color>
			<!-- Secondary -->
			<Color x:Key="SecondaryColor">#8E8E93</Color>
			<Color x:Key="OnSecondaryColor">#FFFFFF</Color>
			<Color x:Key="SecondaryContainerColor">#1C1C1F</Color>
			<Color x:Key="OnSecondaryContainerColor">#FFFFFF</Color>
			<Color x:Key="SecondaryVariantDarkColor">#48484A</Color>
			<Color x:Key="SecondaryVariantLightColor">#8E8E93</Color>
			<!-- Tertiary -->
			<Color x:Key="TertiaryColor">#6D7CFF</Color>
			<Color x:Key="OnTertiaryColor">#FFFFFF</Color>
			<Color x:Key="TertiaryContainerColor">#161933</Color>
			<Color x:Key="OnTertiaryContainerColor">#FFFFFF</Color>
			<!-- Error -->
			<Color x:Key="ErrorColor">#FF4245</Color>
			<Color x:Key="OnErrorColor">#FFFFFF</Color>
			<Color x:Key="ErrorContainerColor">#330D0E</Color>
			<Color x:Key="OnErrorContainerColor">#FF4245</Color>
			<!-- Background / surface -->
			<Color x:Key="BackgroundColor">#000000</Color>
			<Color x:Key="OnBackgroundColor">#FFFFFF</Color>
			<Color x:Key="SurfaceColor">#1C1C1E</Color>
			<Color x:Key="OnSurfaceColor">#FFFFFF</Color>
			<Color x:Key="SurfaceVariantColor">#2C2C2E</Color>
			<Color x:Key="OnSurfaceVariantColor">#8D8D93</Color>
			<Color x:Key="SurfaceInverseColor">#F2F2F7</Color>
			<Color x:Key="OnSurfaceInverseColor">#000000</Color>
			<Color x:Key="SurfaceTintColor">#0091FF</Color>
			<!-- Outline -->
			<Color x:Key="OutlineColor">#38383A</Color>
			<Color x:Key="OutlineVariantColor">#2C2C2E</Color>

			<!-- Basic colors -->
			<Color x:Key="CupertinoBlueColor">#0091FF</Color>
			<Color x:Key="CupertinoGreenColor">#30D158</Color>
			<Color x:Key="CupertinoIndigoColor">#6D7CFF</Color>
			<Color x:Key="CupertinoOrangeColor">#FF9230</Color>
			<Color x:Key="CupertinoPinkColor">#FF375F</Color>
			<Color x:Key="CupertinoPurpleColor">#DB34F2</Color>
			<Color x:Key="CupertinoRedColor">#FF4245</Color>
			<Color x:Key="CupertinoTealColor">#00D2E0</Color>
			<Color x:Key="CupertinoYellowColor">#FFD600</Color>
			<Color x:Key="CupertinoMintColor">#00DAC3</Color>
			<Color x:Key="CupertinoCyanColor">#3CD3FE</Color>
			<Color x:Key="CupertinoBrownColor">#B78A66</Color>
			<Color x:Key="CupertinoWhiteColor">#FFFFFF</Color>
			<Color x:Key="CupertinoBlackColor">#000000</Color>

			<!-- Types of gray colors -->
			<Color x:Key="CupertinoPrimaryGrayColor">#8E8E93</Color>
			<Color x:Key="CupertinoSecondaryGrayColor">#636366</Color>
			<Color x:Key="CupertinoTertiaryGrayColor">#48484A</Color>
			<Color x:Key="CupertinoQuaternaryGrayColor">#3A3A3C</Color>
			<Color x:Key="CupertinoQuinaryGrayColor">#2C2C2E</Color>
			<Color x:Key="CupertinoSenaryGrayColor">#1C1C1E</Color>

			<!-- Controls colors -->
			<Color x:Key="LabelColor">#FFFFFF</Color>
			<Color x:Key="SecondaryLabelColor">#99ebebf5</Color>
			<Color x:Key="TertiaryLabelColor">#4cebebf5</Color>
			<Color x:Key="QuaternaryLabelColor">#2debebf5</Color>
			<Color x:Key="SystemFillColor">#5b787880</Color>
			<Color x:Key="SecondarySystemFillColor">#51787880</Color>
			<Color x:Key="TertiarySystemFillColor">#3d767680</Color>
			<Color x:Key="QuaternarySystemFillColor">#2d767680</Color>
			<Color x:Key="PlaceholderTextColor">#4cebebf5</Color>
			<Color x:Key="SystemBackgroundColor">#000000</Color>
			<Color x:Key="SecondarySystemBackgroundColor">#1c1c1e</Color>
			<Color x:Key="TertiarySystemBackgroundColor">#2c2c2e</Color>
			<Color x:Key="SystemGroupedBackgroundColor">#000000</Color>
			<Color x:Key="SecondarySystemGroupedBackgroundColor">#1c1c1e</Color>
			<Color x:Key="TertiarySystemGroupedBackgroundColor">#2c2c2e</Color>
			<Color x:Key="SeparatorColor">#99545458</Color>
			<Color x:Key="OpaqueSeparatorColor">#38383a</Color>
			<Color x:Key="LinkColor">#0091FF</Color>
			<Color x:Key="ShadowColor">#33000000</Color>
			<Color x:Key="RadioButtonBackgroundColor">#8E8E93</Color>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
