<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Static base layer for CupertinoTheme. Pulled into mergedpages.xaml by the
		Uno.XamlMerge task (via the Styles\Application\ glob) so that a single
		Source=mergedpages.xaml on BaseTheme brings in the default converter,
		typography and font resources the theme needs.
		
		Order matters: entries listed LATER win at lookup time (MergedDictionaries
		are searched in reverse), and a merged dictionary beats mergedpages' OWN theme
		dictionaries. Any Cupertino file that has to override a shared default must
		therefore be removed from the glob (see cupertino-common.props) and merged
		here, AFTER the dictionary it overrides. That is why Typography.xaml and
		Fonts.xaml are listed below.
		
		Colour resources are intentionally NOT included here: SharedColors, the shared/seed
		palettes and Cupertino's ColorPalette.xaml are added (and removed) dynamically by
		BaseTheme.UpdateSource so they rebuild on seed-color and override changes.
	-->

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="ms-appx:///Uno.Themes.WinUI/Styles/Applications/Common/Converters.xaml" />
		<ResourceDictionary Source="ms-appx:///Uno.Themes.WinUI/Styles/Applications/Common/SharedTypography.xaml" />

		<ResourceDictionary Source="ms-appx:///Uno.Cupertino.WinUI/Styles/Application/Typography.xaml" />
		<ResourceDictionary Source="ms-appx:///Uno.Cupertino.WinUI/Styles/Application/Fonts.xaml" />
	</ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
