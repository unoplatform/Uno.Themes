<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Cupertino — Semantic Typography Overrides
		
		Maps Apple's iOS text styles (Large / default Dynamic Type size) onto the shared semantic
		type scale defined in SharedTypography.xaml. Each slot below names the Apple style it carries.
		
		CharacterSpacing is 0 everywhere: Apple's tracking tables are unpublished and SF tracks
		dynamically, so the Material-derived shared defaults are overridden rather than inherited.
		
		Font family: the *FontFamily slot keys are declared once, in SharedTypography.xaml, as
		aliases of the DefaultFontFamily root; Fonts.xaml sets that root. This file overrides only
		size, weight and character spacing.
		
		This dictionary is merged by BaseDictionaries.xaml AFTER SharedTypography.xaml, and is
		excluded from the XamlMergeInput glob in cupertino-common.props to keep it that way. Both
		halves are load-bearing: resources merged into mergedpages itself lose to every dictionary
		BaseDictionaries merges, so a slot declared here would silently resolve to the shared
		Material value instead of Cupertino's.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<ResourceDictionary x:Key="Default">

			<!-- DISPLAY -->

			<!-- DisplayLarge — extrapolated above Large Title (40pt, Bold) -->
			<x:String x:Key="DisplayLargeFontWeight">Bold</x:String>
			<x:Double x:Key="DisplayLargeFontSize">40</x:Double>
			<x:Int32 x:Key="DisplayLargeCharacterSpacing">0</x:Int32>

			<!-- DisplayMedium — Large Title, emphasized (34pt, Bold) -->
			<x:String x:Key="DisplayMediumFontWeight">Bold</x:String>
			<x:Double x:Key="DisplayMediumFontSize">34</x:Double>
			<x:Int32 x:Key="DisplayMediumCharacterSpacing">0</x:Int32>

			<!-- DisplaySmall — Large Title (34pt, Normal) -->
