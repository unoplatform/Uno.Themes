<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<!-- Root typeface token (cascades to all type scales) -->
			<FontFamily x:Key="DefaultFontFamily">ms-appx:///Uno.Fonts.Inter/Fonts/Inter.ttf#Inter</FontFamily>

			<!-- Legacy Cupertino-specific font family key -->
			<StaticResource x:Key="CupertinoFontFamily" ResourceKey="DefaultFontFamily" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<!-- Root typeface token (cascades to all type scales) -->
			<FontFamily x:Key="DefaultFontFamily">ms-appx:///Uno.Fonts.Inter/Fonts/Inter.ttf#Inter</FontFamily>

			<!-- Legacy Cupertino-specific font family key -->
			<StaticResource x:Key="CupertinoFontFamily" ResourceKey="DefaultFontFamily" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="HighContrast">
			<!-- Root typeface token (cascades to all type scales) -->
			<FontFamily x:Key="DefaultFontFamily">ms-appx:///Uno.Fonts.Inter/Fonts/Inter.ttf#Inter</FontFamily>

			<!-- Legacy Cupertino-specific font family key -->
			<StaticResource x:Key="CupertinoFontFamily" ResourceKey="DefaultFontFamily" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
