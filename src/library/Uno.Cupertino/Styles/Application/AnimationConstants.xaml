<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<CubicEase x:Key="CupertinoEaseInOutFunction"
			   EasingMode="EaseInOut" />

	<CubicEase x:Key="CupertinoEaseOutFunction"
			   EasingMode="EaseOut" />

	<Duration x:Key="CupertinoAnimationDuration">0:0:0.10</Duration>

	<Duration x:Key="CupertinoTextBoxAnimationDuration">0:0:0.25</Duration>

	<x:String x:Key="CupertinoDelayedBeginTime">0:0:0.15</x:String>

	<!--
		Knob lift while a switch or slider knob is pressed (HIG Materials: knobs become glass only during
		interaction). Apple's interactive spring responds in 0.15 s; the BackEase in the templates supplies the
		overshoot. 1.5 makes a 24 px knob overhang a 28 px track the way the iOS 26 knob does.
		The solid knob rests on a ThemeShadow whose depth is Translation.Z (a string: Vector3 has no XAML
		literal); the pressed glass knob draws its own, deeper shadow.
	-->
	<Duration x:Key="CupertinoKnobLiftDuration">0:0:0.15</Duration>
	<!-- The switch knob glides and the track cross-fades over this; Apple publishes no value, UISwitch takes about 0.2 s. -->
	<Duration x:Key="CupertinoToggleDuration">0:0:0.2</Duration>
	<x:Double x:Key="CupertinoKnobLiftScale">1.5</x:Double>
	<x:String x:Key="CupertinoKnobRestTranslation">0,0,10</x:String>
</ResourceDictionary>
