<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:uc="using:Uno.Cupertino">

	<!--
		Background (with the hairline) is the opaque fill of the Solid tier and, at the material's veil
		opacity, the layer that keeps content legible over the Liquid tier, where the backplate draws the rim.
		GlassPanel inserts its Skia backplate beneath PART_Fill.
	-->
	<Style x:Key="CupertinoGlassPanelStyle"
		   TargetType="uc:GlassPanel">
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
		<Setter Property="BorderThickness" Value="0.5" />
		<Setter Property="CornerRadius" Value="{ThemeResource Radius400CornerRadius}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="uc:GlassPanel">
					<Grid x:Name="PART_Root">
						<Border x:Name="PART_Fill"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{TemplateBinding CornerRadius}" />
						<Border Background="{TemplateBinding Tint}"
								CornerRadius="{TemplateBinding CornerRadius}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
