<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="NavigationViewButtonForeground" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewButtonForegroundPointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewButtonForegroundPressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewButtonForegroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<SolidColorBrush x:Key="NavigationViewButtonBackgroundPointerOver"
							 Color="Transparent" />
			<SolidColorBrush x:Key="NavigationViewButtonBackgroundPressed"
							 Color="Transparent" />
			<SolidColorBrush x:Key="NavigationViewButtonBackgroundDisabled"
							 Color="Transparent" />
			<StaticResource x:Key="NavigationViewItemForeground" ResourceKey="OnSurfaceBrush" />
			<SolidColorBrush x:Key="NavigationViewItemBackground"
							 Color="Transparent" />
			<StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="SecondaryContainerBrush" />
			<StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="SecondaryContainerBrush" />
			<StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="PrimarySelectedBrush" />
			<StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="PrimarySelectedBrush" />
			<StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="PrimarySelectedBrush" />
			<StaticResource x:Key="NavigationViewItemForegroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<SolidColorBrush x:Key="NavigationViewItemBackgroundDisabled"
							 Color="Transparent" />
			<StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="NavigationViewItemSeparatorForeground" ResourceKey="OutlineVariantBrush" />
			<StaticResource x:Key="TopNavigationViewItemForeground" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundPointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundPressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundSelected" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundSelectedPointerOver" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundSelectedPressed" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundPointerOver" ResourceKey="SecondaryContainerBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundPressed" ResourceKey="SecondaryContainerBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundSelected" ResourceKey="PrimarySelectedBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" ResourceKey="PrimarySelectedBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPressed" ResourceKey="PrimarySelectedBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">

			<StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SurfaceBrush" />

			<StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="SurfaceBrush" />

			<StaticResource x:Key="NavigationViewButtonForeground" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewButtonForegroundPointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewButtonForegroundPressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewButtonForegroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<SolidColorBrush x:Key="NavigationViewButtonBackgroundPointerOver"
							 Color="Transparent" />
			<SolidColorBrush x:Key="NavigationViewButtonBackgroundPressed"
							 Color="Transparent" />
			<SolidColorBrush x:Key="NavigationViewButtonBackgroundDisabled"
							 Color="Transparent" />

			<StaticResource x:Key="NavigationViewItemForeground" ResourceKey="OnSurfaceBrush" />
			<SolidColorBrush x:Key="NavigationViewItemBackground"
							 Color="Transparent" />

			<StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="SecondaryContainerBrush" />

			<StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="SecondaryContainerBrush" />

			<StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="PrimarySelectedBrush" />

			<StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="PrimarySelectedBrush" />

			<StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="PrimarySelectedBrush" />

			<StaticResource x:Key="NavigationViewItemForegroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<SolidColorBrush x:Key="NavigationViewItemBackgroundDisabled"
							 Color="Transparent" />

			<StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="PrimaryBrush" />

			<StaticResource x:Key="NavigationViewItemSeparatorForeground" ResourceKey="OutlineVariantBrush" />

			<StaticResource x:Key="TopNavigationViewItemForeground" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundPointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundPressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundSelected" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />

			<StaticResource x:Key="TopNavigationViewItemForegroundSelectedPointerOver" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TopNavigationViewItemForegroundSelectedPressed" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundPointerOver" ResourceKey="SecondaryContainerBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundPressed" ResourceKey="SecondaryContainerBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundSelected" ResourceKey="PrimarySelectedBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" ResourceKey="PrimarySelectedBrush" />
			<StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPressed" ResourceKey="PrimarySelectedBrush" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>
	<!-- Keep stock navigation behavior; the sidebar remains solid pending a glass-pane template. -->
	<!-- The stock left presenter reads this with ThemeResource, so its actual row grows to 44 px. -->
	<x:Double x:Key="NavigationViewItemOnLeftMinHeight">44</x:Double>
	<CornerRadius x:Key="CupertinoNavigationViewItemCornerRadius">10</CornerRadius>

	<Style x:Key="CupertinoNavigationViewStyle"
		   TargetType="muxc:NavigationView">
		<Setter Property="Background" Value="{ThemeResource NavigationViewContentBackground}" />
	</Style>
	<Style x:Key="CupertinoNavigationViewItemStyle"
		   TargetType="muxc:NavigationViewItem">
		<Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForeground}" />
		<Setter Property="CornerRadius" Value="{StaticResource CupertinoNavigationViewItemCornerRadius}" />
		<Setter Property="MinHeight" Value="{StaticResource CupertinoRowMinHeight}" />
	</Style>

</ResourceDictionary>
