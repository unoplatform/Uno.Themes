																									   HorizontalAlignment="Center"
																									   VerticalAlignment="Center"
																									   Visibility="Collapsed"
																									   AutomationProperties.AccessibilityView="Raw"
																									   x:DeferLoadStrategy="Lazy">
																					<animatedvisuals:AnimatedChevronUpDownSmallVisualSource />
