		<Setter Property="FontSize" Value="{ThemeResource CaptionSmallFontSize}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource CaptionSmallCharacterSpacing}" />
	</Style>

	<!-- Apple-named styles: each is the slot carrying the same text style, plus its leading. -->

	<!--
		******************************************************************
		STYLE GUIDE TEXTBLOCKS STYLES
		******************************************************************
	-->

	<!-- Large Title -->
	<Style x:Key="CupertinoLargeTitle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoDisplaySmall}">

		<Setter Property="LineHeight" Value="41" />
	</Style>

	<!-- Title 1 -->
	<Style x:Key="CupertinoPrimaryTitle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoHeadlineLarge}">

		<Setter Property="LineHeight" Value="34" />
	</Style>

	<!-- Title 2 -->
	<Style x:Key="CupertinoSecondaryTitle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoHeadlineMedium}">

		<Setter Property="LineHeight" Value="28" />
	</Style>

	<!-- Title 3 -->
	<Style x:Key="CupertinoTertiaryTitle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoHeadlineSmall}">

		<Setter Property="LineHeight" Value="25" />
	</Style>

	<!-- Headline -->
	<Style x:Key="CupertinoHeadline"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoTitleMedium}">

		<Setter Property="LineHeight" Value="22" />
	</Style>

	<!-- Body -->
	<Style x:Key="CupertinoBody"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoBodyLarge}">

		<Setter Property="LineHeight" Value="22" />
	</Style>

	<!-- Callout -->
	<Style x:Key="CupertinoCallout"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoBodyMedium}">

		<Setter Property="LineHeight" Value="21" />
	</Style>

	<!-- Subhead -->
	<Style x:Key="CupertinoSubhead"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoBodySmall}">

		<Setter Property="LineHeight" Value="20" />
	</Style>

	<!-- Footnote -->
	<Style x:Key="CupertinoFootnote"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoCaptionLarge}">

		<Setter Property="LineHeight" Value="18" />
	</Style>

	<!-- Caption 1 -->
	<Style x:Key="CupertinoPrimaryCaption"
