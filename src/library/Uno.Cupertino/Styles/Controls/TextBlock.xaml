<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Based on https://developer.apple.com/design/human-interface-guidelines/ios/visual-design/typography/#dynamic-type-sizes default style -->
	<Style x:Key="CupertinoBaseTextBlockStyle"
		   TargetType="TextBlock">
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="FontFamily" Value="{ThemeResource CupertinoFontFamily}" />
	</Style>

	<!--
		Semantic type scale. Each style reads its slot tokens (Typography.xaml) through ThemeResource, so a
		DefaultFontFamily change or a lightweight override of a *FontSize / *FontWeight token reaches it.
	-->
	<Style x:Key="CupertinoDisplayLarge"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoBaseTextBlockStyle}">
		<Setter Property="FontFamily" Value="{ThemeResource DisplayLargeFontFamily}" />
		<Setter Property="FontWeight" Value="{ThemeResource DisplayLargeFontWeight}" />
		<Setter Property="FontSize" Value="{ThemeResource DisplayLargeFontSize}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource DisplayLargeCharacterSpacing}" />
	</Style>

	<Style x:Key="CupertinoDisplayMedium"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource CupertinoBaseTextBlockStyle}">
		<Setter Property="FontFamily" Value="{ThemeResource DisplayMediumFontFamily}" />
		<Setter Property="FontWeight" Value="{ThemeResource DisplayMediumFontWeight}" />
		<Setter Property="FontSize" Value="{ThemeResource DisplayMediumFontSize}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource DisplayMediumCharacterSpacing}" />
	</Style>

	<Style x:Key="CupertinoDisplaySmall"
		   TargetType="TextBlock"
