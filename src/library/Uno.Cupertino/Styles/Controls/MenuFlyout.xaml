						<FontIcon x:Name="SubItemChevron"
								  Grid.Column="3"
								  Glyph=""
								  FontSize="{StaticResource CupertinoMenuFlyoutItemGlyphFontSize}"
								  Foreground="{ThemeResource MenuFlyoutSubItemChevron}"
								  MirroredWhenRightToLeft="True"
								  VerticalAlignment="Center" />
						<Border x:Name="CheckGutter"
								Width="{ThemeResource IconSizeMedium}"
								Visibility="Collapsed" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="CupertinoMenuFlyoutSeparatorStyle"
		   TargetType="MenuFlyoutSeparator">
		<Setter Property="Background" Value="{ThemeResource MenuFlyoutSeparatorBackground}" />
		<Setter Property="Padding" Value="{ThemeResource CupertinoMenuFlyoutSeparatorMargin}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="MenuFlyoutSeparator">
					<Rectangle Fill="{TemplateBinding Background}"
							   Height="{ThemeResource CupertinoMenuFlyoutSeparatorHeight}"
							   Margin="{TemplateBinding Padding}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>