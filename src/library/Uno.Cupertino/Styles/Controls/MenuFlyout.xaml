		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleMenuFlyoutItem">
