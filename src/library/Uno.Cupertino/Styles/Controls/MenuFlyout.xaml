<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
					xmlns:uc="using:Uno.Cupertino">

	<!--
		A menu: 44 px rows on the popover glass. A row highlights with the gray fill while hovered or pressed
		and dims when disabled; a checked toggle or radio row shows a leading checkmark, a sub-item a trailing
		chevron. The separator is an 8 px band of fill, the gap between two groups (HIG menus artwork).
	-->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="CupertinoMenuFlyoutItemIconMargin" ResourceKey="Space250LeftThickness" />
			<StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="OutlineVariantBrush" />
			<StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="CupertinoQuaternarySystemFillBrush" />
			<StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="CupertinoSystemFillBrush" />
			<StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="OnSurfaceVariantBrush" />
			<StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="OnSurfaceVariantBrush" />
			<StaticResource x:Key="MenuFlyoutSeparatorBackground" ResourceKey="CupertinoSecondarySystemFillBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="CupertinoMenuFlyoutItemIconMargin" ResourceKey="Space250LeftThickness" />
			<StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="OutlineVariantBrush" />
			<StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="CupertinoQuaternarySystemFillBrush" />
			<StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="CupertinoSystemFillBrush" />
			<StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="OnSurfaceVariantBrush" />
			<StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="OnSurfaceVariantBrush" />
			<StaticResource x:Key="MenuFlyoutSeparatorBackground" ResourceKey="CupertinoSecondarySystemFillBrush" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<x:Double x:Key="CupertinoMenuFlyoutPresenterMinWidth">250</x:Double>
	<StaticResource x:Key="CupertinoMenuFlyoutItemHeight" ResourceKey="ControlHeightMediumLarge" />
	<StaticResource x:Key="CupertinoMenuFlyoutItemPadding" ResourceKey="Space400HorizontalThickness" />
	<x:Double x:Key="CupertinoMenuFlyoutItemIconSize">22</x:Double>
	<x:Double x:Key="CupertinoMenuFlyoutItemGlyphFontSize">13</x:Double>
	<Thickness x:Key="CupertinoMenuFlyoutSeparatorMargin">0</Thickness>
	<StaticResource x:Key="CupertinoMenuFlyoutSeparatorHeight" ResourceKey="Space200" />

	<Style x:Key="CupertinoMenuFlyoutPresenterStyle"
		   TargetType="MenuFlyoutPresenter">
		<Setter Property="Background" Value="{ThemeResource MenuFlyoutPresenterBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutPresenterBorderBrush}" />
		<Setter Property="BorderThickness" Value="{StaticResource CupertinoHairlineThickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource CupertinoPopoverCornerRadius}" />
		<Setter Property="Foreground" Value="{ThemeResource MenuFlyoutItemForeground}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource BodyLargeCharacterSpacing}" />
		<Setter Property="MinWidth" Value="{StaticResource CupertinoMenuFlyoutPresenterMinWidth}" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="ScrollViewer.ZoomMode" Value="Disabled" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="MenuFlyoutPresenter">
					<Grid>
						<uc:GlassPanel Material="Thick"
									   Tint="{ThemeResource CupertinoPopoverTintBrush}"
									   Background="{TemplateBinding Background}"
									   BorderBrush="{TemplateBinding BorderBrush}"
									   BorderThickness="{TemplateBinding BorderThickness}"
									   CornerRadius="{TemplateBinding CornerRadius}" />
						<Border CornerRadius="{TemplateBinding CornerRadius}">
							<ScrollViewer x:Name="MenuFlyoutPresenterScrollViewer"
										  Margin="{TemplateBinding Padding}"
										  ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}"
										  HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
										  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
										  VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
										  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
										  AutomationProperties.AccessibilityView="Raw">
								<ItemsPresenter />
							</ScrollViewer>
						</Border>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="CupertinoMenuFlyoutItemStyle"
		   TargetType="MenuFlyoutItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource MenuFlyoutItemForeground}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource BodyLargeCharacterSpacing}" />
		<Setter Property="MinHeight" Value="{ThemeResource CupertinoMenuFlyoutItemHeight}" />
		<Setter Property="Padding" Value="{ThemeResource CupertinoMenuFlyoutItemPadding}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="MenuFlyoutItem">
					<Grid x:Name="LayoutRoot"
						  Background="{TemplateBinding Background}"
						  MinHeight="{TemplateBinding MinHeight}"
						  Padding="{TemplateBinding Padding}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="LayoutRoot.Opacity" Value="{StaticResource CupertinoDisableStateOpacity}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="CheckPlaceholderStates">
								<VisualState x:Name="NoPlaceholder" />
								<VisualState x:Name="CheckPlaceholder">
									<VisualState.Setters>
										<Setter Target="CheckGutter.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IconPlaceholder">
									<VisualState.Setters>
										<Setter Target="IconRoot.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckAndIconPlaceholder">
									<VisualState.Setters>
										<Setter Target="IconRoot.Visibility" Value="Visible" />
										<Setter Target="CheckGutter.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="KeyboardAcceleratorTextVisibility">
								<VisualState x:Name="KeyboardAcceleratorTextCollapsed" />
								<VisualState x:Name="KeyboardAcceleratorTextVisible">
									<VisualState.Setters>
										<Setter Target="KeyboardAcceleratorTextBlock.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Viewbox x:Name="IconRoot"
								 Grid.Column="2"
								 Width="{StaticResource CupertinoMenuFlyoutItemIconSize}"
								 Height="{StaticResource CupertinoMenuFlyoutItemIconSize}"
								 Margin="{ThemeResource CupertinoMenuFlyoutItemIconMargin}"
								 VerticalAlignment="Center"
								 Visibility="Collapsed">
							<ContentPresenter x:Name="IconContent"
											  Content="{TemplateBinding Icon}"
											  Foreground="{TemplateBinding Foreground}" />
						</Viewbox>

						<TextBlock CharacterSpacing="{TemplateBinding CharacterSpacing}"
								   x:Name="TextBlock"
								   Grid.Column="1"
								   Text="{TemplateBinding Text}"
								   Foreground="{TemplateBinding Foreground}"
								   TextTrimming="CharacterEllipsis"
								   VerticalAlignment="Center" />

						<TextBlock CharacterSpacing="{TemplateBinding CharacterSpacing}"
								   x:Name="KeyboardAcceleratorTextBlock"
								   Grid.Column="3"
								   Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
								   Foreground="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"
								   Margin="{ThemeResource CupertinoMenuFlyoutItemIconMargin}"
								   VerticalAlignment="Center"
								   Visibility="Collapsed" />
						<Border x:Name="CheckGutter"
								Width="{ThemeResource IconSizeMedium}"
								Visibility="Collapsed" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="CupertinoToggleMenuFlyoutItemStyle"
