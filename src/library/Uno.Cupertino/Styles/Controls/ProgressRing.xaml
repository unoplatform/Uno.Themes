<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:not_win="http://uno.ui/not_win"
					xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
					mc:Ignorable="not_win">

	<!--
		Apple's activity indicator: eight spokes, the brightest one stepping around the ring every 0.1 s with
		a fading trail behind it. The spokes keep their opacity and the whole group turns in 45 degree steps,
		so the animation is one key-frame track. There is no determinate indicator in the HIG: a determinate
		ring shows the spokes at rest.
		
		On WinAppSDK the native ring is kept and only tinted.
	-->
	<x:Double x:Key="CupertinoProgressRingSize">20</x:Double>
	<x:Double x:Key="CupertinoLargeProgressRingSize">37</x:Double>

	<!-- Laid out at the top center of a 20 x 20 box and turned around the center of that box, 10 px below its top. -->
	<not_win:Style x:Key="CupertinoProgressRingSpokeStyle"
				   TargetType="Rectangle">
		<Setter Property="Width" Value="2.4" />
		<Setter Property="Height" Value="6" />
		<Setter Property="RadiusX" Value="1.2" />
		<Setter Property="RadiusY" Value="1.2" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="RenderTransformOrigin" Value="0.5,1.6667" />
	</not_win:Style>

	<not_win:Style x:Key="CupertinoProgressRingStyle"
				   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource CupertinoPrimaryGrayBrush}" />
		<Setter Property="Width" Value="{StaticResource CupertinoProgressRingSize}" />
		<Setter Property="Height" Value="{StaticResource CupertinoProgressRingSize}" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="muxc:ProgressRing">
					<Grid x:Name="LayoutRoot"
						  Background="Transparent">

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Inactive">
									<VisualState.Setters>
										<Setter Target="Spokes.Opacity" Value="0" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="DeterminateActive" />
								<VisualState x:Name="Active">
									<Storyboard RepeatBehavior="Forever">
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="SpokesRotation"
																	   Storyboard.TargetProperty="Angle"
																	   Duration="0:0:0.8">
											<DiscreteDoubleKeyFrame KeyTime="0:0:0"
																	Value="0" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.1"
																	Value="45" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.2"
																	Value="90" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.3"
																	Value="135" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.4"
																	Value="180" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.5"
																	Value="225" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.6"
																	Value="270" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.7"
																	Value="315" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<Viewbox>
							<Grid x:Name="Spokes"
								  Width="20"
								  Height="20"
								  RenderTransformOrigin="0.5,0.5">
								<Grid.RenderTransform>
									<RotateTransform x:Name="SpokesRotation" />
								</Grid.RenderTransform>
								<Rectangle Fill="{TemplateBinding Foreground}"
										   Opacity="1"
										   Style="{StaticResource CupertinoProgressRingSpokeStyle}">
									<Rectangle.RenderTransform>
										<RotateTransform Angle="0" />
									</Rectangle.RenderTransform>
								</Rectangle>
								<Rectangle Fill="{TemplateBinding Foreground}"
										   Opacity="0.815"
										   Style="{StaticResource CupertinoProgressRingSpokeStyle}">
									<Rectangle.RenderTransform>
										<RotateTransform Angle="315" />
									</Rectangle.RenderTransform>
								</Rectangle>
								<Rectangle Fill="{TemplateBinding Foreground}"
										   Opacity="0.63"
										   Style="{StaticResource CupertinoProgressRingSpokeStyle}">
									<Rectangle.RenderTransform>
										<RotateTransform Angle="270" />
									</Rectangle.RenderTransform>
								</Rectangle>
								<Rectangle Fill="{TemplateBinding Foreground}"
										   Opacity="0.445"
										   Style="{StaticResource CupertinoProgressRingSpokeStyle}">
									<Rectangle.RenderTransform>
										<RotateTransform Angle="225" />
									</Rectangle.RenderTransform>
								</Rectangle>
								<Rectangle Fill="{TemplateBinding Foreground}"
										   Opacity="0.35"
										   Style="{StaticResource CupertinoProgressRingSpokeStyle}">
									<Rectangle.RenderTransform>
										<RotateTransform Angle="180" />
									</Rectangle.RenderTransform>
								</Rectangle>
								<Rectangle Fill="{TemplateBinding Foreground}"
										   Opacity="0.35"
										   Style="{StaticResource CupertinoProgressRingSpokeStyle}">
									<Rectangle.RenderTransform>
										<RotateTransform Angle="135" />
									</Rectangle.RenderTransform>
								</Rectangle>
								<Rectangle Fill="{TemplateBinding Foreground}"
										   Opacity="0.35"
										   Style="{StaticResource CupertinoProgressRingSpokeStyle}">
									<Rectangle.RenderTransform>
										<RotateTransform Angle="90" />
									</Rectangle.RenderTransform>
								</Rectangle>
								<Rectangle Fill="{TemplateBinding Foreground}"
										   Opacity="0.35"
										   Style="{StaticResource CupertinoProgressRingSpokeStyle}">
									<Rectangle.RenderTransform>
										<RotateTransform Angle="45" />
									</Rectangle.RenderTransform>
								</Rectangle>
							</Grid>
						</Viewbox>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</not_win:Style>

	<win:Style x:Key="CupertinoProgressRingStyle"
			   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource CupertinoPrimaryGrayBrush}" />
	</win:Style>

	<Style x:Key="CupertinoLargeProgressRingStyle"
		   BasedOn="{StaticResource CupertinoProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Width" Value="{StaticResource CupertinoLargeProgressRingSize}" />
		<Setter Property="Height" Value="{StaticResource CupertinoLargeProgressRingSize}" />
	</Style>

</ResourceDictionary>
