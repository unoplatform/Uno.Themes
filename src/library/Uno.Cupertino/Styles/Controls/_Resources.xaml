<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
					xmlns:not_win="http://uno.ui/not_win"
					xmlns:uc="using:Uno.Cupertino"
					mc:Ignorable="d not_win">

	<!--
		Implicit styles. The implicit Button is the plain (accent text, no background) style: Apple's
		default button, and glass never belongs in the content layer.
		
		The implicit TextBlock is the BASE style, which carries no metrics: an application-level implicit
		TextBlock style reaches into every control template, and a FontSize there would override the one a
		template TextBlock inherits from its control (a 13px TextBox would show a 17px placeholder).
		
		The implicit ProgressRing is not_win only, as it always was.
	-->
	<Style BasedOn="{StaticResource CupertinoPlainButtonStyle}"
		   TargetType="Button" />
	<Style BasedOn="{StaticResource CupertinoCalendarDatePickerStyle}"
		   TargetType="CalendarDatePicker" />
	<Style BasedOn="{StaticResource CupertinoCalendarViewStyle}"
		   TargetType="CalendarView" />
	<Style BasedOn="{StaticResource CupertinoCheckBoxStyle}"
		   TargetType="CheckBox" />
	<Style BasedOn="{StaticResource CupertinoComboBoxStyle}"
		   TargetType="ComboBox" />
	<Style BasedOn="{StaticResource CupertinoDatePickerStyle}"
		   TargetType="DatePicker" />
	<Style BasedOn="{StaticResource CupertinoGlassPanelStyle}"
		   TargetType="uc:GlassPanel" />
	<Style BasedOn="{StaticResource CupertinoDatePickerFlyoutPresenterStyle}"
		   TargetType="DatePickerFlyoutPresenter" />
	<Style BasedOn="{StaticResource CupertinoFlyoutPresenterStyle}"
		   TargetType="FlyoutPresenter" />
	<Style BasedOn="{StaticResource CupertinoHyperlinkButtonStyle}"
		   TargetType="HyperlinkButton" />
	<Style BasedOn="{StaticResource CupertinoListViewStyle}"
		   TargetType="ListView" />
	<Style BasedOn="{StaticResource CupertinoListViewItemStyle}"
		   TargetType="ListViewItem" />
	<Style BasedOn="{StaticResource CupertinoMenuFlyoutItemStyle}"
		   TargetType="MenuFlyoutItem" />
	<Style BasedOn="{StaticResource CupertinoMenuFlyoutPresenterStyle}"
		   TargetType="MenuFlyoutPresenter" />
	<Style BasedOn="{StaticResource CupertinoMenuFlyoutSeparatorStyle}"
		   TargetType="MenuFlyoutSeparator" />
	<Style BasedOn="{StaticResource CupertinoMenuFlyoutSubItemStyle}"
		   TargetType="MenuFlyoutSubItem" />
	<Style BasedOn="{StaticResource CupertinoRadioMenuFlyoutItemStyle}"
		   TargetType="muxc:RadioMenuFlyoutItem" />
	<Style BasedOn="{StaticResource CupertinoNumberBoxStyle}"
		   TargetType="muxc:NumberBox" />
	<Style BasedOn="{StaticResource CupertinoPasswordBoxStyle}"
		   TargetType="PasswordBox" />
	<Style BasedOn="{StaticResource CupertinoProgressBarStyle}"
		   TargetType="ProgressBar" />
	<not_win:Style BasedOn="{StaticResource CupertinoProgressRingStyle}"
				   TargetType="muxc:ProgressRing" />
	<Style BasedOn="{StaticResource CupertinoRadioButtonStyle}"
		   TargetType="RadioButton" />
	<Style BasedOn="{StaticResource CupertinoSliderStyle}"
		   TargetType="Slider" />
	<Style BasedOn="{StaticResource CupertinoBaseTextBlockStyle}"
		   TargetType="TextBlock" />
	<Style BasedOn="{StaticResource CupertinoTextBoxStyle}"
		   TargetType="TextBox" />
	<Style BasedOn="{StaticResource CupertinoTextToggleButtonStyle}"
		   TargetType="ToggleButton" />
	<Style BasedOn="{StaticResource CupertinoToggleMenuFlyoutItemStyle}"
		   TargetType="ToggleMenuFlyoutItem" />
	<Style BasedOn="{StaticResource CupertinoToggleSwitchStyle}"
		   TargetType="ToggleSwitch" />
	<Style BasedOn="{StaticResource CupertinoToolTipStyle}"
		   TargetType="ToolTip" />

	<!--
		Semantic style aliases shared with Material and Simple (doc/semantic-styles.md). Only the keys
		Cupertino has a style for today are declared; the rest arrive with their controls.
	-->

	<!--
		Button. No semantic button key resolves to glass: these are the buttons of forms and lists, and glass repaints
		on every frame. Apple has neither an outlined nor an elevated button; gray is the closest to both.
	-->
	<StaticResource x:Key="FilledButtonStyle" ResourceKey="CupertinoProminentButtonStyle" />
	<StaticResource x:Key="FilledTonalButtonStyle" ResourceKey="CupertinoTintedButtonStyle" />
	<StaticResource x:Key="OutlinedButtonStyle" ResourceKey="CupertinoGrayButtonStyle" />
	<StaticResource x:Key="ElevatedButtonStyle" ResourceKey="CupertinoGrayButtonStyle" />
	<StaticResource x:Key="TextButtonStyle" ResourceKey="CupertinoPlainButtonStyle" />
	<StaticResource x:Key="IconButtonStyle" ResourceKey="CupertinoIconButtonStyle" />

	<!-- FAB: the HIG has none. A floating action is where Apple does use glass, so the first two families are glass circles. -->
	<StaticResource x:Key="FabStyle" ResourceKey="CupertinoGlassProminentIconButtonStyle" />
	<StaticResource x:Key="SmallFabStyle" ResourceKey="CupertinoGlassProminentIconButtonStyle" />
	<StaticResource x:Key="LargeFabStyle" ResourceKey="CupertinoLargeGlassProminentIconButtonStyle" />
	<StaticResource x:Key="SecondaryFabStyle" ResourceKey="CupertinoGlassIconButtonStyle" />
	<StaticResource x:Key="SecondarySmallFabStyle" ResourceKey="CupertinoGlassIconButtonStyle" />
	<StaticResource x:Key="SecondaryLargeFabStyle" ResourceKey="CupertinoLargeGlassIconButtonStyle" />
	<StaticResource x:Key="TertiaryFabStyle" ResourceKey="CupertinoTintedIconButtonStyle" />
	<StaticResource x:Key="TertiarySmallFabStyle" ResourceKey="CupertinoTintedIconButtonStyle" />
	<StaticResource x:Key="TertiaryLargeFabStyle" ResourceKey="CupertinoLargeTintedIconButtonStyle" />
	<StaticResource x:Key="SurfaceFabStyle" ResourceKey="CupertinoGrayIconButtonStyle" />
	<StaticResource x:Key="SurfaceSmallFabStyle" ResourceKey="CupertinoGrayIconButtonStyle" />
	<StaticResource x:Key="SurfaceLargeFabStyle" ResourceKey="CupertinoLargeGrayIconButtonStyle" />

	<!-- TextBox / PasswordBox -->
	<StaticResource x:Key="OutlinedTextBoxStyle" ResourceKey="CupertinoTextBoxStyle" />
	<StaticResource x:Key="FilledTextBoxStyle" ResourceKey="CupertinoFilledTextBoxStyle" />
	<StaticResource x:Key="OutlinedPasswordBoxStyle" ResourceKey="CupertinoPasswordBoxStyle" />
	<StaticResource x:Key="FilledPasswordBoxStyle" ResourceKey="CupertinoFilledPasswordBoxStyle" />

	<!-- ComboBox -->
	<StaticResource x:Key="ComboBoxStyle" ResourceKey="CupertinoComboBoxStyle" />
	<StaticResource x:Key="ComboBoxItemStyle" ResourceKey="CupertinoComboBoxItemStyle" />

	<!-- Selection controls -->
	<StaticResource x:Key="CheckBoxStyle" ResourceKey="CupertinoCheckBoxStyle" />
	<StaticResource x:Key="RadioButtonStyle" ResourceKey="CupertinoRadioButtonStyle" />
	<StaticResource x:Key="ToggleSwitchStyle" ResourceKey="CupertinoToggleSwitchStyle" />
	<StaticResource x:Key="SliderStyle" ResourceKey="CupertinoSliderStyle" />

	<!-- HyperlinkButton -->
	<StaticResource x:Key="HyperlinkButtonStyle" ResourceKey="CupertinoHyperlinkButtonStyle" />
	<StaticResource x:Key="SecondaryHyperlinkButtonStyle" ResourceKey="CupertinoSecondaryHyperlinkButtonStyle" />

	<!-- ToggleButton -->
	<StaticResource x:Key="TextToggleButtonStyle" ResourceKey="CupertinoTextToggleButtonStyle" />
	<StaticResource x:Key="IconToggleButtonStyle" ResourceKey="CupertinoIconToggleButtonStyle" />

	<!-- Date / calendar -->
	<StaticResource x:Key="CalendarViewStyle" ResourceKey="CupertinoCalendarViewStyle" />
	<StaticResource x:Key="CalendarDatePickerStyle" ResourceKey="CupertinoCalendarDatePickerStyle" />
	<StaticResource x:Key="DatePickerStyle" ResourceKey="CupertinoDatePickerStyle" />

	<!-- Progress -->
	<StaticResource x:Key="ProgressBarStyle" ResourceKey="CupertinoProgressBarStyle" />
	<StaticResource x:Key="ProgressRingStyle" ResourceKey="CupertinoProgressRingStyle" />

	<!-- Lists -->
	<StaticResource x:Key="ListViewStyle" ResourceKey="CupertinoListViewStyle" />
	<StaticResource x:Key="ListViewItemStyle" ResourceKey="CupertinoListViewItemStyle" />

	<!-- Popovers and menus -->
	<StaticResource x:Key="FlyoutPresenterStyle" ResourceKey="CupertinoFlyoutPresenterStyle" />
	<StaticResource x:Key="MenuFlyoutPresenterStyle" ResourceKey="CupertinoMenuFlyoutPresenterStyle" />
	<StaticResource x:Key="MenuFlyoutItemStyle" ResourceKey="CupertinoMenuFlyoutItemStyle" />
	<StaticResource x:Key="MenuFlyoutSeparatorStyle" ResourceKey="CupertinoMenuFlyoutSeparatorStyle" />
	<StaticResource x:Key="MenuFlyoutSubItemStyle" ResourceKey="CupertinoMenuFlyoutSubItemStyle" />
	<StaticResource x:Key="ToggleMenuFlyoutItemStyle" ResourceKey="CupertinoToggleMenuFlyoutItemStyle" />
	<StaticResource x:Key="RadioMenuFlyoutItemStyle" ResourceKey="CupertinoRadioMenuFlyoutItemStyle" />

	<!-- Typography -->
	<StaticResource x:Key="DisplayLarge" ResourceKey="CupertinoDisplayLarge" />
	<StaticResource x:Key="DisplayMedium" ResourceKey="CupertinoDisplayMedium" />
	<StaticResource x:Key="DisplaySmall" ResourceKey="CupertinoDisplaySmall" />
	<StaticResource x:Key="HeadlineLarge" ResourceKey="CupertinoHeadlineLarge" />
	<StaticResource x:Key="HeadlineMedium" ResourceKey="CupertinoHeadlineMedium" />
	<StaticResource x:Key="HeadlineSmall" ResourceKey="CupertinoHeadlineSmall" />
	<StaticResource x:Key="TitleLarge" ResourceKey="CupertinoTitleLarge" />
	<StaticResource x:Key="TitleMedium" ResourceKey="CupertinoTitleMedium" />
	<StaticResource x:Key="TitleSmall" ResourceKey="CupertinoTitleSmall" />
	<StaticResource x:Key="BodyLarge" ResourceKey="CupertinoBodyLarge" />
	<StaticResource x:Key="BodyMedium" ResourceKey="CupertinoBodyMedium" />
	<StaticResource x:Key="BodySmall" ResourceKey="CupertinoBodySmall" />
	<StaticResource x:Key="LabelLarge" ResourceKey="CupertinoLabelLarge" />
	<StaticResource x:Key="LabelMedium" ResourceKey="CupertinoLabelMedium" />
	<StaticResource x:Key="LabelSmall" ResourceKey="CupertinoLabelSmall" />
	<StaticResource x:Key="LabelExtraSmall" ResourceKey="CupertinoLabelExtraSmall" />
	<StaticResource x:Key="CaptionLarge" ResourceKey="CupertinoCaptionLarge" />
	<StaticResource x:Key="CaptionMedium" ResourceKey="CupertinoCaptionMedium" />
	<StaticResource x:Key="CaptionSmall" ResourceKey="CupertinoCaptionSmall" />
</ResourceDictionary>
