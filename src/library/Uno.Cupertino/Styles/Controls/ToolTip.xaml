<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- The macOS tooltip: caption text on the surface, behind a hairline. Solid, not glass: it is transient and small. -->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="ToolTipBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="ToolTipBorderBrush" ResourceKey="OutlineVariantBrush" />
			<StaticResource x:Key="ToolTipForeground" ResourceKey="OnSurfaceBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="ToolTipBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="ToolTipBorderBrush" ResourceKey="OutlineVariantBrush" />
			<StaticResource x:Key="ToolTipForeground" ResourceKey="OnSurfaceBrush" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<Thickness x:Key="CupertinoToolTipPadding">10,6</Thickness>
	<CornerRadius x:Key="CupertinoToolTipCornerRadius">8</CornerRadius>
	<x:Double x:Key="CupertinoToolTipMaxWidth">320</x:Double>

	<Style x:Key="CupertinoToolTipStyle"
		   TargetType="ToolTip">
		<Setter Property="Background" Value="{ThemeResource ToolTipBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ToolTipBorderBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource ToolTipForeground}" />
		<Setter Property="BorderThickness" Value="{StaticResource CupertinoHairlineThickness}" />
		<Setter Property="Padding" Value="{StaticResource CupertinoToolTipPadding}" />
		<Setter Property="CornerRadius" Value="{StaticResource CupertinoToolTipCornerRadius}" />
		<Setter Property="MaxWidth" Value="{StaticResource CupertinoToolTipMaxWidth}" />
		<Setter Property="FontFamily" Value="{ThemeResource CaptionLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource CaptionLargeFontSize}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToolTip">
					<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}"
							Padding="{TemplateBinding Padding}">
						<ContentPresenter Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  TextWrapping="Wrap"
										  MaxWidth="{TemplateBinding MaxWidth}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
