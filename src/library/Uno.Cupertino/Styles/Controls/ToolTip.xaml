<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:uc="using:Uno.Cupertino">

	<!-- Compact informational hint for pointer/keyboard use. iOS has no direct native ToolTip equivalent. -->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<Thickness x:Key="CupertinoToolTipPadding">10,6</Thickness>
			<StaticResource x:Key="ToolTipBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="ToolTipBorderBrush" ResourceKey="OutlineVariantBrush" />
			<StaticResource x:Key="ToolTipForeground" ResourceKey="OnSurfaceBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<Thickness x:Key="CupertinoToolTipPadding">10,6</Thickness>
			<StaticResource x:Key="ToolTipBackground" ResourceKey="SurfaceBrush" />
			<StaticResource x:Key="ToolTipBorderBrush" ResourceKey="OutlineVariantBrush" />
			<StaticResource x:Key="ToolTipForeground" ResourceKey="OnSurfaceBrush" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<StaticResource x:Key="CupertinoToolTipCornerRadius" ResourceKey="Radius200CornerRadius" />
	<x:Double x:Key="CupertinoToolTipMaxWidth">320</x:Double>

	<Style x:Key="CupertinoToolTipStyle"
		   TargetType="ToolTip">
		<Setter Property="Background" Value="{ThemeResource ToolTipBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ToolTipBorderBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource ToolTipForeground}" />
		<Setter Property="BorderThickness" Value="{StaticResource CupertinoHairlineThickness}" />
		<Setter Property="Padding" Value="{ThemeResource CupertinoToolTipPadding}" />
		<Setter Property="CornerRadius" Value="{ThemeResource CupertinoToolTipCornerRadius}" />
		<Setter Property="MaxWidth" Value="{StaticResource CupertinoToolTipMaxWidth}" />
		<Setter Property="FontFamily" Value="{ThemeResource CaptionLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource CaptionLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource CaptionLargeFontWeight}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource CaptionLargeCharacterSpacing}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToolTip">
					<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}"
							Padding="{TemplateBinding Padding}">
						<ContentPresenter CharacterSpacing="{TemplateBinding CharacterSpacing}"
										  uc:CupertinoTypography.BindCharacterSpacing="True"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  TextWrapping="Wrap"
										  MaxWidth="{TemplateBinding MaxWidth}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
