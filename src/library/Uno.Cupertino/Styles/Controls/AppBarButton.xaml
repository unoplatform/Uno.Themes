<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style x:Key="CupertinoAppBarButtonStyle"
		   TargetType="AppBarButton">
		<!-- Override the stock 68 px width so overflow labels and shortcut columns can fit. -->
		<Setter Property="Width" Value="Auto" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<Setter Property="MinHeight" Value="{ThemeResource CupertinoRowMinHeight}" />
		<Setter Property="MinWidth" Value="{ThemeResource CupertinoRowMinHeight}" />
		<Setter Property="Padding" Value="{ThemeResource Space200Thickness}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource BodyLargeCharacterSpacing}" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="AppBarButton">
					<Grid x:Name="Root"
						  Background="{TemplateBinding Background}"
						  Padding="{TemplateBinding Padding}"
						  BorderBrush="{TemplateBinding BorderBrush}"
						  BorderThickness="{TemplateBinding BorderThickness}"
						  CornerRadius="{TemplateBinding CornerRadius}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="OverflowNormal" />
								<VisualState x:Name="OverflowPointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="{StaticResource CupertinoHoverOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="OverflowPressed">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="{StaticResource CupertinoButtonPressedOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="OverflowSubMenuOpened">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="{StaticResource CupertinoHoverOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="{StaticResource CupertinoHoverOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="{StaticResource CupertinoButtonPressedOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="{StaticResource CupertinoDisableStateOpacity}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="ApplicationViewStates">
								<VisualState x:Name="FullSize" />
								<VisualState x:Name="Compact">
									<VisualState.Setters>
										<Setter Target="TextLabel.Visibility" Value="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibleConverter}}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="LabelCollapsed">
									<VisualState.Setters>
										<Setter Target="TextLabel.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="LabelOnRight">
									<VisualState.Setters>
										<Setter Target="ContentViewbox.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="TextLabel.(Grid.Row)" Value="0" />
										<Setter Target="TextLabel.(Grid.Column)" Value="1" />
										<Setter Target="TextLabel.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="TextLabel.Margin" Value="4,0,0,0" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Overflow">
									<VisualState.Setters>
										<Setter Target="ContentViewbox.(Grid.Column)" Value="1" />
										<Setter Target="ContentViewbox.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="ContentViewbox.Margin" Value="10,0,0,0" />
										<Setter Target="TextLabel.(Grid.Row)" Value="0" />
										<Setter Target="TextLabel.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="TextLabel.Margin" Value="0" />
										<Setter Target="TextLabel.HorizontalAlignment" Value="Left" />
										<Setter Target="ContentRoot.HorizontalAlignment" Value="Stretch" />
										<Setter Target="Root.Padding" Value="{ThemeResource CupertinoMenuFlyoutItemPadding}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="OverflowWithToggleButtons">
									<VisualState.Setters>
										<Setter Target="ContentViewbox.(Grid.Column)" Value="1" />
										<Setter Target="ContentViewbox.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="ContentViewbox.Margin" Value="10,0,0,0" />
										<Setter Target="TextLabel.(Grid.Row)" Value="0" />
										<Setter Target="TextLabel.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="TextLabel.Margin" Value="0" />
										<Setter Target="TextLabel.HorizontalAlignment" Value="Left" />
										<Setter Target="ContentRoot.HorizontalAlignment" Value="Stretch" />
										<Setter Target="Root.Padding" Value="{ThemeResource CupertinoMenuFlyoutItemPadding}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="OverflowWithMenuIcons">
									<VisualState.Setters>
										<Setter Target="ContentViewbox.(Grid.Column)" Value="1" />
										<Setter Target="ContentViewbox.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="ContentViewbox.Margin" Value="10,0,0,0" />
										<Setter Target="TextLabel.(Grid.Row)" Value="0" />
										<Setter Target="TextLabel.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="TextLabel.Margin" Value="0" />
										<Setter Target="TextLabel.HorizontalAlignment" Value="Left" />
										<Setter Target="ContentRoot.HorizontalAlignment" Value="Stretch" />
										<Setter Target="Root.Padding" Value="{ThemeResource CupertinoMenuFlyoutItemPadding}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="OverflowWithToggleButtonsAndMenuIcons">
									<VisualState.Setters>
										<Setter Target="ContentViewbox.(Grid.Column)" Value="1" />
										<Setter Target="ContentViewbox.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="ContentViewbox.Margin" Value="10,0,0,0" />
										<Setter Target="TextLabel.(Grid.Row)" Value="0" />
										<Setter Target="TextLabel.(Grid.ColumnSpan)" Value="1" />
										<Setter Target="TextLabel.Margin" Value="0" />
										<Setter Target="TextLabel.HorizontalAlignment" Value="Left" />
										<Setter Target="ContentRoot.HorizontalAlignment" Value="Stretch" />
										<Setter Target="Root.Padding" Value="{ThemeResource CupertinoMenuFlyoutItemPadding}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="KeyboardAcceleratorTextVisibility">
								<VisualState x:Name="KeyboardAcceleratorTextCollapsed" />
								<VisualState x:Name="KeyboardAcceleratorTextVisible">
									<VisualState.Setters>
										<Setter Target="KeyboardAcceleratorTextLabel.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="FlyoutStates">
								<VisualState x:Name="NoFlyout" />
								<VisualState x:Name="HasFlyout">
									<VisualState.Setters>
										<Setter Target="SubItemChevron.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid x:Name="ContentRoot"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  RowSpacing="{ThemeResource Space100}">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Viewbox x:Name="ContentViewbox"
									 Grid.ColumnSpan="2"
									 Width="22"
									 Height="22"
									 HorizontalAlignment="Center"
									 VerticalAlignment="Center"
									 Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
								<ContentPresenter x:Name="Content"
												  Content="{TemplateBinding Icon}"
												  Foreground="{TemplateBinding Foreground}" />
							</Viewbox>
							<TextBlock CharacterSpacing="{TemplateBinding CharacterSpacing}"
									   x:Name="TextLabel"
									   Grid.Row="1"
									   Grid.ColumnSpan="2"
									   Text="{TemplateBinding Label}"
									   Foreground="{TemplateBinding Foreground}"
									   FontFamily="{TemplateBinding FontFamily}"
									   FontSize="{TemplateBinding FontSize}"
									   FontWeight="{TemplateBinding FontWeight}"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center" />
						</Grid>
						<!-- The stock control discovers the accelerator label by name and reserves a shared column width. -->
						<TextBlock CharacterSpacing="{TemplateBinding CharacterSpacing}"
								   x:Name="KeyboardAcceleratorTextLabel"
								   Grid.Column="1"
								   Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
								   MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KeyboardAcceleratorTextMinWidth}"
								   Margin="{ThemeResource Space400LeftThickness}"
								   Foreground="{TemplateBinding Foreground}"
								   FontFamily="{TemplateBinding FontFamily}"
								   FontSize="{TemplateBinding FontSize}"
								   HorizontalAlignment="Right"
								   VerticalAlignment="Center"
								   Visibility="Collapsed"
								   AutomationProperties.AccessibilityView="Raw" />
						<FontIcon x:Name="SubItemChevron"
								  Grid.Column="2"
								  Glyph="&#xE76C;"
								  FontFamily="{ThemeResource SymbolThemeFontFamily}"
								  FontSize="12"
								  Foreground="{TemplateBinding Foreground}"
								  Margin="{ThemeResource Space300LeftThickness}"
								  VerticalAlignment="Center"
								  MirroredWhenRightToLeft="True"
								  Visibility="Collapsed"
								  AutomationProperties.AccessibilityView="Raw" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
