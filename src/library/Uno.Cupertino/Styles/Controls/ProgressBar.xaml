<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

	<!--
		Apple's progress bar: a 4 px capsule track in the system fill, filled with the accent (HIG progress
		indicator artwork). The stock template reads its track height, radii and paused / error colours from
		these keys; without them the track is Fluent's 1 px hairline.
	-->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="ProgressBarForeground" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="ProgressBarBackground" ResourceKey="CupertinoSystemFillBrush" />
			<x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
			<x:Double x:Key="ProgressBarMinHeight">4</x:Double>
			<CornerRadius x:Key="ProgressBarTrackCornerRadius">2</CornerRadius>
			<CornerRadius x:Key="ProgressBarCornerRadius">2</CornerRadius>
			<StaticResource x:Key="ProgressBarPausedForegroundColor" ResourceKey="CupertinoYellowColor" />
			<StaticResource x:Key="ProgressBarErrorForegroundColor" ResourceKey="CupertinoRedColor" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="ProgressBarForeground" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="ProgressBarBackground" ResourceKey="CupertinoSystemFillBrush" />
			<x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
			<x:Double x:Key="ProgressBarMinHeight">4</x:Double>
			<CornerRadius x:Key="ProgressBarTrackCornerRadius">2</CornerRadius>
			<CornerRadius x:Key="ProgressBarCornerRadius">2</CornerRadius>
			<StaticResource x:Key="ProgressBarPausedForegroundColor" ResourceKey="CupertinoYellowColor" />
			<StaticResource x:Key="ProgressBarErrorForegroundColor" ResourceKey="CupertinoRedColor" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<x:Double x:Key="CupertinoProgressBarHeight">4</x:Double>
	<x:Double x:Key="CupertinoProgressBarMinWidth">250</x:Double>
	<StaticResource x:Key="CupertinoProgressBarCornerRadius" ResourceKey="Radius050CornerRadius" />

	<Style x:Key="CupertinoProgressBarStyle"
		   TargetType="muxc:ProgressBar">
		<Setter Property="Foreground" Value="{ThemeResource ProgressBarForeground}" />
		<Setter Property="Background" Value="{ThemeResource ProgressBarBackground}" />
		<Setter Property="Height" Value="{StaticResource CupertinoProgressBarHeight}" />
		<Setter Property="MinWidth" Value="{StaticResource CupertinoProgressBarMinWidth}" />
		<Setter Property="CornerRadius" Value="{ThemeResource CupertinoProgressBarCornerRadius}" />
	</Style>

</ResourceDictionary>
