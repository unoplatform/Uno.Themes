<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

	<!-- Apple's progress bar: a 4 px rounded track in the separator gray, filled with the accent. -->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="ProgressBarForeground" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="ProgressBarBackground" ResourceKey="OutlineVariantBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="ProgressBarForeground" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="ProgressBarBackground" ResourceKey="OutlineVariantBrush" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<x:Double x:Key="CupertinoProgressBarHeight">4</x:Double>
	<x:Double x:Key="CupertinoProgressBarMinWidth">250</x:Double>
	<StaticResource x:Key="CupertinoProgressBarCornerRadius" ResourceKey="Radius050CornerRadius" />

	<Style x:Key="CupertinoProgressBarStyle"
		   TargetType="muxc:ProgressBar">
		<Setter Property="Foreground" Value="{ThemeResource ProgressBarForeground}" />
		<Setter Property="Background" Value="{ThemeResource ProgressBarBackground}" />
		<Setter Property="Height" Value="{StaticResource CupertinoProgressBarHeight}" />
		<Setter Property="MinWidth" Value="{StaticResource CupertinoProgressBarMinWidth}" />
		<Setter Property="CornerRadius" Value="{ThemeResource CupertinoProgressBarCornerRadius}" />
	</Style>

</ResourceDictionary>
