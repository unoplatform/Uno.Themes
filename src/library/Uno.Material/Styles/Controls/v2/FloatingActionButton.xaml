<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:uno="using:Uno.UI.Xaml.Controls"
					xmlns:um="using:Uno.Material"
					xmlns:ut="using:Uno.Themes"
					mc:Ignorable="d">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<!--#region Default FAB Brushes-->
			<!--#endregion-->

			<!--#region Surface FAB Brushes-->
			<!--#endregion-->

			<!--#region Secondary FAB Brushes-->
			<!--#endregion-->

			<!--#region Tertiary FAB Brushes-->
			<!--#endregion-->

			<!--#region Default FAB Resources-->
			<Thickness x:Key="MaterialFabPadding">20</Thickness>
			<StaticResource x:Key="MaterialFabContentWidthOrHeight" ResourceKey="IconSizeSmall" />
			<StaticResource x:Key="MaterialFabCornerRadius" ResourceKey="Radius400CornerRadius" />
			<!--#endregion-->

			<!--#region Small FAB Resources-->
			<Thickness x:Key="MaterialSmallFabPadding">12</Thickness>
			<StaticResource x:Key="MaterialSmallFabContentWidthOrHeight" ResourceKey="IconSizeSmall" />
			<StaticResource x:Key="MaterialSmallFabCornerRadius" ResourceKey="Radius300CornerRadius" />
			<!--#endregion-->

			<!--#region Large FAB Resources-->
			<Thickness x:Key="MaterialLargeFabPadding">36</Thickness>
			<StaticResource x:Key="MaterialLargeFabContentWidthOrHeight" ResourceKey="IconSizeMedium" />
			<StaticResource x:Key="MaterialLargeFabCornerRadius" ResourceKey="Radius700CornerRadius" />
			<!--#endregion-->

			<StaticResource x:Key="MaterialFabIconTextPadding" ResourceKey="Space150" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="Light">
			<!--#region Default FAB Brushes-->
			<!--#endregion-->

			<!--#region Surface FAB Brushes-->
			<!--#endregion-->

			<!--#region Secondary FAB Brushes-->
			<!--#endregion-->

			<!--#region Tertiary FAB Brushes-->
			<!--#endregion-->

			<!--#region Default FAB Resources-->
			<Thickness x:Key="MaterialFabPadding">20</Thickness>
			<StaticResource x:Key="MaterialFabContentWidthOrHeight" ResourceKey="IconSizeSmall" />
