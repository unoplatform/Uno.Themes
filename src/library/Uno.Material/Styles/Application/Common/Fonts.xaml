<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<!-- Root typeface token (cascades to all type scales; weights resolve via the Roboto.ttf variable font or its font manifest on static-font platforms) -->
			<FontFamily x:Key="DefaultFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto.ttf#Roboto</FontFamily>

			<!-- Legacy Material-specific font family keys -->
			<FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Light.ttf#Roboto</FontFamily>
			<FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Medium.ttf#Roboto</FontFamily>
			<FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<!-- Root typeface token (cascades to all type scales; weights resolve via the Roboto.ttf variable font or its font manifest on static-font platforms) -->
			<FontFamily x:Key="DefaultFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto.ttf#Roboto</FontFamily>

			<!-- Legacy Material-specific font family keys -->
			<FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Light.ttf#Roboto</FontFamily>
			<FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Medium.ttf#Roboto</FontFamily>
			<FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>
		</ResourceDictionary>
		<ResourceDictionary x:Key="HighContrast">
			<!-- Root typeface token (cascades to all type scales; weights resolve via the Roboto.ttf variable font or its font manifest on static-font platforms) -->
			<FontFamily x:Key="DefaultFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto.ttf#Roboto</FontFamily>

			<!-- Legacy Material-specific font family keys -->
			<FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Light.ttf#Roboto</FontFamily>
			<FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Medium.ttf#Roboto</FontFamily>
			<FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
