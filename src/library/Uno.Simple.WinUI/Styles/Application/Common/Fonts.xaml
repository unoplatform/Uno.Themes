<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Simple Design System — Typography Tokens

		A single root typeface (Inter) drives every type scale. Per-scale weight
		nuance (Bold display, SemiBold titles, …) is expressed through the
		*FontWeight tokens in Typography.xaml; the weights are resolved from this
		single FontFamily reference via the Inter.ttf variable font (or its font
		manifest on platforms without variable-font support).
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- ─── Light Theme ─── -->
		<ResourceDictionary x:Key="Light">
			<!-- Root typeface token (cascades to all type scales) -->
			<FontFamily x:Key="DefaultFontFamily">ms-appx:///Uno.Fonts.Inter/Fonts/Inter.ttf#Inter</FontFamily>
		</ResourceDictionary>

		<!-- ─── Dark Theme (Default) ─── -->
		<ResourceDictionary x:Key="Default">
			<!-- Root typeface token (cascades to all type scales) -->
			<FontFamily x:Key="DefaultFontFamily">ms-appx:///Uno.Fonts.Inter/Fonts/Inter.ttf#Inter</FontFamily>
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
