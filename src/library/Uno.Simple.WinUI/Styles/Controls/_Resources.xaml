<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
					mc:Ignorable="d">

	<!-- Implicit styles -->
	<Style BasedOn="{StaticResource SimpleFilledButtonStyle}"
		   TargetType="Button" />
	<Style BasedOn="{StaticResource SimpleCheckBoxStyle}"
		   TargetType="CheckBox" />
	<Style BasedOn="{StaticResource SimpleComboBoxStyle}"
		   TargetType="ComboBox" />
	<Style BasedOn="{StaticResource SimpleRadioButtonStyle}"
		   TargetType="RadioButton" />
	<Style BasedOn="{StaticResource SimpleOutlinedTextBoxStyle}"
		   TargetType="TextBox" />
	<Style BasedOn="{StaticResource SimpleToggleSwitchStyle}"
		   TargetType="ToggleSwitch" />
	<Style BasedOn="{StaticResource SimpleOutlinedPasswordBoxStyle}"
		   TargetType="PasswordBox" />
	<Style BasedOn="{StaticResource SimpleSliderStyle}"
		   TargetType="Slider" />
	<Style BasedOn="{StaticResource SimpleToolTipStyle}"
		   TargetType="ToolTip" />
	<Style BasedOn="{StaticResource SimpleBaseTextBlockStyle}"
		   TargetType="TextBlock" />

	<!-- ListView + ListViewItem -->
	<Style BasedOn="{StaticResource SimpleDefaultListViewItemStyle}"
		   TargetType="ListViewItem" />
	<Style BasedOn="{StaticResource SimpleDefaultListViewStyle}"
		   TargetType="ListView" />

	<!-- ContentDialog -->
	<Style BasedOn="{StaticResource SimpleDefaultContentDialogStyle}"
		   TargetType="ContentDialog" />

	<!-- MenuFlyout items -->
	<Style BasedOn="{StaticResource SimpleDefaultMenuFlyoutItemStyle}"
		   TargetType="MenuFlyoutItem" />
	<Style BasedOn="{StaticResource SimpleDefaultMenuFlyoutPresenterStyle}"
		   TargetType="MenuFlyoutPresenter" />
	<Style BasedOn="{StaticResource SimpleDefaultMenuFlyoutSeparatorStyle}"
		   TargetType="MenuFlyoutSeparator" />
	<Style BasedOn="{StaticResource SimpleDefaultMenuFlyoutSubItemStyle}"
		   TargetType="MenuFlyoutSubItem" />
	<Style BasedOn="{StaticResource SimpleDefaultToggleMenuFlyoutItemStyle}"
		   TargetType="ToggleMenuFlyoutItem" />

	<!-- CalendarView -->
	<Style BasedOn="{StaticResource SimpleDefaultCalendarViewStyle}"
		   TargetType="CalendarView" />

	<!-- AppBarButton -->
	<Style BasedOn="{StaticResource SimpleDefaultAppBarButtonStyle}"
		   TargetType="AppBarButton" />

	<!-- CalendarDatePicker -->
	<Style BasedOn="{StaticResource SimpleDefaultCalendarDatePickerStyle}"
		   TargetType="CalendarDatePicker" />

	<!-- DatePicker -->
	<Style BasedOn="{StaticResource SimpleDefaultDatePickerStyle}"
		   TargetType="DatePicker" />
	<Style BasedOn="{StaticResource SimpleDefaultDatePickerFlyoutPresenterStyle}"
		   TargetType="DatePickerFlyoutPresenter" />

	<!-- AutoSuggestBox -->
	<Style BasedOn="{StaticResource SimpleDefaultAutoSuggestBoxStyle}"
		   TargetType="AutoSuggestBox" />

	<!-- Expander -->
	<Style BasedOn="{StaticResource SimpleDefaultExpanderStyle}"
		   TargetType="Expander" />

	<!-- ToggleButton -->
	<Style BasedOn="{StaticResource SimpleDefaultToggleButtonStyle}"
		   TargetType="ToggleButton" />

	<!-- FlyoutPresenter -->
	<Style BasedOn="{StaticResource SimpleDefaultFlyoutPresenterStyle}"
		   TargetType="FlyoutPresenter" />

	<!-- HyperlinkButton -->
	<Style BasedOn="{StaticResource SimpleDefaultHyperlinkButtonStyle}"
		   TargetType="HyperlinkButton" />

	<!-- NavigationView -->
	<Style BasedOn="{StaticResource SimpleDefaultNavigationViewStyle}"
		   TargetType="muxc:NavigationView" />
	<Style BasedOn="{StaticResource SimpleDefaultNavigationViewItemStyle}"
		   TargetType="muxc:NavigationViewItem" />

	<!-- PipsPager -->
	<Style BasedOn="{StaticResource SimpleDefaultPipsPagerStyle}"
		   TargetType="muxc:PipsPager" />

	<!-- ProgressBar / ProgressRing -->
	<Style BasedOn="{StaticResource SimpleDefaultProgressBarStyle}"
		   TargetType="muxc:ProgressBar" />
	<Style BasedOn="{StaticResource SimpleDefaultProgressRingStyle}"
		   TargetType="muxc:ProgressRing" />

	<!-- RadioMenuFlyoutItem -->
	<Style BasedOn="{StaticResource SimpleDefaultRadioMenuFlyoutItemStyle}"
		   TargetType="muxc:RadioMenuFlyoutItem" />

	<!-- RatingControl -->
	<Style BasedOn="{StaticResource SimpleDefaultRatingControlStyle}"
		   TargetType="RatingControl" />

	<!-- TODO: Add implicit styles once these controls have Simple styles implemented
	<Style BasedOn="{StaticResource SimpleDefaultCommandBarStyle}" TargetType="CommandBar" />
	<Style BasedOn="{StaticResource SimpleDefaultMediaTransportControlsStyle}" TargetType="MediaTransportControls" />
	-->

</ResourceDictionary>
