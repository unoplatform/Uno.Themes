<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:input="using:Uno.Extras.Input"
					xmlns:not_win="http://uno.ui/not_win"
					mc:Ignorable="not_win">

	<!--
		Simple Design System — AutoSuggestBox (Search) Styles
		Maps SDS Search component tokens to WinUI AutoSuggestBox.
		
		SDS Search: pill-shaped input (radius-full) with search/clear icon,
		inherits Input base tokens (background-default-default, border-default-default, etc.)
		Popup: ListBox of suggestion items
		States: Normal, PointerOver, Focused (brand-secondary border), Disabled
		
		SDS source: Search/Search.tsx + search.css, Input/input.css
	-->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Lightweight styling ThemeResource aliases -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<ResourceDictionary.ThemeDictionaries>

		<!-- ─── Light Theme ─── -->
		<ResourceDictionary x:Key="Light">
			<!-- Sizing -->
			<CornerRadius x:Key="SimpleAutoSuggestBoxCornerRadius">20</CornerRadius>
			<Thickness x:Key="SimpleAutoSuggestBoxPadding">16,10,40,10</Thickness>

			<StaticResource x:Key="SimpleAutoSuggestBoxBorderThickness" ResourceKey="SimpleStrokeBorderThickness" />
			<!-- sds-size-stroke-border -->
			<StaticResource x:Key="SimpleAutoSuggestBoxFocusedBorderThickness" ResourceKey="SimpleStrokeFocusRingThickness" />
			<!-- sds-size-stroke-focus-ring -->
			<StaticResource x:Key="SimpleAutoSuggestBoxMinHeight" ResourceKey="SimpleIconLarge" />
			<!-- sds-size-icon-large -->
			<StaticResource x:Key="SimpleAutoSuggestBoxIconFontSize" ResourceKey="BodyLargeFontSize" />
			<StaticResource x:Key="SimpleAutoSuggestBoxSuggestionsCornerRadius" ResourceKey="SimpleRadius200CornerRadius" />
			<!-- sds-size-radius-200 -->
			<StaticResource x:Key="SimpleAutoSuggestBoxSuggestionsBorderThickness" ResourceKey="SimpleStrokeBorderThickness" />
			<!-- sds-size-stroke-border -->
			<StaticResource x:Key="SimpleAutoSuggestBoxSuggestionsPadding" ResourceKey="SimpleSpace100Thickness" />
			<!-- sds-size-space-100 -->
		</ResourceDictionary>

		<!-- ─── Dark Theme (Default) ─── -->
		<ResourceDictionary x:Key="Default">
			<CornerRadius x:Key="SimpleAutoSuggestBoxCornerRadius">20</CornerRadius>
			<Thickness x:Key="SimpleAutoSuggestBoxPadding">16,10,40,10</Thickness>


			<StaticResource x:Key="SimpleAutoSuggestBoxBorderThickness" ResourceKey="SimpleStrokeBorderThickness" />
			<!-- sds-size-stroke-border -->
			<StaticResource x:Key="SimpleAutoSuggestBoxFocusedBorderThickness" ResourceKey="SimpleStrokeFocusRingThickness" />
			<!-- sds-size-stroke-focus-ring -->
			<StaticResource x:Key="SimpleAutoSuggestBoxMinHeight" ResourceKey="SimpleIconLarge" />
			<!-- sds-size-icon-large -->
			<StaticResource x:Key="SimpleAutoSuggestBoxIconFontSize" ResourceKey="BodyLargeFontSize" />
			<StaticResource x:Key="SimpleAutoSuggestBoxSuggestionsCornerRadius" ResourceKey="SimpleRadius200CornerRadius" />
			<!-- sds-size-radius-200 -->
			<StaticResource x:Key="SimpleAutoSuggestBoxSuggestionsBorderThickness" ResourceKey="SimpleStrokeBorderThickness" />
			<!-- sds-size-stroke-border -->
			<StaticResource x:Key="SimpleAutoSuggestBoxSuggestionsPadding" ResourceKey="SimpleSpace100Thickness" />
			<!-- sds-size-space-100 -->
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Inner TextBox style (pill-shaped, search icon area) -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<Style x:Key="SimpleAutoSuggestBoxTextBoxStyle"
		   TargetType="TextBox">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="{ThemeResource SimpleAutoSuggestBoxMinHeight}" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource SimpleStrokeBorderThickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource SimpleAutoSuggestBoxCornerRadius}" />
		<Setter Property="Padding" Value="{ThemeResource SimpleAutoSuggestBoxPadding}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
		<Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
		<Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
		<Setter Property="FocusVisualMargin" Value="-3" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Grid>
						<Grid.Resources>
							<!-- Delete (clear) button — shown when text is entered -->
							<Style x:Name="DeleteButtonStyle"
								   TargetType="Button">
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="Button">
											<Border x:Name="ButtonLayoutGrid"
													Background="Transparent"
													BorderThickness="0"
													CornerRadius="{ThemeResource SimpleAutoSuggestBoxCornerRadius}">
												<VisualStateManager.VisualStateGroups>
													<VisualStateGroup x:Name="CommonStates">
														<VisualState x:Name="Normal" />
														<VisualState x:Name="PointerOver">
															<VisualState.Setters>
																<Setter Target="GlyphElement.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
															</VisualState.Setters>
														</VisualState>
														<VisualState x:Name="Pressed">
															<VisualState.Setters>
																<Setter Target="GlyphElement.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
															</VisualState.Setters>
														</VisualState>
														<VisualState x:Name="Disabled">
															<Storyboard>
																<DoubleAnimation Storyboard.TargetName="ButtonLayoutGrid"
																				 Storyboard.TargetProperty="Opacity"
																				 To="0"
																				 Duration="0" />
															</Storyboard>
														</VisualState>
													</VisualStateGroup>
												</VisualStateManager.VisualStateGroups>
												<TextBlock x:Name="GlyphElement"
														   Foreground="{ThemeResource OnSurfaceBrush}"
														   VerticalAlignment="Center"
														   HorizontalAlignment="Center"
														   FontStyle="Normal"
														   FontSize="{ThemeResource BodyLargeFontSize}"
														   Text="&#xE894;"
														   FontFamily="{ThemeResource SymbolThemeFontFamily}"
														   AutomationProperties.AccessibilityView="Raw" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>

							<!-- Query (search) button — shows search icon -->
							<Style x:Name="QueryButtonStyle"
								   TargetType="Button">
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="Button">
											<ContentPresenter x:Name="ContentPresenter"
															  Background="Transparent"
															  BorderThickness="0"
															  Content="{TemplateBinding Content}"
															  ContentTemplate="{TemplateBinding ContentTemplate}"
															  ContentTransitions="{TemplateBinding ContentTransitions}"
															  FontSize="{ThemeResource BodyLargeFontSize}"
															  Padding="{TemplateBinding Padding}"
															  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
															  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
															  AutomationProperties.AccessibilityView="Raw">
												<VisualStateManager.VisualStateGroups>
													<VisualStateGroup x:Name="CommonStates">
														<VisualState x:Name="Normal" />
														<VisualState x:Name="PointerOver">
															<VisualState.Setters>
																<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
															</VisualState.Setters>
														</VisualState>
														<VisualState x:Name="Pressed">
															<VisualState.Setters>
																<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
															</VisualState.Setters>
														</VisualState>
														<VisualState x:Name="Disabled">
															<Storyboard>
																<DoubleAnimation Storyboard.TargetName="ContentPresenter"
																				 Storyboard.TargetProperty="Opacity"
																				 To="0"
																				 Duration="0" />
															</Storyboard>
														</VisualState>
													</VisualStateGroup>
												</VisualStateManager.VisualStateGroups>
											</ContentPresenter>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</Grid.Resources>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="BorderElement.Background" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="BorderStrokeElement.BorderBrush" Value="{ThemeResource OutlineDisabledBrush}" />
										<Setter Target="ContentElement.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="PlaceholderTextContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="BorderStrokeElement.BorderBrush" Value="{ThemeResource OutlineBrush}" />
										<Setter Target="BorderElement.Background" Value="{ThemeResource SurfaceBrush}" />
										<Setter Target="PlaceholderTextContentPresenter.Foreground" Value="{ThemeResource OnSurfaceLowBrush}" />
										<Setter Target="ContentElement.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="PlaceholderTextContentPresenter.Foreground" Value="{ThemeResource OnSurfaceLowBrush}" />
										<Setter Target="BorderElement.Background" Value="{ThemeResource SurfaceBrush}" />
										<Setter Target="BorderStrokeElement.BorderBrush" Value="{ThemeResource PrimaryMediumBrush}" />
										<Setter Target="BorderStrokeElement.BorderThickness" Value="{ThemeResource SimpleStrokeFocusRingThickness}" />
										<Setter Target="ContentElement.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
										<Setter Target="QueryButton.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ButtonStates">
								<VisualState x:Name="ButtonVisible">
									<VisualState.Setters>
										<Setter Target="DeleteButton.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="ButtonCollapsed" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="4" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!--
							Background (pill-shaped). Fill only: the stroke is BorderStrokeElement below, so it can be
							hidden on its own. Keeps the BorderElement name, which TextBox looks up for the fill.
						-->
						<Border x:Name="BorderElement"
								Grid.Row="1"
								Grid.ColumnSpan="4"
								Background="{TemplateBinding Background}"
								CornerRadius="{TemplateBinding CornerRadius}" />

						<!--
							Input validation (Uno). The outer AutoSuggestBox template cannot reach this namescope, so
							while in error it sets this TextBox's Tag: the tint shows and the stroke hides, replaced
							by the outer template's error ring. Visibility is written by no state here, so hover and
							focus cannot bring the stroke back.
						-->
						<Border x:Name="ErrorBackgroundElement"
								Grid.Row="1"
								Grid.ColumnSpan="4"
								Background="{ThemeResource ErrorBrush}"
								Opacity="0.12"
								CornerRadius="{TemplateBinding CornerRadius}"
								IsHitTestVisible="False"
								Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />

						<Border x:Name="BorderStrokeElement"
								Grid.Row="1"
								Grid.ColumnSpan="4"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{TemplateBinding CornerRadius}"
								Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibleConverter}}" />

						<!-- Header -->
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Grid.ColumnSpan="4"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  FontFamily="{ThemeResource BodyMediumFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="SemiBold"
										  Foreground="{ThemeResource OnSurfaceBrush}"
										  Margin="0,0,0,4"
										  TextWrapping="Wrap"
										  Visibility="Collapsed"
										  x:DeferLoadStrategy="Lazy" />

						<!-- Text input (scrollviewer) -->
						<ScrollViewer x:Name="ContentElement"
									  Grid.Row="1"
									  HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
									  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
									  VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
									  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
									  IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
									  IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
									  IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
									  Margin="{TemplateBinding BorderThickness}"
									  Padding="{TemplateBinding Padding}"
									  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									  IsTabStop="False"
									  AutomationProperties.AccessibilityView="Raw"
									  ZoomMode="Disabled" />

						<!-- Placeholder text -->
						<ContentControl x:Name="PlaceholderTextContentPresenter"
										Grid.Row="1"
										Grid.ColumnSpan="2"
										Foreground="{ThemeResource OnSurfaceLowBrush}"
										Margin="{TemplateBinding BorderThickness}"
										Padding="{TemplateBinding Padding}"
										IsTabStop="False"
										Content="{TemplateBinding PlaceholderText}"
										IsHitTestVisible="False"
										VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
										HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />

						<!-- Delete (clear) button -->
						<Button x:Name="DeleteButton"
								Grid.Row="1"
								Grid.Column="1"
								Style="{StaticResource DeleteButtonStyle}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Padding="{ThemeResource SimpleSpace100Thickness}"
								IsTabStop="False"
								Visibility="Collapsed"
								FontSize="{TemplateBinding FontSize}"
								Width="{ThemeResource SimpleIconMedium}"
								VerticalAlignment="Stretch"
								AutomationProperties.AccessibilityView="Raw" />

						<!-- Query (search icon) button -->
						<Button x:Name="QueryButton"
								Grid.Row="1"
								Grid.Column="2"
								Style="{StaticResource QueryButtonStyle}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Margin="2,0,0,0"
								Padding="{ThemeResource SimpleSpace100Thickness}"
								IsTabStop="False"
								FontSize="{TemplateBinding FontSize}"
								Width="{ThemeResource SimpleIconMedium}"
								Height="28"
								VerticalAlignment="Stretch"
								AutomationProperties.AccessibilityView="Raw" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- AutoSuggestBox outer style -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<Style x:Key="SimpleAutoSuggestBoxStyle"
		   TargetType="AutoSuggestBox">
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource SimpleStrokeBorderThickness}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="TextBoxStyle" Value="{StaticResource SimpleAutoSuggestBoxTextBoxStyle}" />
		<Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
		<Setter Property="CornerRadius" Value="{ThemeResource SimpleAutoSuggestBoxCornerRadius}" />
		<not_win:Setter Property="input:Validation.ErrorTemplate"
						Value="{StaticResource SimpleInputValidationErrorTemplate}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="AutoSuggestBox">
					<Grid x:Name="LayoutRoot">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="Orientation">
								<VisualState x:Name="Landscape" />
								<VisualState x:Name="Portrait" />
							</VisualStateGroup>

							<!--
								Input validation (Uno). The field is drawn by the inner TextBox's template, out of reach
								of setters here: the error states set its Tag instead, which hides its stroke and shows
								its tint (see SimpleAutoSuggestBoxTextBoxStyle), and show ErrorBorderElement over it.
							-->
							<VisualStateGroup x:Name="InputValidationEnabledStates">
								<VisualState x:Name="CompactValidationEnabled" />

								<VisualState x:Name="InlineValidationEnabled">
									<VisualState.Setters>
										<!-- Reserves the inline row up front, so the form does not jump on the first error. -->
										<Setter Target="ErrorPresenterRow.MinHeight" Value="20" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="ValidationDisabled" />
							</VisualStateGroup>

							<VisualStateGroup x:Name="InputValidationErrorStates">
								<VisualState x:Name="CompactErrors">
									<VisualState.Setters>
										<!-- Fits DefaultCompactErrorIconTemplate: a 24px icon with a 3px margin. -->
										<Setter Target="ErrorIconColumn.MaxWidth" Value="28" />
										<Setter Target="ErrorPresenter.Visibility" Value="Visible" />
										<Setter Target="ErrorBorderElement.Visibility" Value="Visible" />
										<Setter Target="TextBox.Tag" Value="Error" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="InlineErrors">
									<VisualState.Setters>
										<Setter Target="ErrorPresenter.(Grid.Row)" Value="2" />
										<Setter Target="ErrorPresenter.(Grid.Column)" Value="0" />
										<Setter Target="ErrorPresenter.(Grid.ColumnSpan)" Value="2" />
										<Setter Target="ErrorPresenter.Visibility" Value="Visible" />
										<Setter Target="ErrorBorderElement.Visibility" Value="Visible" />
										<Setter Target="TextBox.Tag" Value="Error" />
									</VisualState.Setters>
								</VisualState>

								<!-- Empty: leaving an error state reverts its setters (Tag back to null). -->
								<VisualState x:Name="ErrorsCleared" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!--
							The TextBox spans the first two rows; HeaderSpacer sizes the first to the TextBox's header,
							leaving the second exactly the field, which the error ring and icon line up with.
							ErrorIconColumn and ErrorPresenterRow stay at zero size until a validation state opens them.
						-->
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition x:Name="ErrorIconColumn"
											  MaxWidth="0" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition x:Name="ErrorPresenterRow"
										   Height="Auto"
										   MinHeight="0" />
						</Grid.RowDefinitions>

						<!--
							Invisible stand-in for the inner TextBox's header, laid out like HeaderContentPresenter in
							SimpleAutoSuggestBoxTextBoxStyle and shown under the same rule (a non-null Header).
						-->
						<ContentPresenter x:Name="HeaderSpacer"
										  Grid.Row="0"
										  Grid.Column="0"
										  Content="{TemplateBinding Header}"
										  FontFamily="{ThemeResource BodyMediumFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="SemiBold"
										  Margin="0,0,0,4"
										  TextWrapping="Wrap"
										  Opacity="0"
										  IsHitTestVisible="False"
										  Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}"
										  AutomationProperties.AccessibilityView="Raw" />

						<TextBox x:Name="TextBox"
								 Grid.RowSpan="2"
								 Style="{TemplateBinding TextBoxStyle}"
								 PlaceholderText="{TemplateBinding PlaceholderText}"
								 Header="{TemplateBinding Header}"
								 Width="{TemplateBinding Width}"
								 Description="{TemplateBinding Description}"
								 Foreground="{TemplateBinding Foreground}"
								 Background="{TemplateBinding Background}"
								 BorderBrush="{TemplateBinding BorderBrush}"
								 BorderThickness="{TemplateBinding BorderThickness}"
								 FontSize="{TemplateBinding FontSize}"
								 FontFamily="{TemplateBinding FontFamily}"
								 FontWeight="{TemplateBinding FontWeight}"
								 FontStretch="{TemplateBinding FontStretch}"
								 VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
								 HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								 ScrollViewer.BringIntoViewOnFocusChange="False"
								 Canvas.ZIndex="0"
								 Margin="0"
								 DesiredCandidateWindowAlignment="BottomEdge"
								 UseSystemFocusVisuals="{TemplateBinding UseSystemFocusVisuals}"
								 CornerRadius="{TemplateBinding CornerRadius}" />

						<!-- Error ring over the field, drawn while the inner stroke is hidden. Width mirrors the TextBox's. -->
						<Border x:Name="ErrorBorderElement"
								Grid.Row="1"
								Grid.Column="0"
								Width="{TemplateBinding Width}"
								BorderBrush="{ThemeResource ErrorBrush}"
								BorderThickness="{ThemeResource SimpleAutoSuggestBoxFocusedBorderThickness}"
								CornerRadius="{TemplateBinding CornerRadius}"
								IsHitTestVisible="False"
								Visibility="Collapsed" />

						<Popup x:Name="SuggestionsPopup"
							   ShouldConstrainToRootBounds="False">
							<Border x:Name="SuggestionsContainer"
									Padding="{ThemeResource SimpleSpace100Thickness}"
									BorderThickness="{ThemeResource SimpleStrokeBorderThickness}"
									BorderBrush="{ThemeResource OutlineBrush}"
									Background="{ThemeResource SurfaceBrush}"
									CornerRadius="{ThemeResource SimpleRadius200CornerRadius}">
								<ListView x:Name="SuggestionsList"
										  DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
										  IsItemClickEnabled="True"
										  ItemTemplate="{TemplateBinding ItemTemplate}"
										  ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
										  ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
										  MaxHeight="{ThemeResource AutoSuggestListMaxHeight}"
										  Margin="{ThemeResource AutoSuggestListPadding}">
									<ListView.ItemContainerTransitions />
								</ListView>
							</Border>
						</Popup>

						<!--
							Filled by the framework: the error list (Inline) or the compact icon (Compact). Collapsed is
							load-bearing: once realized the part stays realized, and only the error states show it.
						-->
						<ContentPresenter x:Name="ErrorPresenter"
										  x:Load="False"
										  Grid.Row="1"
										  Grid.Column="1"
										  Visibility="Collapsed"
										  VerticalAlignment="Center"
										  Foreground="{ThemeResource ErrorBrush}"
										  AutomationProperties.AccessibilityView="Raw" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Default alias -->
	<Style x:Key="SimpleDefaultAutoSuggestBoxStyle"
		   TargetType="AutoSuggestBox"
		   BasedOn="{StaticResource SimpleAutoSuggestBoxStyle}" />

</ResourceDictionary>
