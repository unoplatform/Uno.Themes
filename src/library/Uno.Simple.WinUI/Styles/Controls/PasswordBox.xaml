<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:input="using:Uno.Extras.Input"
					xmlns:not_win="http://uno.ui/not_win"
					mc:Ignorable="not_win">

	<!--
		Simple Design System — PasswordBox Styles
		Maps SDS Input component tokens to WinUI PasswordBox.
		Same visual treatment as TextBox (SDS Input outlined style).
		
		Two visual variants:
		Filled   — background fill + border (SDS Input)
		Outlined — surface background (SurfaceBrush), visible border only (default)
		
		Resource layers:
		FilledPasswordBox*   = semantic keys (source of truth, filled variant)
		OutlinedPasswordBox* = semantic keys (source of truth, outlined variant)
		SimplePasswordBox*   = Simple-prefixed aliases for backwards compat
	-->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Lightweight styling ThemeResource aliases -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Filled PasswordBox (FilledPasswordBox* semantic keys) -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<Style x:Key="SimpleFilledPasswordBoxStyle"
		   TargetType="PasswordBox">
		<Setter Property="Foreground" Value="{ThemeResource FilledPasswordBoxForeground}" />
		<Setter Property="Background" Value="{ThemeResource FilledPasswordBoxBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource FilledPasswordBoxBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource FilledPasswordBoxBorderThickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource FilledPasswordBoxCornerRadius}" />
		<Setter Property="Padding" Value="{ThemeResource FilledPasswordBoxPadding}" />
		<Setter Property="MinHeight" Value="{ThemeResource FilledPasswordBoxMinHeight}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
		<Setter Property="FocusVisualMargin" Value="-3" />
		<not_win:Setter Property="input:Validation.ErrorTemplate"
						Value="{StaticResource SimpleInputValidationErrorTemplate}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="PasswordBox">
					<Grid>
						<!-- ErrorIconColumn and ErrorPresenterRow stay at zero size until a validation state opens them. -->
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition x:Name="ErrorIconColumn"
											  MaxWidth="0" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition x:Name="ErrorPresenterRow"
										   Height="Auto"
										   MinHeight="0" />
						</Grid.RowDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="BackgroundElement.Background" Value="{ThemeResource FilledPasswordBoxBackgroundPointerOver}" />
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource FilledPasswordBoxBorderBrushPointerOver}" />
										<Setter Target="ContentElement.Foreground" Value="{ThemeResource FilledPasswordBoxForegroundPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="BackgroundElement.Background" Value="{ThemeResource FilledPasswordBoxBackgroundFocused}" />
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource FilledPasswordBoxBorderBrushFocused}" />
										<Setter Target="BorderElement.BorderThickness" Value="{ThemeResource FilledPasswordBoxFocusedBorderThickness}" />
										<Setter Target="ContentElement.Foreground" Value="{ThemeResource FilledPasswordBoxForegroundFocused}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="BackgroundElement.Background" Value="{ThemeResource FilledPasswordBoxBackgroundDisabled}" />
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource FilledPasswordBoxBorderBrushDisabled}" />
										<Setter Target="ContentElement.Foreground" Value="{ThemeResource FilledPasswordBoxForegroundDisabled}" />
										<Setter Target="PlaceholderElement.Foreground" Value="{ThemeResource FilledPasswordBoxPlaceholderForegroundDisabled}" />
										<Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource FilledPasswordBoxHeaderForegroundDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ButtonStates">
								<VisualState x:Name="ButtonVisible">
									<VisualState.Setters>
										<Setter Target="RevealButton.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="ButtonCollapsed" />
							</VisualStateGroup>

							<!--
								Input validation (Uno). The error states only write parts no other group writes: VisualState
								setters share one slot per property, so an error brush set on BorderElement would be
								overwritten by CommonStates and then cleared when it leaves its state.
							-->
							<VisualStateGroup x:Name="InputValidationEnabledStates">
								<VisualState x:Name="CompactValidationEnabled" />

								<VisualState x:Name="InlineValidationEnabled">
									<VisualState.Setters>
										<!-- Reserves the inline row up front, so the form does not jump on the first error. -->
										<Setter Target="ErrorPresenterRow.MinHeight" Value="20" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="ValidationDisabled" />
							</VisualStateGroup>

							<VisualStateGroup x:Name="InputValidationErrorStates">
								<VisualState x:Name="CompactErrors">
									<VisualState.Setters>
										<!-- Fits DefaultCompactErrorIconTemplate: a 24px icon with a 3px margin. -->
										<Setter Target="ErrorIconColumn.MaxWidth" Value="28" />
										<Setter Target="ErrorPresenter.Visibility" Value="Visible" />
										<Setter Target="ErrorBorderElement.Visibility" Value="Visible" />
										<Setter Target="ErrorBackgroundElement.Visibility" Value="Visible" />
										<Setter Target="BorderElement.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="InlineErrors">
									<VisualState.Setters>
										<Setter Target="ErrorPresenter.(Grid.Row)" Value="2" />
										<Setter Target="ErrorPresenter.(Grid.Column)" Value="0" />
										<Setter Target="ErrorPresenter.(Grid.ColumnSpan)" Value="2" />
										<Setter Target="ErrorPresenter.Visibility" Value="Visible" />
										<Setter Target="ErrorBorderElement.Visibility" Value="Visible" />
										<Setter Target="ErrorBackgroundElement.Visibility" Value="Visible" />
										<Setter Target="BorderElement.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>

								<!-- Empty: leaving an error state reverts its setters to the parts' local values. -->
								<VisualState x:Name="ErrorsCleared" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- Header -->
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  FontFamily="{ThemeResource BodyLargeFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="SemiBold"
										  Foreground="{ThemeResource FilledPasswordBoxHeaderForeground}"
										  Margin="{ThemeResource FilledPasswordBoxHeaderMargin}"
										  TextWrapping="Wrap"
										  Visibility="Collapsed"
										  x:DeferLoadStrategy="Lazy" />

						<!-- Input field -->
						<Grid Grid.Row="1"
							  MinHeight="{TemplateBinding MinHeight}">

							<!-- Background fill -->
							<Border x:Name="BackgroundElement"
									Background="{TemplateBinding Background}"
									CornerRadius="{TemplateBinding CornerRadius}" />

							<!-- Error tint: ErrorBrush at 12%, over the fill and under the content so the text stays legible. -->
							<Border x:Name="ErrorBackgroundElement"
									Background="{ThemeResource ErrorBrush}"
									Opacity="0.12"
									CornerRadius="{TemplateBinding CornerRadius}"
									IsHitTestVisible="False"
									Visibility="Collapsed" />

							<!-- Content -->
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<Grid Grid.Column="0">
									<ContentControl x:Name="PlaceholderElement"
													Content="{TemplateBinding PlaceholderText}"
													Foreground="{ThemeResource FilledPasswordBoxPlaceholderForeground}"
													FontFamily="{TemplateBinding FontFamily}"
													FontSize="{TemplateBinding FontSize}"
													Padding="{TemplateBinding Padding}"
													Visibility="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToVisibleConverter}}"
													IsHitTestVisible="False"
													IsTabStop="False" />

									<ScrollViewer x:Name="ContentElement"
												  HorizontalScrollMode="Auto"
												  HorizontalScrollBarVisibility="Hidden"
												  VerticalScrollMode="Disabled"
												  VerticalScrollBarVisibility="Hidden"
												  Padding="{TemplateBinding Padding}"
												  VerticalAlignment="Center"
												  IsHorizontalRailEnabled="False"
												  IsVerticalRailEnabled="False"
												  IsTabStop="False"
												  ZoomMode="Disabled"
												  AutomationProperties.AccessibilityView="Raw" />
								</Grid>

								<!-- Reveal button (Padding H: sds-size-space-200) -->
								<Button x:Name="RevealButton"
										Grid.Column="1"
										Visibility="Collapsed"
										Background="Transparent"
										BorderThickness="0"
										Padding="8,0"
										MinWidth="{ThemeResource SimpleIconMedium}"
										MinHeight="0"
										VerticalAlignment="Stretch"
										FontFamily="{ThemeResource SymbolThemeFontFamily}"
										FontSize="{ThemeResource BodyLargeFontSize}"
										Foreground="{ThemeResource FilledPasswordBoxRevealForeground}"
										Content="&#xE052;"
										IsTabStop="False"
										AutomationProperties.AccessibilityView="Raw" />
							</Grid>

							<!-- Border overlay — thickness changes don't push inner content -->
							<Border x:Name="BorderElement"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}" />

							<!-- Error ring: drawn instead of BorderElement, which the error states collapse. -->
							<Border x:Name="ErrorBorderElement"
									BorderBrush="{ThemeResource ErrorBrush}"
									BorderThickness="{ThemeResource FilledPasswordBoxFocusedBorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}"
									IsHitTestVisible="False"
									Visibility="Collapsed" />
						</Grid>

						<!--
							Filled by the framework: the error list (Inline) or the compact icon (Compact). Collapsed is
							load-bearing: once realized the part stays realized, and only the error states show it.
						-->
						<ContentPresenter x:Name="ErrorPresenter"
										  x:Load="False"
										  Grid.Row="1"
										  Grid.Column="1"
										  Visibility="Collapsed"
										  VerticalAlignment="Center"
										  Foreground="{ThemeResource ErrorBrush}"
										  AutomationProperties.AccessibilityView="Raw" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Outlined PasswordBox (OutlinedPasswordBox* semantic keys) -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
