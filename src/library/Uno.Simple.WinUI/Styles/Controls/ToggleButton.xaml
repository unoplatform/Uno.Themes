<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ut="using:Uno.Themes">

	<!--
		Simple Design System — ToggleButton Styles
		Lightweight styling pattern: every visual-state brush is exposed via ThemeResource
		so consumers can override any individual key.
		
		Text variants consume TextToggleButton* keys; icon variants consume
		IconToggleButton* keys, with independent per-state overrides.
		
		
		Default style: Neutral (unchecked) → Primary (checked)
		VisualStates: Normal, PointerOver, Pressed, Disabled,
		Checked, CheckedPointerOver, CheckedPressed, CheckedDisabled,
		Indeterminate*
	-->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Lightweight styling ThemeResource aliases -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<ResourceDictionary.ThemeDictionaries>

		<!-- ─── Light Theme ─── -->
		<ResourceDictionary x:Key="Light">

			<!-- Typeface alias: themed so the generated font layer can shadow it (see BaseTheme.FontFamilyAliasKeys). -->
			<StaticResource x:Key="SimpleToggleButtonFontFamily" ResourceKey="DefaultFontFamily" />

			<!-- ── TextToggleButton — semantic keys (source of truth) ── -->

			<!-- Unchecked -->
			<StaticResource x:Key="TextToggleButtonForeground" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundPointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundPressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBackground" ResourceKey="SurfaceVariantBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundPointerOver" ResourceKey="PrimaryContainerBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundPressed" ResourceKey="TertiaryContainerBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrush" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushPointerOver" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushPressed" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushDisabled" ResourceKey="OutlineDisabledBrush" />

			<!-- Checked -->
			<StaticResource x:Key="TextToggleButtonForegroundChecked" ResourceKey="OnPrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundCheckedPointerOver" ResourceKey="OnPrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundCheckedPressed" ResourceKey="OnPrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundCheckedDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundChecked" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundCheckedPointerOver" ResourceKey="PrimaryVariantDarkBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundCheckedPressed" ResourceKey="PrimaryVariantDarkBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundCheckedDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushChecked" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushCheckedPointerOver" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushCheckedPressed" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushCheckedDisabled" ResourceKey="OutlineDisabledBrush" />

			<!-- Indeterminate (same as Unchecked) -->
			<StaticResource x:Key="TextToggleButtonForegroundIndeterminate" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundIndeterminatePointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundIndeterminatePressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundIndeterminateDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundIndeterminate" ResourceKey="SurfaceVariantBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundIndeterminatePointerOver" ResourceKey="PrimaryContainerBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundIndeterminatePressed" ResourceKey="TertiaryContainerBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundIndeterminateDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushIndeterminate" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushIndeterminatePointerOver" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushIndeterminatePressed" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushIndeterminateDisabled" ResourceKey="OutlineDisabledBrush" />

			<!-- Unchecked -->
			<!-- Checked -->
			<!-- Indeterminate -->
			<!-- Icon variant preserves text-toggle defaults with independent overrides. -->
			<StaticResource x:Key="IconToggleButtonForeground" ResourceKey="TextToggleButtonForeground" />
			<StaticResource x:Key="IconToggleButtonForegroundPointerOver" ResourceKey="TextToggleButtonForegroundPointerOver" />
			<StaticResource x:Key="IconToggleButtonForegroundPressed" ResourceKey="TextToggleButtonForegroundPressed" />
			<StaticResource x:Key="IconToggleButtonForegroundDisabled" ResourceKey="TextToggleButtonForegroundDisabled" />
			<StaticResource x:Key="IconToggleButtonBackground" ResourceKey="TextToggleButtonBackground" />
			<StaticResource x:Key="IconToggleButtonBackgroundPointerOver" ResourceKey="TextToggleButtonBackgroundPointerOver" />
			<StaticResource x:Key="IconToggleButtonBackgroundPressed" ResourceKey="TextToggleButtonBackgroundPressed" />
			<StaticResource x:Key="IconToggleButtonBackgroundDisabled" ResourceKey="TextToggleButtonBackgroundDisabled" />
			<StaticResource x:Key="IconToggleButtonBorderBrush" ResourceKey="TextToggleButtonBorderBrush" />
			<StaticResource x:Key="IconToggleButtonBorderBrushPointerOver" ResourceKey="TextToggleButtonBorderBrushPointerOver" />
			<StaticResource x:Key="IconToggleButtonBorderBrushPressed" ResourceKey="TextToggleButtonBorderBrushPressed" />
			<StaticResource x:Key="IconToggleButtonBorderBrushDisabled" ResourceKey="TextToggleButtonBorderBrushDisabled" />
			<StaticResource x:Key="IconToggleButtonForegroundChecked" ResourceKey="TextToggleButtonForegroundChecked" />
			<StaticResource x:Key="IconToggleButtonForegroundCheckedPointerOver" ResourceKey="TextToggleButtonForegroundCheckedPointerOver" />
			<StaticResource x:Key="IconToggleButtonForegroundCheckedPressed" ResourceKey="TextToggleButtonForegroundCheckedPressed" />
			<StaticResource x:Key="IconToggleButtonForegroundCheckedDisabled" ResourceKey="TextToggleButtonForegroundCheckedDisabled" />
			<StaticResource x:Key="IconToggleButtonBackgroundChecked" ResourceKey="TextToggleButtonBackgroundChecked" />
			<StaticResource x:Key="IconToggleButtonBackgroundCheckedPointerOver" ResourceKey="TextToggleButtonBackgroundCheckedPointerOver" />
			<StaticResource x:Key="IconToggleButtonBackgroundCheckedPressed" ResourceKey="TextToggleButtonBackgroundCheckedPressed" />
			<StaticResource x:Key="IconToggleButtonBackgroundCheckedDisabled" ResourceKey="TextToggleButtonBackgroundCheckedDisabled" />
			<StaticResource x:Key="IconToggleButtonBorderBrushChecked" ResourceKey="TextToggleButtonBorderBrushChecked" />
			<StaticResource x:Key="IconToggleButtonBorderBrushCheckedPointerOver" ResourceKey="TextToggleButtonBorderBrushCheckedPointerOver" />
			<StaticResource x:Key="IconToggleButtonBorderBrushCheckedPressed" ResourceKey="TextToggleButtonBorderBrushCheckedPressed" />
			<StaticResource x:Key="IconToggleButtonBorderBrushCheckedDisabled" ResourceKey="TextToggleButtonBorderBrushCheckedDisabled" />
			<StaticResource x:Key="IconToggleButtonForegroundIndeterminate" ResourceKey="TextToggleButtonForegroundIndeterminate" />
			<StaticResource x:Key="IconToggleButtonForegroundIndeterminatePointerOver" ResourceKey="TextToggleButtonForegroundIndeterminatePointerOver" />
			<StaticResource x:Key="IconToggleButtonForegroundIndeterminatePressed" ResourceKey="TextToggleButtonForegroundIndeterminatePressed" />
			<StaticResource x:Key="IconToggleButtonForegroundIndeterminateDisabled" ResourceKey="TextToggleButtonForegroundIndeterminateDisabled" />
			<StaticResource x:Key="IconToggleButtonBackgroundIndeterminate" ResourceKey="TextToggleButtonBackgroundIndeterminate" />
			<StaticResource x:Key="IconToggleButtonBackgroundIndeterminatePointerOver" ResourceKey="TextToggleButtonBackgroundIndeterminatePointerOver" />
			<StaticResource x:Key="IconToggleButtonBackgroundIndeterminatePressed" ResourceKey="TextToggleButtonBackgroundIndeterminatePressed" />
			<StaticResource x:Key="IconToggleButtonBackgroundIndeterminateDisabled" ResourceKey="TextToggleButtonBackgroundIndeterminateDisabled" />
			<StaticResource x:Key="IconToggleButtonBorderBrushIndeterminate" ResourceKey="TextToggleButtonBorderBrushIndeterminate" />
			<StaticResource x:Key="IconToggleButtonBorderBrushIndeterminatePointerOver" ResourceKey="TextToggleButtonBorderBrushIndeterminatePointerOver" />
			<StaticResource x:Key="IconToggleButtonBorderBrushIndeterminatePressed" ResourceKey="TextToggleButtonBorderBrushIndeterminatePressed" />
			<StaticResource x:Key="IconToggleButtonBorderBrushIndeterminateDisabled" ResourceKey="TextToggleButtonBorderBrushIndeterminateDisabled" />
		</ResourceDictionary>

		<!-- ─── Dark Theme (Default) ─── -->
		<ResourceDictionary x:Key="Default">

			<!-- Typeface alias: themed so the generated font layer can shadow it (see BaseTheme.FontFamilyAliasKeys). -->
			<StaticResource x:Key="SimpleToggleButtonFontFamily" ResourceKey="DefaultFontFamily" />

			<!-- ── TextToggleButton — semantic keys (source of truth) ── -->

			<!-- Unchecked -->
			<StaticResource x:Key="TextToggleButtonForeground" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundPointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundPressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBackground" ResourceKey="SurfaceVariantBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundPointerOver" ResourceKey="PrimaryContainerBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundPressed" ResourceKey="TertiaryContainerBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrush" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushPointerOver" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushPressed" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushDisabled" ResourceKey="OutlineDisabledBrush" />

			<!-- Checked -->
			<StaticResource x:Key="TextToggleButtonForegroundChecked" ResourceKey="OnPrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundCheckedPointerOver" ResourceKey="OnPrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundCheckedPressed" ResourceKey="OnPrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundCheckedDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundChecked" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundCheckedPointerOver" ResourceKey="PrimaryVariantDarkBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundCheckedPressed" ResourceKey="PrimaryVariantDarkBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundCheckedDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushChecked" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushCheckedPointerOver" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushCheckedPressed" ResourceKey="PrimaryBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushCheckedDisabled" ResourceKey="OutlineDisabledBrush" />

			<!-- Indeterminate (same as Unchecked) -->
			<StaticResource x:Key="TextToggleButtonForegroundIndeterminate" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundIndeterminatePointerOver" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundIndeterminatePressed" ResourceKey="OnSurfaceBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundIndeterminateDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundIndeterminate" ResourceKey="SurfaceVariantBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundIndeterminatePointerOver" ResourceKey="PrimaryContainerBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundIndeterminatePressed" ResourceKey="TertiaryContainerBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundIndeterminateDisabled" ResourceKey="OnSurfaceDisabledBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushIndeterminate" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushIndeterminatePointerOver" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushIndeterminatePressed" ResourceKey="OutlineBrush" />
			<StaticResource x:Key="TextToggleButtonBorderBrushIndeterminateDisabled" ResourceKey="OutlineDisabledBrush" />

			<!-- Unchecked -->
			<!-- Checked -->
			<!-- Indeterminate -->
			<!-- Icon variant preserves text-toggle defaults with independent overrides. -->
			<StaticResource x:Key="IconToggleButtonForeground" ResourceKey="TextToggleButtonForeground" />
			<StaticResource x:Key="IconToggleButtonForegroundPointerOver" ResourceKey="TextToggleButtonForegroundPointerOver" />
			<StaticResource x:Key="IconToggleButtonForegroundPressed" ResourceKey="TextToggleButtonForegroundPressed" />
			<StaticResource x:Key="IconToggleButtonForegroundDisabled" ResourceKey="TextToggleButtonForegroundDisabled" />
			<StaticResource x:Key="IconToggleButtonBackground" ResourceKey="TextToggleButtonBackground" />
			<StaticResource x:Key="IconToggleButtonBackgroundPointerOver" ResourceKey="TextToggleButtonBackgroundPointerOver" />
			<StaticResource x:Key="IconToggleButtonBackgroundPressed" ResourceKey="TextToggleButtonBackgroundPressed" />
			<StaticResource x:Key="IconToggleButtonBackgroundDisabled" ResourceKey="TextToggleButtonBackgroundDisabled" />
			<StaticResource x:Key="IconToggleButtonBorderBrush" ResourceKey="TextToggleButtonBorderBrush" />
			<StaticResource x:Key="IconToggleButtonBorderBrushPointerOver" ResourceKey="TextToggleButtonBorderBrushPointerOver" />
			<StaticResource x:Key="IconToggleButtonBorderBrushPressed" ResourceKey="TextToggleButtonBorderBrushPressed" />
			<StaticResource x:Key="IconToggleButtonBorderBrushDisabled" ResourceKey="TextToggleButtonBorderBrushDisabled" />
			<StaticResource x:Key="IconToggleButtonForegroundChecked" ResourceKey="TextToggleButtonForegroundChecked" />
			<StaticResource x:Key="IconToggleButtonForegroundCheckedPointerOver" ResourceKey="TextToggleButtonForegroundCheckedPointerOver" />
			<StaticResource x:Key="IconToggleButtonForegroundCheckedPressed" ResourceKey="TextToggleButtonForegroundCheckedPressed" />
			<StaticResource x:Key="IconToggleButtonForegroundCheckedDisabled" ResourceKey="TextToggleButtonForegroundCheckedDisabled" />
			<StaticResource x:Key="IconToggleButtonBackgroundChecked" ResourceKey="TextToggleButtonBackgroundChecked" />
			<StaticResource x:Key="IconToggleButtonBackgroundCheckedPointerOver" ResourceKey="TextToggleButtonBackgroundCheckedPointerOver" />
			<StaticResource x:Key="IconToggleButtonBackgroundCheckedPressed" ResourceKey="TextToggleButtonBackgroundCheckedPressed" />
			<StaticResource x:Key="IconToggleButtonBackgroundCheckedDisabled" ResourceKey="TextToggleButtonBackgroundCheckedDisabled" />
			<StaticResource x:Key="IconToggleButtonBorderBrushChecked" ResourceKey="TextToggleButtonBorderBrushChecked" />
			<StaticResource x:Key="IconToggleButtonBorderBrushCheckedPointerOver" ResourceKey="TextToggleButtonBorderBrushCheckedPointerOver" />
			<StaticResource x:Key="IconToggleButtonBorderBrushCheckedPressed" ResourceKey="TextToggleButtonBorderBrushCheckedPressed" />
			<StaticResource x:Key="IconToggleButtonBorderBrushCheckedDisabled" ResourceKey="TextToggleButtonBorderBrushCheckedDisabled" />
			<StaticResource x:Key="IconToggleButtonForegroundIndeterminate" ResourceKey="TextToggleButtonForegroundIndeterminate" />
			<StaticResource x:Key="IconToggleButtonForegroundIndeterminatePointerOver" ResourceKey="TextToggleButtonForegroundIndeterminatePointerOver" />
			<StaticResource x:Key="IconToggleButtonForegroundIndeterminatePressed" ResourceKey="TextToggleButtonForegroundIndeterminatePressed" />
			<StaticResource x:Key="IconToggleButtonForegroundIndeterminateDisabled" ResourceKey="TextToggleButtonForegroundIndeterminateDisabled" />
			<StaticResource x:Key="IconToggleButtonBackgroundIndeterminate" ResourceKey="TextToggleButtonBackgroundIndeterminate" />
			<StaticResource x:Key="IconToggleButtonBackgroundIndeterminatePointerOver" ResourceKey="TextToggleButtonBackgroundIndeterminatePointerOver" />
			<StaticResource x:Key="IconToggleButtonBackgroundIndeterminatePressed" ResourceKey="TextToggleButtonBackgroundIndeterminatePressed" />
			<StaticResource x:Key="IconToggleButtonBackgroundIndeterminateDisabled" ResourceKey="TextToggleButtonBackgroundIndeterminateDisabled" />
			<StaticResource x:Key="IconToggleButtonBorderBrushIndeterminate" ResourceKey="TextToggleButtonBorderBrushIndeterminate" />
			<StaticResource x:Key="IconToggleButtonBorderBrushIndeterminatePointerOver" ResourceKey="TextToggleButtonBorderBrushIndeterminatePointerOver" />
			<StaticResource x:Key="IconToggleButtonBorderBrushIndeterminatePressed" ResourceKey="TextToggleButtonBorderBrushIndeterminatePressed" />
			<StaticResource x:Key="IconToggleButtonBorderBrushIndeterminateDisabled" ResourceKey="TextToggleButtonBorderBrushIndeterminateDisabled" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<StaticResource x:Key="SimpleToggleButtonCornerRadius" ResourceKey="SimpleRadius200CornerRadius" />     <!-- sds-size-radius-200 = 8 px -->
	<StaticResource x:Key="SimpleToggleButtonBorderThickness" ResourceKey="SimpleStrokeBorderThickness" />  <!-- sds-size-stroke-border = 1 px -->
	<StaticResource x:Key="SimpleToggleButtonIconSpacing" ResourceKey="SimpleSpace200" />                   <!-- sds-size-space-200 = 8 px -->


	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Layout / sizing resources (theme-agnostic) -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<x:String x:Key="SimpleToggleButtonFontWeight">Medium</x:String>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Default ToggleButton (Neutral unchecked → Primary checked) -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<Style x:Key="SimpleTextToggleButtonStyle"
		   TargetType="ToggleButton">
		<Setter Property="FontFamily" Value="{ThemeResource SimpleToggleButtonFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource LabelLargeFontSize}" />
		<Setter Property="FontWeight" Value="{StaticResource SimpleToggleButtonFontWeight}" />
		<Setter Property="MinHeight" Value="{StaticResource ControlHeightMedium}" />
		<Setter Property="Padding" Value="{ThemeResource SimpleSpace300Thickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource SimpleToggleButtonCornerRadius}" />
		<Setter Property="BorderThickness" Value="{StaticResource SimpleToggleButtonBorderThickness}" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
		<Setter Property="FocusVisualMargin" Value="-3" />
		<Setter Property="Foreground" Value="{ThemeResource TextToggleButtonForeground}" />
		<Setter Property="Background" Value="{ThemeResource TextToggleButtonBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid x:Name="Root"
						  Background="{TemplateBinding Background}"
						  BorderBrush="{TemplateBinding BorderBrush}"
						  BorderThickness="{TemplateBinding BorderThickness}"
						  CornerRadius="{TemplateBinding CornerRadius}"
						  Padding="{TemplateBinding Padding}"
						  AutomationProperties.AccessibilityView="Raw">

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">

								<!-- Unchecked states -->
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundPointerOver}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushPointerOver}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundPointerOver}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundPointerOver}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundPointerOver}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundPressed}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushPressed}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundPressed}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundPressed}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundPressed}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundDisabled}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushDisabled}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundDisabled}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundDisabled}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundDisabled}" />
									</VisualState.Setters>
								</VisualState>

								<!-- Checked states -->
								<VisualState x:Name="Checked">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundChecked}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushChecked}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundChecked}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundChecked}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundChecked}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundCheckedPointerOver}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushCheckedPointerOver}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedPointerOver}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedPointerOver}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedPointerOver}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPressed">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundCheckedPressed}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushCheckedPressed}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedPressed}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedPressed}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedPressed}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedDisabled">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundCheckedDisabled}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushCheckedDisabled}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedDisabled}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedDisabled}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundCheckedDisabled}" />
									</VisualState.Setters>
								</VisualState>

								<!-- Indeterminate states -->
								<VisualState x:Name="IndeterminateNormal">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundIndeterminate}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushIndeterminate}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminate}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminate}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminate}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundIndeterminatePointerOver}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushIndeterminatePointerOver}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminatePointerOver}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminatePointerOver}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminatePointerOver}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePressed">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundIndeterminatePressed}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushIndeterminatePressed}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminatePressed}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminatePressed}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminatePressed}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminateDisabled">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource TextToggleButtonBackgroundIndeterminateDisabled}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource TextToggleButtonBorderBrushIndeterminateDisabled}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminateDisabled}" />
										<Setter Target="LeadingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminateDisabled}" />
										<Setter Target="TrailingIconPresenter.Foreground" Value="{ThemeResource TextToggleButtonForegroundIndeterminateDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									Spacing="{ThemeResource SimpleToggleButtonIconSpacing}">

							<ContentPresenter x:Name="LeadingIconPresenter"
											  Content="{Binding Path=(ut:ControlExtensions.LeadingIcon), RelativeSource={RelativeSource TemplatedParent}}"
											  Foreground="{TemplateBinding Foreground}"
											  Visibility="{Binding Path=(ut:ControlExtensions.LeadingIcon), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
											  VerticalAlignment="Center" />

							<ContentPresenter x:Name="ContentPresenter"
											  Content="{TemplateBinding Content}"
											  ContentTemplate="{TemplateBinding ContentTemplate}"
											  ContentTransitions="{TemplateBinding ContentTransitions}"
											  Foreground="{TemplateBinding Foreground}"
											  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

							<ContentPresenter x:Name="TrailingIconPresenter"
											  Content="{Binding Path=(ut:ControlExtensions.TrailingIcon), RelativeSource={RelativeSource TemplatedParent}}"
											  Foreground="{TemplateBinding Foreground}"
											  Visibility="{Binding Path=(ut:ControlExtensions.TrailingIcon), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
											  VerticalAlignment="Center" />
						</StackPanel>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Icon-only ToggleButton (compact, circular — mirrors IconButton shape) -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<Style x:Key="SimpleIconToggleButtonStyle"
		   TargetType="ToggleButton">
		<Setter Property="FontFamily" Value="{ThemeResource SimpleToggleButtonFontFamily}" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="MinHeight" Value="{StaticResource SimpleIconLarge}" />
		<Setter Property="MinWidth" Value="{StaticResource SimpleIconLarge}" />
		<Setter Property="MaxHeight" Value="{StaticResource SimpleIconLarge}" />
		<Setter Property="MaxWidth" Value="{StaticResource SimpleIconLarge}" />
		<Setter Property="Padding" Value="{ThemeResource SimpleSpace200Thickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource SimpleIconButtonCornerRadius}" />
		<Setter Property="BorderThickness" Value="{StaticResource SimpleIconButtonBorderThickness}" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
		<Setter Property="FocusVisualMargin" Value="-3" />
		<Setter Property="Foreground" Value="{ThemeResource IconToggleButtonForeground}" />
		<Setter Property="Background" Value="{ThemeResource IconToggleButtonBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<ContentPresenter x:Name="ContentPresenter"
									  Background="{TemplateBinding Background}"
									  BorderBrush="{TemplateBinding BorderBrush}"
									  BorderThickness="{TemplateBinding BorderThickness}"
									  CornerRadius="{TemplateBinding CornerRadius}"
									  Content="{TemplateBinding Content}"
									  ContentTemplate="{TemplateBinding ContentTemplate}"
									  ContentTransitions="{TemplateBinding ContentTransitions}"
									  Foreground="{TemplateBinding Foreground}"
									  Padding="{TemplateBinding Padding}"
									  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									  AutomationProperties.AccessibilityView="Raw">

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">

								<!-- Unchecked states -->
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundPointerOver}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushPointerOver}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundPointerOver}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundPressed}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushPressed}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundPressed}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundDisabled}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushDisabled}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundDisabled}" />
									</VisualState.Setters>
								</VisualState>

								<!-- Checked states -->
								<VisualState x:Name="Checked">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundChecked}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushChecked}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundChecked}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPointerOver">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundCheckedPointerOver}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushCheckedPointerOver}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundCheckedPointerOver}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPressed">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundCheckedPressed}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushCheckedPressed}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundCheckedPressed}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedDisabled">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundCheckedDisabled}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushCheckedDisabled}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundCheckedDisabled}" />
									</VisualState.Setters>
								</VisualState>

								<!-- Indeterminate states -->
								<VisualState x:Name="IndeterminateNormal">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundIndeterminate}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushIndeterminate}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundIndeterminate}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePointerOver">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundIndeterminatePointerOver}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushIndeterminatePointerOver}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundIndeterminatePointerOver}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePressed">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundIndeterminatePressed}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushIndeterminatePressed}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundIndeterminatePressed}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminateDisabled">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Background" Value="{ThemeResource IconToggleButtonBackgroundIndeterminateDisabled}" />
										<Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource IconToggleButtonBorderBrushIndeterminateDisabled}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource IconToggleButtonForegroundIndeterminateDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</ContentPresenter>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Default alias (backward compat) -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<Style x:Key="SimpleDefaultToggleButtonStyle"
		   TargetType="ToggleButton"
		   BasedOn="{StaticResource SimpleTextToggleButtonStyle}" />



</ResourceDictionary>
