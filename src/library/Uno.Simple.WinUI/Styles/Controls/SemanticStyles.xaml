<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Kept out of the XamlMerge bundle (see simple-common.props) and merged by SimpleTheme as a
		SemanticResources dictionary, so tooling can tell these keys from the Simple-prefixed ones.
	-->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Semantic aliases (design-system-agnostic) -->
	<!-- These map Material-derived semantic names to Simple equivalents. -->
	<!-- See: .specify/specs/semantic-abstraction-layer/spec.md -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->

	<!-- Button -->
	<StaticResource x:Key="FilledButtonStyle" ResourceKey="SimpleFilledButtonStyle" />
	<!-- ElevatedButtonStyle — GAP: Simple has no elevated/shadow button variant -->
	<StaticResource x:Key="FilledTonalButtonStyle" ResourceKey="SimpleFilledTonalButtonStyle" />
	<StaticResource x:Key="OutlinedButtonStyle" ResourceKey="SimpleFilledTonalButtonStyle" />
	<StaticResource x:Key="TextButtonStyle" ResourceKey="SimpleTextButtonStyle" />
	<StaticResource x:Key="IconButtonStyle" ResourceKey="SimpleIconButtonStyle" />

	<!-- ToggleButton -->
	<StaticResource x:Key="TextToggleButtonStyle" ResourceKey="SimpleTextToggleButtonStyle" />
	<StaticResource x:Key="IconToggleButtonStyle" ResourceKey="SimpleIconToggleButtonStyle" />

	<!-- TextBox -->
	<StaticResource x:Key="FilledTextBoxStyle" ResourceKey="SimpleFilledTextBoxStyle" />
	<StaticResource x:Key="OutlinedTextBoxStyle" ResourceKey="SimpleOutlinedTextBoxStyle" />

	<!-- PasswordBox -->
	<StaticResource x:Key="FilledPasswordBoxStyle" ResourceKey="SimpleFilledPasswordBoxStyle" />
	<StaticResource x:Key="OutlinedPasswordBoxStyle" ResourceKey="SimpleOutlinedPasswordBoxStyle" />

	<!-- ComboBox -->
	<StaticResource x:Key="ComboBoxStyle" ResourceKey="SimpleComboBoxStyle" />
	<StaticResource x:Key="ComboBoxItemStyle" ResourceKey="SimpleComboBoxItemStyle" />

	<!-- CheckBox / RadioButton / ToggleSwitch / Slider -->
	<StaticResource x:Key="CheckBoxStyle" ResourceKey="SimpleCheckBoxStyle" />
	<StaticResource x:Key="RadioButtonStyle" ResourceKey="SimpleRadioButtonStyle" />
	<StaticResource x:Key="ToggleSwitchStyle" ResourceKey="SimpleToggleSwitchStyle" />
	<StaticResource x:Key="SliderStyle" ResourceKey="SimpleSliderStyle" />

	<!-- HyperlinkButton -->
	<StaticResource x:Key="HyperlinkButtonStyle" ResourceKey="SimpleHyperlinkButtonStyle" />
	<StaticResource x:Key="SecondaryHyperlinkButtonStyle" ResourceKey="SimpleSecondaryHyperlinkButtonStyle" />

	<!-- ListView -->
	<StaticResource x:Key="ListViewStyle" ResourceKey="SimpleListViewStyle" />
	<StaticResource x:Key="ListViewItemStyle" ResourceKey="SimpleListViewItemStyle" />

	<!-- ContentDialog -->
	<StaticResource x:Key="ContentDialogStyle" ResourceKey="SimpleContentDialogStyle" />

	<!-- AppBarButton -->
	<StaticResource x:Key="AppBarButtonStyle" ResourceKey="SimpleAppBarButtonStyle" />

	<!-- NavigationView -->
	<StaticResource x:Key="NavigationViewStyle" ResourceKey="SimpleNavigationViewStyle" />
	<StaticResource x:Key="NavigationViewItemStyle" ResourceKey="SimpleNavigationViewItemStyle" />

	<!-- CalendarView / CalendarDatePicker / DatePicker -->
	<StaticResource x:Key="CalendarViewStyle" ResourceKey="SimpleCalendarViewStyle" />
	<StaticResource x:Key="CalendarDatePickerStyle" ResourceKey="SimpleCalendarDatePickerStyle" />
	<StaticResource x:Key="DatePickerStyle" ResourceKey="SimpleDatePickerStyle" />

	<!-- ProgressBar / ProgressRing -->
	<StaticResource x:Key="ProgressBarStyle" ResourceKey="SimpleProgressBarStyle" />
	<StaticResource x:Key="ProgressRingStyle" ResourceKey="SimpleProgressRingStyle" />

	<!-- PipsPager -->
	<StaticResource x:Key="PipsPagerStyle" ResourceKey="SimplePipsPagerStyle" />

	<!-- RatingControl -->
	<StaticResource x:Key="RatingControlStyle" ResourceKey="SimpleRatingControlStyle" />

	<!-- Flyout / MenuFlyout -->
	<StaticResource x:Key="FlyoutPresenterStyle" ResourceKey="SimpleFlyoutPresenterStyle" />
	<StaticResource x:Key="MenuFlyoutPresenterStyle" ResourceKey="SimpleMenuFlyoutPresenterStyle" />
	<StaticResource x:Key="MenuFlyoutItemStyle" ResourceKey="SimpleMenuFlyoutItemStyle" />
	<StaticResource x:Key="MenuFlyoutSeparatorStyle" ResourceKey="SimpleMenuFlyoutSeparatorStyle" />
	<StaticResource x:Key="MenuFlyoutSubItemStyle" ResourceKey="SimpleMenuFlyoutSubItemStyle" />
	<StaticResource x:Key="ToggleMenuFlyoutItemStyle" ResourceKey="SimpleToggleMenuFlyoutItemStyle" />
	<StaticResource x:Key="RadioMenuFlyoutItemStyle" ResourceKey="SimpleRadioMenuFlyoutItemStyle" />

	<!-- FAB — alias to existing Simple icon button styles -->
	<StaticResource x:Key="FabStyle" ResourceKey="SimpleIconButtonStyle" />
	<StaticResource x:Key="SmallFabStyle" ResourceKey="SimpleIconButtonStyle" />
	<StaticResource x:Key="LargeFabStyle" ResourceKey="SimpleIconButtonStyle" />
	<StaticResource x:Key="SecondaryFabStyle" ResourceKey="SimpleIconButtonNeutralStyle" />
	<StaticResource x:Key="SecondarySmallFabStyle" ResourceKey="SimpleIconButtonNeutralStyle" />
	<StaticResource x:Key="SecondaryLargeFabStyle" ResourceKey="SimpleIconButtonNeutralStyle" />
	<StaticResource x:Key="TertiaryFabStyle" ResourceKey="SimpleIconButtonSubtleStyle" />
	<StaticResource x:Key="TertiarySmallFabStyle" ResourceKey="SimpleIconButtonSubtleStyle" />
	<StaticResource x:Key="TertiaryLargeFabStyle" ResourceKey="SimpleIconButtonSubtleStyle" />
	<StaticResource x:Key="SurfaceFabStyle" ResourceKey="SimpleIconButtonNeutralStyle" />
	<StaticResource x:Key="SurfaceSmallFabStyle" ResourceKey="SimpleIconButtonNeutralStyle" />
	<StaticResource x:Key="SurfaceLargeFabStyle" ResourceKey="SimpleIconButtonNeutralStyle" />

	<!-- CommandBar -->
	<!-- CommandBarStyle — GAP: Simple has no CommandBar style -->

	<!-- MediaPlayerElement -->
	<!-- MediaTransportControlsStyle — GAP: Simple has no media style -->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Typography aliases -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<StaticResource x:Key="DisplayLarge" ResourceKey="SimpleDisplayLarge" />
	<StaticResource x:Key="DisplayMedium" ResourceKey="SimpleDisplayMedium" />
	<StaticResource x:Key="DisplaySmall" ResourceKey="SimpleDisplaySmall" />
	<StaticResource x:Key="HeadlineLarge" ResourceKey="SimpleHeadlineLarge" />
	<StaticResource x:Key="HeadlineMedium" ResourceKey="SimpleHeadlineMedium" />
	<StaticResource x:Key="HeadlineSmall" ResourceKey="SimpleHeadlineSmall" />
	<StaticResource x:Key="TitleLarge" ResourceKey="SimpleTitleLarge" />
	<StaticResource x:Key="TitleMedium" ResourceKey="SimpleTitleMedium" />
	<StaticResource x:Key="TitleSmall" ResourceKey="SimpleTitleSmall" />
	<StaticResource x:Key="BodyLarge" ResourceKey="SimpleBodyLarge" />
	<StaticResource x:Key="BodyMedium" ResourceKey="SimpleBodyMedium" />
	<StaticResource x:Key="BodySmall" ResourceKey="SimpleBodySmall" />
	<StaticResource x:Key="LabelLarge" ResourceKey="SimpleLabelLarge" />
	<StaticResource x:Key="LabelMedium" ResourceKey="SimpleLabelMedium" />
	<StaticResource x:Key="LabelSmall" ResourceKey="SimpleLabelSmall" />
	<StaticResource x:Key="LabelExtraSmall" ResourceKey="SimpleLabelExtraSmall" />
	<StaticResource x:Key="CaptionLarge" ResourceKey="SimpleCaptionLarge" />
	<StaticResource x:Key="CaptionMedium" ResourceKey="SimpleCaptionMedium" />
	<StaticResource x:Key="CaptionSmall" ResourceKey="SimpleCaptionSmall" />

</ResourceDictionary>
