<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:not_win="http://uno.ui/not_win"
					mc:Ignorable="d not_win">

	<!--
		Omarchy ToggleSwitch - reproduces flutter_omarchy lib/src/widgets/toggle.dart
		(state model: lib/src/widgets/utils/pointer_area.dart, highlighted = isHovering || hasFocus).

		toggle.dart: 28 x 14 track (radius 2, padding 2), 10 x 10 knob (radius 1) that grows 2 px wider
		while highlighted, aligned left when off and right when on.
		  track: highlighted && on -> bright.white | on -> background | off -> normal.black
		  knob:  on -> normal.black | off && highlighted -> foreground | off -> normal.white
		  neutral: foreground = colors.foreground, background = bright.white
		  accent:  foreground = normal.<accent>,   background = bright.<accent>

		Channels: Background = the ON track fill, BorderBrush = the OFF + highlighted knob colour,
		Foreground = Header / OnContent / OffContent text. The hover track and knob colours are fixed
		keys, layered as children of the ON track / OFF knob so they inherit that layer's opacity and
		can be driven by CommonStates / FocusStates independently of ToggleStates.

		Parts Uno looks up: SwitchKnob, SwitchKnobBounds, SwitchThumb (Simple omits the curtain parts too).

		Deviations:
		- Pressed = PointerOver (the source never reads isPressed).
		- Disabled: the source has no disabled visuals; the whole control is dimmed to OmarchyBorderOpacityDisabled.
		- Keyboard focus recolours (dedicated KnobOffFocus / OnTrackFocus layers) but does not widen the
		  knob: the knob Width is owned by CommonStates and cannot also be driven by FocusStates.
		- No KnobTranslateTransform: the knobs are positioned by alignment so the hover widening grows toward
		  the track centre in both positions; a drag still toggles on release, the knob just does not follow.
		- Omarchy has no labels: OnContent / OffContent default to null, the presenters stay for consumers.
		- Every source transition animates over 120 ms (easeInOut); the states below switch instantly.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="ToggleSwitchForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- Default of the Background channel (the accent variants replace it) -->
			<StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="OmarchyNormalWhiteBrush" />
			<!-- Default of the BorderBrush channel (the accent variants replace it) -->
			<StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="OmarchyNormalBlackBrush" />
		</ResourceDictionary>

		<!-- Omarchy has one palette with a light/dark flag: Light and Default are identical -->
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="ToggleSwitchForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="OmarchyNormalBlackBrush" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- toggle.dart: const size = Size(28, 14) -->
	<x:Double x:Key="OmarchyToggleSwitchWidth">28</x:Double>
	<x:Double x:Key="OmarchyToggleSwitchHeight">14</x:Double>
	<!-- BorderRadius.circular(2) on the track, EdgeInsets.all(2) around the knob -->
	<CornerRadius x:Key="OmarchyToggleSwitchCornerRadius">2</CornerRadius>
	<Thickness x:Key="OmarchyToggleSwitchPadding">2</Thickness>
	<!-- Knob: height - 4, + 2 px wide while highlighted, BorderRadius.circular(1) -->
	<x:Double x:Key="OmarchyToggleSwitchKnobSize">10</x:Double>
	<x:Double x:Key="OmarchyToggleSwitchKnobWidthPointerOver">12</x:Double>
	<CornerRadius x:Key="OmarchyToggleSwitchKnobCornerRadius">1</CornerRadius>

	<Style x:Key="OmarchyToggleSwitchStyle"
		   TargetType="ToggleSwitch">
		<Setter Property="Background" Value="{ThemeResource ToggleSwitchFillOn}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ToggleSwitchKnobFillOffPointerOver}" />
		<Setter Property="Foreground" Value="{ThemeResource ToggleSwitchForeground}" />
		<Setter Property="CornerRadius" Value="{ThemeResource OmarchyToggleSwitchCornerRadius}" />
		<!-- Gap between the track and the On / Off content -->
		<Setter Property="Padding" Value="{ThemeResource Space200LeftThickness}" />
		<Setter Property="OnContent" Value="{x:Null}" />
		<Setter Property="OffContent" Value="{x:Null}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="MinWidth" Value="0" />
		<!-- Focus is drawn by the KnobOffFocus / OnTrackFocus layers -->
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleSwitch">
					<Grid x:Name="RootGrid"
						  Background="Transparent">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="KnobOff.Width" Value="{ThemeResource OmarchyToggleSwitchKnobWidthPointerOver}" />
										<Setter Target="KnobOn.Width" Value="{ThemeResource OmarchyToggleSwitchKnobWidthPointerOver}" />
										<Setter Target="KnobOffHover.Opacity" Value="1" />
										<Setter Target="OnTrackHover.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="KnobOff.Width" Value="{ThemeResource OmarchyToggleSwitchKnobWidthPointerOver}" />
										<Setter Target="KnobOn.Width" Value="{ThemeResource OmarchyToggleSwitchKnobWidthPointerOver}" />
										<Setter Target="KnobOffHover.Opacity" Value="1" />
										<Setter Target="OnTrackHover.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="RootGrid.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ToggleStates">
								<VisualState x:Name="Dragging" />
								<VisualState x:Name="Off" />
								<VisualState x:Name="On">
									<VisualState.Setters>
										<Setter Target="OnTrack.Opacity" Value="1" />
										<Setter Target="KnobOff.Opacity" Value="0" />
										<Setter Target="KnobOn.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<!-- hasFocus is part of "highlighted": keyboard focus recolours like hover -->
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="KnobOffFocus.Opacity" Value="1" />
										<Setter Target="OnTrackFocus.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Unfocused" />
								<VisualState x:Name="PointerFocused" />
							</VisualStateGroup>

							<VisualStateGroup x:Name="ContentStates">
								<VisualState x:Name="OffContent" />
								<VisualState x:Name="OnContent">
									<VisualState.Setters>
										<Setter Target="OffContentPresenter.Visibility" Value="Collapsed" />
										<Setter Target="OnContentPresenter.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Margin="{ThemeResource Space100BottomThickness}"
										  Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}"
										  AutomationProperties.AccessibilityView="Raw" />

						<Grid x:Name="SwitchAreaGrid"
							  Grid.Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<!-- Track: OFF plate, then the ON layer with its hover / focus children -->
							<Grid x:Name="SwitchKnobBounds"
								  Grid.Column="0"
								  Width="{ThemeResource OmarchyToggleSwitchWidth}"
								  Height="{ThemeResource OmarchyToggleSwitchHeight}"
								  VerticalAlignment="Center">
								<Border x:Name="OffTrack"
										Background="{ThemeResource ToggleSwitchFillOff}"
										CornerRadius="{TemplateBinding CornerRadius}" />
								<Grid x:Name="OnTrack"
									  Background="{TemplateBinding Background}"
									  CornerRadius="{TemplateBinding CornerRadius}"
									  Opacity="0">
									<Border x:Name="OnTrackHover"
											Background="{ThemeResource ToggleSwitchFillOnPointerOver}"
											CornerRadius="{TemplateBinding CornerRadius}"
											Opacity="0" />
									<Border x:Name="OnTrackFocus"
											Background="{ThemeResource ToggleSwitchFillOnPointerOver}"
											CornerRadius="{TemplateBinding CornerRadius}"
											Opacity="0" />
								</Grid>

								<!-- Knobs: OFF sits at the left edge of the padding, ON at the right edge -->
								<Grid x:Name="SwitchKnob"
									  Margin="{ThemeResource OmarchyToggleSwitchPadding}">
									<Grid x:Name="KnobOff"
										  Width="{ThemeResource OmarchyToggleSwitchKnobSize}"
										  Height="{ThemeResource OmarchyToggleSwitchKnobSize}"
										  HorizontalAlignment="Left"
										  VerticalAlignment="Center"
										  Background="{ThemeResource ToggleSwitchKnobFillOff}"
										  CornerRadius="{ThemeResource OmarchyToggleSwitchKnobCornerRadius}">
										<Border x:Name="KnobOffHover"
												Background="{TemplateBinding BorderBrush}"
												CornerRadius="{ThemeResource OmarchyToggleSwitchKnobCornerRadius}"
												Opacity="0" />
										<Border x:Name="KnobOffFocus"
												Background="{TemplateBinding BorderBrush}"
												CornerRadius="{ThemeResource OmarchyToggleSwitchKnobCornerRadius}"
												Opacity="0" />
									</Grid>
									<Border x:Name="KnobOn"
											Width="{ThemeResource OmarchyToggleSwitchKnobSize}"
											Height="{ThemeResource OmarchyToggleSwitchKnobSize}"
											HorizontalAlignment="Right"
											VerticalAlignment="Center"
											Background="{ThemeResource ToggleSwitchKnobFillOn}"
											CornerRadius="{ThemeResource OmarchyToggleSwitchKnobCornerRadius}"
											Opacity="0" />
								</Grid>

								<Thumb x:Name="SwitchThumb"
									   AutomationProperties.AccessibilityView="Raw">
									<Thumb.Template>
										<ControlTemplate TargetType="Thumb">
											<Rectangle Fill="Transparent" />
										</ControlTemplate>
									</Thumb.Template>
								</Thumb>
							</Grid>

							<ContentPresenter x:Name="OffContentPresenter"
											  Grid.Column="1"
											  Margin="{TemplateBinding Padding}"
											  Content="{TemplateBinding OffContent}"
											  ContentTemplate="{TemplateBinding OffContentTemplate}"
											  Foreground="{TemplateBinding Foreground}"
											  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											  AutomationProperties.AccessibilityView="Raw" />
							<ContentPresenter x:Name="OnContentPresenter"
											  Grid.Column="1"
											  Margin="{TemplateBinding Padding}"
											  Content="{TemplateBinding OnContent}"
											  ContentTemplate="{TemplateBinding OnContentTemplate}"
											  Foreground="{TemplateBinding Foreground}"
											  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											  Visibility="Collapsed"
											  AutomationProperties.AccessibilityView="Raw" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ANSI accent variants: Background = bright.<x> (ON track), BorderBrush = normal.<x> (OFF + highlighted knob) -->
	<Style x:Key="OmarchyToggleSwitchBlackStyle"
		   TargetType="ToggleSwitch"
		   BasedOn="{StaticResource OmarchyToggleSwitchStyle}">
		<Setter Property="Background" Value="{ThemeResource OmarchyBrightBlackBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyNormalBlackBrush}" />
	</Style>

	<Style x:Key="OmarchyToggleSwitchWhiteStyle"
		   TargetType="ToggleSwitch"
		   BasedOn="{StaticResource OmarchyToggleSwitchStyle}">
		<Setter Property="Background" Value="{ThemeResource OmarchyBrightWhiteBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyNormalWhiteBrush}" />
	</Style>

	<Style x:Key="OmarchyToggleSwitchRedStyle"
		   TargetType="ToggleSwitch"
		   BasedOn="{StaticResource OmarchyToggleSwitchStyle}">
		<Setter Property="Background" Value="{ThemeResource OmarchyBrightRedBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyNormalRedBrush}" />
	</Style>

	<Style x:Key="OmarchyToggleSwitchGreenStyle"
		   TargetType="ToggleSwitch"
		   BasedOn="{StaticResource OmarchyToggleSwitchStyle}">
		<Setter Property="Background" Value="{ThemeResource OmarchyBrightGreenBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyNormalGreenBrush}" />
	</Style>

	<Style x:Key="OmarchyToggleSwitchYellowStyle"
		   TargetType="ToggleSwitch"
		   BasedOn="{StaticResource OmarchyToggleSwitchStyle}">
		<Setter Property="Background" Value="{ThemeResource OmarchyBrightYellowBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyNormalYellowBrush}" />
	</Style>

	<Style x:Key="OmarchyToggleSwitchBlueStyle"
		   TargetType="ToggleSwitch"
		   BasedOn="{StaticResource OmarchyToggleSwitchStyle}">
		<Setter Property="Background" Value="{ThemeResource OmarchyBrightBlueBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyNormalBlueBrush}" />
	</Style>

	<Style x:Key="OmarchyToggleSwitchMagentaStyle"
		   TargetType="ToggleSwitch"
		   BasedOn="{StaticResource OmarchyToggleSwitchStyle}">
		<Setter Property="Background" Value="{ThemeResource OmarchyBrightMagentaBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyNormalMagentaBrush}" />
	</Style>

	<Style x:Key="OmarchyToggleSwitchCyanStyle"
		   TargetType="ToggleSwitch"
		   BasedOn="{StaticResource OmarchyToggleSwitchStyle}">
		<Setter Property="Background" Value="{ThemeResource OmarchyBrightCyanBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyNormalCyanBrush}" />
	</Style>

</ResourceDictionary>
