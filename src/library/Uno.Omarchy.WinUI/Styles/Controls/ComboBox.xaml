<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Omarchy ComboBox, ported from flutter_omarchy OmarchySelect
		(artifacts/flutter_omarchy/packages/flutter_omarchy/lib/src/widgets/select.dart, which composes
		button.dart, pop_over.dart and tile.dart).

		OmarchyComboBoxStyle (closed control) = OmarchyButton(borderWidth: 0) in the default outline(white)
		style: bright.white text over a normal.white tint layer whose opacity goes 0 -> 0.15 (hover) -> 0.25
		(pressed). Padding 8, no chevron. The popup is an OmarchyPopOverContainer: the background color with
		a 2 px accent border, sharp, no padding, max height 500, at least as wide as the control.
		OmarchyComboBoxItemStyle = OmarchyTile: 56 px high (4 x the 14 px body size), 16 px horizontal padding,
		foreground text; hover paints normal.black at 0.5 (1 when pressed) and turns the text accent
		(selectedText); the selected option is accent + italic with no background.

		Deviations from the source:
		- Focused: the source outline(white) focus visual is a bright border, invisible at borderWidth 0;
		  keyboard focus shows the hover look instead (control and items).
		- Disabled: no source visuals; content is dimmed to OmarchyMutedForegroundOpacity.
		- DropDownGlyph is kept as a collapsed template part; OmarchySelect has no chevron.
		- Header has no source equivalent: body text in foreground (WinUI-only part).
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- Omarchy has a single palette: Light and Default are identical -->
		<ResourceDictionary x:Key="Light">

			<!-- ComboBox (OmarchyButton outline(white), borderWidth 0) -->
			<StaticResource x:Key="ComboBoxForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<!-- Tint source: the template drives the layer's Opacity, never the brush -->
			<StaticResource x:Key="ComboBoxBackground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="ComboBoxPlaceholderForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ComboBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />

			<!-- Popup (OmarchyPopOverContainer) -->
			<StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="OmarchyAccentBrush" />

			<!-- ComboBoxItem (OmarchyTile) -->
			<StaticResource x:Key="ComboBoxItemForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="Default">

			<!-- ComboBox (OmarchyButton outline(white), borderWidth 0) -->
			<StaticResource x:Key="ComboBoxForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ComboBoxBackground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="ComboBoxPlaceholderForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ComboBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />

			<!-- Popup (OmarchyPopOverContainer) -->
			<StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="OmarchyAccentBrush" />

			<!-- ComboBoxItem (OmarchyTile) -->
			<StaticResource x:Key="ComboBoxItemForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- select.dart: maxPopOverHeight defaults to 500 -->
	<x:Double x:Key="OmarchyComboBoxPopupMaxHeight">500</x:Double>
	<!-- Segoe MDL2 / Uno Fluent chevron, only used by the collapsed DropDownGlyph part -->
	<x:String x:Key="OmarchyComboBoxDropDownGlyph">&#xE96E;</x:String>

	<!-- OmarchyComboBoxItemStyle: OmarchyTile (ComboBoxItem* keys) -->
	<Style x:Key="OmarchyComboBoxItemStyle"
		   TargetType="ComboBoxItem">
		<Setter Property="Foreground" Value="{ThemeResource ComboBoxItemForeground}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="MinHeight" Value="{ThemeResource OmarchyTileHeight}" />
		<Setter Property="Padding" Value="{ThemeResource Space400HorizontalThickness}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<!-- Keyboard focus shows the hover look (FocusStates below), not the system focus rectangle -->
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBoxItem">
					<Grid x:Name="LayoutRoot"
						  Background="{TemplateBinding Background}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="HoverLayer.Opacity" Value="{ThemeResource OmarchyTileHoverOpacity}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ComboBoxItemForegroundPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="HoverLayer.Opacity" Value="1" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ComboBoxItemForegroundPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<!-- Selected(isSelected: true) tile: selectedText in theme.text.italic, no background -->
								<VisualState x:Name="Selected">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ComboBoxItemForegroundSelected}" />
										<Setter Target="ContentPresenter.FontFamily" Value="{ThemeResource OmarchyItalicFontFamily}" />
										<Setter Target="ContentPresenter.FontStyle" Value="Italic" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="SelectedUnfocused">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ComboBoxItemForegroundSelected}" />
										<Setter Target="ContentPresenter.FontFamily" Value="{ThemeResource OmarchyItalicFontFamily}" />
										<Setter Target="ContentPresenter.FontStyle" Value="Italic" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="SelectedPointerOver">
									<VisualState.Setters>
										<Setter Target="HoverLayer.Opacity" Value="{ThemeResource OmarchyTileHoverOpacity}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ComboBoxItemForegroundSelected}" />
										<Setter Target="ContentPresenter.FontFamily" Value="{ThemeResource OmarchyItalicFontFamily}" />
										<Setter Target="ContentPresenter.FontStyle" Value="Italic" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="SelectedPressed">
									<VisualState.Setters>
										<Setter Target="HoverLayer.Opacity" Value="1" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ComboBoxItemForegroundSelected}" />
										<Setter Target="ContentPresenter.FontFamily" Value="{ThemeResource OmarchyItalicFontFamily}" />
										<Setter Target="ContentPresenter.FontStyle" Value="Italic" />
									</VisualState.Setters>
								</VisualState>

								<!-- No disabled visuals in the source: dim the content like a disabled outline button -->
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Opacity" Value="{ThemeResource OmarchyMutedForegroundOpacity}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<!-- Keyboard focus = hover -->
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Unfocused" />
								<VisualState x:Name="PointerFocused" />
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="HoverLayer.Opacity" Value="{ThemeResource OmarchyTileHoverOpacity}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ComboBoxItemForegroundPointerOver}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- tile.dart: normal.black at 0 -> 0.5 (hover) -> 1 (pressed) -->
						<Border x:Name="HoverLayer"
								Background="{ThemeResource ComboBoxItemBackgroundPointerOver}"
								Opacity="0"
								IsHitTestVisible="False" />

						<ContentPresenter x:Name="ContentPresenter"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  ContentTransitions="{TemplateBinding ContentTransitions}"
										  Foreground="{TemplateBinding Foreground}"
										  Padding="{TemplateBinding Padding}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- OmarchyComboBoxStyle: OmarchySelect (ComboBox* keys) -->
	<Style x:Key="OmarchyComboBoxStyle"
		   TargetType="ComboBox">
		<Setter Property="Foreground" Value="{ThemeResource ComboBoxForeground}" />
		<Setter Property="Background" Value="{ThemeResource ComboBoxBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ComboBoxBorderBrush}" />
		<!-- OmarchyButton(borderWidth: 0) -->
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="{ThemeResource Space200Thickness}" />
		<Setter Property="MinHeight" Value="{ThemeResource ControlHeightMedium}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="TabNavigation" Value="Once" />
		<!-- Keyboard focus shows the hover look (FocusStates below), not the system focus rectangle -->
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="ItemContainerStyle" Value="{StaticResource OmarchyComboBoxItemStyle}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="TintLayer.Opacity" Value="{ThemeResource OmarchyTintOpacity}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="TintLayer.Opacity" Value="{ThemeResource OmarchyTintOpacityPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<!-- No disabled visuals in the source: dim the content like a disabled outline button -->
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="ContentLayer.Opacity" Value="{ThemeResource OmarchyMutedForegroundOpacity}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<!-- Keyboard focus = hover -->
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Unfocused" />

								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="TintLayer.Opacity" Value="{ThemeResource OmarchyTintOpacity}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="FocusedPressed">
									<VisualState.Setters>
										<Setter Target="TintLayer.Opacity" Value="{ThemeResource OmarchyTintOpacityPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<!-- The button is back to normal once the pop-over is open -->
								<VisualState x:Name="FocusedDropDown" />
							</VisualStateGroup>

							<VisualStateGroup x:Name="DropDownStates">
								<VisualState x:Name="Closed" />
								<VisualState x:Name="Opened" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- Header (no source equivalent) -->
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  FontFamily="{ThemeResource BodyLargeFontFamily}"
										  FontSize="{ThemeResource BodyLargeFontSize}"
										  FontWeight="{ThemeResource BodyLargeFontWeight}"
										  Foreground="{ThemeResource ComboBoxHeaderForeground}"
										  Margin="{ThemeResource Space100BottomThickness}"
										  TextWrapping="Wrap"
										  Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, TargetNullValue=Collapsed, FallbackValue=Collapsed}" />

						<!-- Closed control: OmarchyButton(borderWidth: 0) -->
						<Grid Grid.Row="1"
							  MinHeight="{TemplateBinding MinHeight}">

							<!-- button.dart outline(white): normal.white at 0 -> 0.15 (hover) -> 0.25 (pressed) -->
							<Border x:Name="TintLayer"
									Background="{TemplateBinding Background}"
									Opacity="0" />

							<Border x:Name="BorderElement"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}" />

							<Grid x:Name="ContentLayer"
								  Padding="{TemplateBinding Padding}">

								<ContentPresenter x:Name="ContentPresenter"
												  Content="{TemplateBinding SelectionBoxItem}"
												  ContentTemplate="{TemplateBinding ItemTemplate}"
												  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
												  Foreground="{TemplateBinding Foreground}"
												  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

								<!-- 'Select an option' rendered like any other option, in the button's own foreground -->
								<TextBlock x:Name="PlaceholderTextBlock"
										   Text="{TemplateBinding PlaceholderText}"
										   Foreground="{ThemeResource ComboBoxPlaceholderForeground}"
										   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										   Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibleConverter}, TargetNullValue=Visible, FallbackValue=Visible}"
										   IsHitTestVisible="False" />

								<!-- OmarchySelect has no chevron: the part is kept, collapsed, for the control -->
								<FontIcon x:Name="DropDownGlyph"
										  Glyph="{StaticResource OmarchyComboBoxDropDownGlyph}"
										  FontFamily="{ThemeResource SymbolThemeFontFamily}"
										  FontSize="{ThemeResource IconSizeSmall}"
										  Foreground="{TemplateBinding Foreground}"
										  HorizontalAlignment="Right"
										  VerticalAlignment="Center"
										  Visibility="Collapsed"
										  IsHitTestVisible="False"
										  AutomationProperties.AccessibilityView="Raw" />
							</Grid>
						</Grid>

						<!-- OmarchyPopOverContainer: background surface, 2 px accent border, sharp, no padding -->
						<Popup x:Name="Popup"
							   Grid.Row="1"
							   IsLightDismissEnabled="True"
							   AllowFocusOnInteraction="True">
							<Border x:Name="PopupBorder"
									Background="{ThemeResource ComboBoxDropDownBackground}"
									BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}"
									BorderThickness="{ThemeResource OmarchyBorderThickness}"
									MinWidth="{Binding TemplateSettings.DropDownContentMinWidth, RelativeSource={RelativeSource TemplatedParent}}"
									MaxHeight="{StaticResource OmarchyComboBoxPopupMaxHeight}">
								<ScrollViewer x:Name="ScrollViewer"
											  HorizontalScrollMode="Disabled"
											  HorizontalScrollBarVisibility="Disabled"
											  VerticalScrollMode="Auto"
											  VerticalScrollBarVisibility="Auto"
											  ZoomMode="Disabled"
											  AutomationProperties.AccessibilityView="Raw">
									<ItemsPresenter />
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
