<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:not_win="http://uno.ui/not_win"
					mc:Ignorable="d not_win">

	<!--
		Omarchy CheckBox - reproduces flutter_omarchy lib/src/widgets/checkbox.dart
		(state model: lib/src/widgets/utils/pointer_area.dart, highlighted = isHovering || hasFocus).

		Tint model: one brush per role, states only move element Opacity, so an ANSI accent
		variant is a pure setter style.
		  Foreground  = the label (a sibling Text in the source: it never follows the box state)
		  BorderBrush = the widget's "foreground": highlight border, check glyph, indeterminate square
		  Background  = the fill source when checked (bright.black neutral, normal.<accent> variants)
		  Unchecked box = normal.white border over normal.black fill (fixed keys below).

		checkbox.dart per state:
		  border: highlighted && checked -> foreground x 0.9 | highlighted -> x 0.6 | checked -> x 1 | else normal.white
		  fill:   highlighted -> background x 0.6 | checked -> background | else normal.black
		  neutral background = bright.black (opaque), accent background = normal.<accent> @ 0.4,
		  hence two templates: the accent one fills at 0.4 / 0.24 where the neutral fills at 1 / 0.6.

		Deviations:
		- Pressed = PointerOver: PointerArea tracks isPressed but the checkbox never reads it.
		- Disabled: the source has no disabled visuals; the box is dimmed to OmarchyBorderOpacityDisabled.
		- Unchecked + highlighted keeps the normal.black plate under the 0.6 tint (source tints over the
		  page background) so the box does not vanish against the page.
		- Keyboard focus (hasFocus) is drawn by dedicated FocusFill / FocusBorder layers: FocusStates and
		  CombinedStates are independent groups and two groups driving one Opacity are last-writer-wins.
		  Over a checked box those layers are a no-op, so a focused checked box is not dimmed
		  (source: border x 0.9, fill x 0.6). PointerFocused draws nothing (WinUI convention).
		- Every source transition animates over 120 ms (AnimatedContainer / AnimatedSwitcher);
		  the states below switch instantly (no VisualTransition).
	-->

	<ResourceDictionary.ThemeDictionaries>

		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="CheckBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="CheckBoxBorderBrushUnchecked" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="CheckBoxBackgroundUnchecked" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- Defaults of the BorderBrush / Background channels (the accent variants replace them) -->
			<StaticResource x:Key="CheckBoxBorderBrushChecked" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="CheckBoxBackgroundChecked" ResourceKey="OmarchyMutedBrush" />
			<!-- The glyph is painted with the BorderBrush channel; this key documents the mapping and is not read by the template -->
			<StaticResource x:Key="CheckBoxGlyphForegroundChecked" ResourceKey="OmarchyForegroundBrush" />
		</ResourceDictionary>

		<!-- Omarchy has one palette with a light/dark flag: Light and Default are identical -->
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="CheckBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="CheckBoxBorderBrushUnchecked" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="CheckBoxBackgroundUnchecked" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="CheckBoxBorderBrushChecked" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="CheckBoxBackgroundChecked" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="CheckBoxGlyphForegroundChecked" ResourceKey="OmarchyForegroundBrush" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- checkbox.dart: size = fontSize (14) x 1.2 = 16.8, rounded to an even pixel so the 2 px border sits on whole pixels -->
	<x:Double x:Key="OmarchyCheckBoxSize">18</x:Double>
	<!-- Icon(OmarchyIcons.codCheck) at size x 0.6 = 10.8, as a whole pixel. The path is the repo's check-mark: codicon's hairline check fills under 1 px at this size -->
	<x:Double x:Key="OmarchyCheckBoxGlyphSize">10</x:Double>
	<!-- CheckboxState.multiple: Container(margin: 4) laid out inside the 2 px border -> 6 px inset, 6 px square -->
	<Thickness x:Key="OmarchyCheckBoxIndeterminateMargin">6</Thickness>
	<x:String x:Key="OmarchyCheckBoxCheckGlyphPathData">M28.718018,0L32,3.2819897 10.666016,24.616999 0,13.951997 3.2810059,10.670007 10.666016,18.055033z</x:String>

	<!-- Neutral checkbox (accent: null): fills opaque with bright.black -->
	<Style x:Key="OmarchyCheckBoxStyle"
		   TargetType="CheckBox">
		<Setter Property="Background" Value="{ThemeResource CheckBoxBackgroundChecked}" />
		<Setter Property="Foreground" Value="{ThemeResource CheckBoxForeground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushChecked}" />
		<Setter Property="BorderThickness" Value="{ThemeResource OmarchyBorderThickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource OmarchyCornerRadius}" />
		<!-- The source rows put the label 8 px to the right of the box -->
		<Setter Property="Padding" Value="{ThemeResource Space200LeftThickness}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="{ThemeResource ControlHeightMedium}" />
		<!-- Focus is drawn by the FocusFill / FocusBorder layers -->
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<Grid x:Name="RootGrid"
						  Background="Transparent">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CombinedStates">

								<VisualState x:Name="UncheckedNormal" />
								<VisualState x:Name="UncheckedPointerOver">
									<VisualState.Setters>
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="UncheckedPressed">
									<VisualState.Setters>
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="UncheckedDisabled">
									<VisualState.Setters>
										<Setter Target="CheckBoxContainer.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="CheckedNormal">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="1" />
										<Setter Target="HighlightBorder.Opacity" Value="1" />
										<Setter Target="CheckGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPointerOver">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightSelectedOpacity}" />
										<Setter Target="CheckGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPressed">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightSelectedOpacity}" />
										<Setter Target="CheckGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedDisabled">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="1" />
										<Setter Target="HighlightBorder.Opacity" Value="1" />
										<Setter Target="CheckGlyph.Opacity" Value="1" />
										<Setter Target="CheckBoxContainer.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>

								<!-- CheckboxState.multiple: checked visuals with the square instead of the glyph -->
								<VisualState x:Name="IndeterminateNormal">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="1" />
										<Setter Target="HighlightBorder.Opacity" Value="1" />
										<Setter Target="IndeterminateGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePointerOver">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightSelectedOpacity}" />
										<Setter Target="IndeterminateGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePressed">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightSelectedOpacity}" />
										<Setter Target="IndeterminateGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminateDisabled">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="1" />
										<Setter Target="HighlightBorder.Opacity" Value="1" />
										<Setter Target="IndeterminateGlyph.Opacity" Value="1" />
										<Setter Target="CheckBoxContainer.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>

							</VisualStateGroup>

							<!-- hasFocus is part of "highlighted": keyboard focus looks like hover -->
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="FocusFill.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="FocusBorder.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Unfocused" />
								<VisualState x:Name="PointerFocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- The box: fill layers, then border layers, then the glyphs -->
						<Grid x:Name="CheckBoxContainer"
							  Grid.Column="0"
							  Width="{ThemeResource OmarchyCheckBoxSize}"
							  Height="{ThemeResource OmarchyCheckBoxSize}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center">
							<Border x:Name="UncheckedFill"
									Background="{ThemeResource CheckBoxBackgroundUnchecked}"
									CornerRadius="{TemplateBinding CornerRadius}" />
							<Border x:Name="CheckedFill"
									Background="{TemplateBinding Background}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
							<Border x:Name="FocusFill"
									Background="{TemplateBinding Background}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
							<Border x:Name="UncheckedBorder"
									BorderBrush="{ThemeResource CheckBoxBorderBrushUnchecked}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}" />
							<Border x:Name="HighlightBorder"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
							<Border x:Name="FocusBorder"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
							<Path x:Name="CheckGlyph"
								  Data="{ThemeResource OmarchyCheckBoxCheckGlyphPathData}"
								  Fill="{TemplateBinding BorderBrush}"
								  Stretch="Uniform"
								  Width="{ThemeResource OmarchyCheckBoxGlyphSize}"
								  Height="{ThemeResource OmarchyCheckBoxGlyphSize}"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Opacity="0" />
							<Rectangle x:Name="IndeterminateGlyph"
									   Fill="{TemplateBinding BorderBrush}"
									   Margin="{ThemeResource OmarchyCheckBoxIndeterminateMargin}"
									   Opacity="0" />
						</Grid>

						<ContentPresenter x:Name="ContentPresenter"
										  Grid.Column="1"
										  Margin="{TemplateBinding Padding}"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  ContentTransitions="{TemplateBinding ContentTransitions}"
										  Foreground="{TemplateBinding Foreground}"
										  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										  AutomationProperties.AccessibilityView="Raw"
										  TextWrapping="Wrap" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Accent checkbox (accent: AnsiColor.x): same template, fill at 0.4 (0.24 when highlighted) -->
	<Style x:Key="OmarchyAccentCheckBoxStyle"
		   TargetType="CheckBox"
		   BasedOn="{StaticResource OmarchyCheckBoxStyle}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<Grid x:Name="RootGrid"
						  Background="Transparent">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CombinedStates">

								<VisualState x:Name="UncheckedNormal" />
								<VisualState x:Name="UncheckedPointerOver">
									<VisualState.Setters>
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacityHighlighted}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="UncheckedPressed">
									<VisualState.Setters>
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacityHighlighted}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="UncheckedDisabled">
									<VisualState.Setters>
										<Setter Target="CheckBoxContainer.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="CheckedNormal">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacity}" />
										<Setter Target="HighlightBorder.Opacity" Value="1" />
										<Setter Target="CheckGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPointerOver">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacityHighlighted}" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightSelectedOpacity}" />
										<Setter Target="CheckGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPressed">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacityHighlighted}" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightSelectedOpacity}" />
										<Setter Target="CheckGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedDisabled">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacity}" />
										<Setter Target="HighlightBorder.Opacity" Value="1" />
										<Setter Target="CheckGlyph.Opacity" Value="1" />
										<Setter Target="CheckBoxContainer.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="IndeterminateNormal">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacity}" />
										<Setter Target="HighlightBorder.Opacity" Value="1" />
										<Setter Target="IndeterminateGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePointerOver">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacityHighlighted}" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightSelectedOpacity}" />
										<Setter Target="IndeterminateGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePressed">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacityHighlighted}" />
										<Setter Target="HighlightBorder.Opacity" Value="{ThemeResource OmarchyHighlightSelectedOpacity}" />
										<Setter Target="IndeterminateGlyph.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminateDisabled">
									<VisualState.Setters>
										<Setter Target="UncheckedFill.Opacity" Value="0" />
										<Setter Target="UncheckedBorder.Opacity" Value="0" />
										<Setter Target="CheckedFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacity}" />
										<Setter Target="HighlightBorder.Opacity" Value="1" />
										<Setter Target="IndeterminateGlyph.Opacity" Value="1" />
										<Setter Target="CheckBoxContainer.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>

							</VisualStateGroup>

							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="FocusFill.Opacity" Value="{ThemeResource OmarchyCheckFillOpacityHighlighted}" />
										<Setter Target="FocusBorder.Opacity" Value="{ThemeResource OmarchyHighlightOpacity}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Unfocused" />
								<VisualState x:Name="PointerFocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<Grid x:Name="CheckBoxContainer"
							  Grid.Column="0"
							  Width="{ThemeResource OmarchyCheckBoxSize}"
							  Height="{ThemeResource OmarchyCheckBoxSize}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center">
							<Border x:Name="UncheckedFill"
									Background="{ThemeResource CheckBoxBackgroundUnchecked}"
									CornerRadius="{TemplateBinding CornerRadius}" />
							<Border x:Name="CheckedFill"
									Background="{TemplateBinding Background}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
							<Border x:Name="FocusFill"
									Background="{TemplateBinding Background}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
							<Border x:Name="UncheckedBorder"
									BorderBrush="{ThemeResource CheckBoxBorderBrushUnchecked}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}" />
							<Border x:Name="HighlightBorder"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
							<Border x:Name="FocusBorder"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}"
									Opacity="0" />
							<Path x:Name="CheckGlyph"
								  Data="{ThemeResource OmarchyCheckBoxCheckGlyphPathData}"
								  Fill="{TemplateBinding BorderBrush}"
								  Stretch="Uniform"
								  Width="{ThemeResource OmarchyCheckBoxGlyphSize}"
								  Height="{ThemeResource OmarchyCheckBoxGlyphSize}"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Opacity="0" />
							<Rectangle x:Name="IndeterminateGlyph"
									   Fill="{TemplateBinding BorderBrush}"
									   Margin="{ThemeResource OmarchyCheckBoxIndeterminateMargin}"
									   Opacity="0" />
						</Grid>

						<ContentPresenter x:Name="ContentPresenter"
										  Grid.Column="1"
										  Margin="{TemplateBinding Padding}"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  ContentTransitions="{TemplateBinding ContentTransitions}"
										  Foreground="{TemplateBinding Foreground}"
										  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										  AutomationProperties.AccessibilityView="Raw"
										  TextWrapping="Wrap" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ANSI accent variants: BorderBrush = bright.<x> (glyph / highlight border), Background = normal.<x> (fill) -->
	<Style x:Key="OmarchyCheckBoxBlackStyle"
		   TargetType="CheckBox"
		   BasedOn="{StaticResource OmarchyAccentCheckBoxStyle}">
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyBrightBlackBrush}" />
		<Setter Property="Background" Value="{ThemeResource OmarchyNormalBlackBrush}" />
	</Style>

	<Style x:Key="OmarchyCheckBoxWhiteStyle"
		   TargetType="CheckBox"
		   BasedOn="{StaticResource OmarchyAccentCheckBoxStyle}">
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyBrightWhiteBrush}" />
		<Setter Property="Background" Value="{ThemeResource OmarchyNormalWhiteBrush}" />
	</Style>

	<Style x:Key="OmarchyCheckBoxRedStyle"
		   TargetType="CheckBox"
		   BasedOn="{StaticResource OmarchyAccentCheckBoxStyle}">
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyBrightRedBrush}" />
		<Setter Property="Background" Value="{ThemeResource OmarchyNormalRedBrush}" />
	</Style>

	<Style x:Key="OmarchyCheckBoxGreenStyle"
		   TargetType="CheckBox"
		   BasedOn="{StaticResource OmarchyAccentCheckBoxStyle}">
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyBrightGreenBrush}" />
		<Setter Property="Background" Value="{ThemeResource OmarchyNormalGreenBrush}" />
	</Style>

	<Style x:Key="OmarchyCheckBoxYellowStyle"
		   TargetType="CheckBox"
		   BasedOn="{StaticResource OmarchyAccentCheckBoxStyle}">
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyBrightYellowBrush}" />
		<Setter Property="Background" Value="{ThemeResource OmarchyNormalYellowBrush}" />
	</Style>

	<Style x:Key="OmarchyCheckBoxBlueStyle"
		   TargetType="CheckBox"
		   BasedOn="{StaticResource OmarchyAccentCheckBoxStyle}">
		<Setter Property="BorderBrush" Value="{ThemeResource OmarchyBrightBlueBrush}" />
		<Setter Property="Background" Value="{ThemeResource OmarchyNormalBlueBrush}" />
	</Style>

	<Style x:Key="OmarchyCheckBoxMagentaStyle"
		   TargetType="CheckBox"
		   BasedOn="{StaticResource OmarchyAccentCheckBoxStyle}">
