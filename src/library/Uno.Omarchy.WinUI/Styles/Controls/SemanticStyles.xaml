<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Kept out of the XamlMerge bundle (see omarchy-common.props) and merged by OmarchyTheme as a
		SemanticResources dictionary, so tooling can tell these keys from the Omarchy-prefixed ones.
		The control dictionaries in the bundle reference these keys only through ThemeResource.
	-->

	<!--
		Design-system-agnostic semantic aliases (see doc/semantic-styles.md).
		Controls flutter_omarchy has no widget for (AppBarButton, CommandBar, CalendarView,
		CalendarDatePicker, DatePicker, MediaTransportControls, PipsPager, RatingControl,
		ElevatedButton) are deliberately left unaliased.
	-->

	<!-- Button: filled(blue) / filled(white) / outline(white) / bar(white) -->
	<StaticResource x:Key="FilledButtonStyle" ResourceKey="OmarchyFilledButtonStyle" />
	<StaticResource x:Key="FilledTonalButtonStyle" ResourceKey="OmarchyFilledButtonWhiteStyle" />
	<StaticResource x:Key="OutlinedButtonStyle" ResourceKey="OmarchyOutlinedButtonStyle" />
	<StaticResource x:Key="TextButtonStyle" ResourceKey="OmarchyTextButtonStyle" />
	<StaticResource x:Key="IconButtonStyle" ResourceKey="OmarchyIconButtonStyle" />

	<!-- ToggleButton -->
	<StaticResource x:Key="TextToggleButtonStyle" ResourceKey="OmarchyTextToggleButtonStyle" />
	<StaticResource x:Key="IconToggleButtonStyle" ResourceKey="OmarchyIconToggleButtonStyle" />

	<!-- TextBox: Outlined = OmarchyInputContainer, Filled = bare OmarchyTextInput -->
	<StaticResource x:Key="FilledTextBoxStyle" ResourceKey="OmarchyFilledTextBoxStyle" />
	<StaticResource x:Key="OutlinedTextBoxStyle" ResourceKey="OmarchyOutlinedTextBoxStyle" />

	<!-- PasswordBox -->
	<StaticResource x:Key="FilledPasswordBoxStyle" ResourceKey="OmarchyFilledPasswordBoxStyle" />
	<StaticResource x:Key="OutlinedPasswordBoxStyle" ResourceKey="OmarchyOutlinedPasswordBoxStyle" />

	<!-- ComboBox (OmarchySelect) -->
	<StaticResource x:Key="ComboBoxStyle" ResourceKey="OmarchyComboBoxStyle" />
	<StaticResource x:Key="ComboBoxItemStyle" ResourceKey="OmarchyComboBoxItemStyle" />

	<!-- Selection controls -->
	<StaticResource x:Key="CheckBoxStyle" ResourceKey="OmarchyCheckBoxStyle" />
	<StaticResource x:Key="RadioButtonStyle" ResourceKey="OmarchyRadioButtonStyle" />
	<StaticResource x:Key="ToggleSwitchStyle" ResourceKey="OmarchyToggleSwitchStyle" />
	<StaticResource x:Key="SliderStyle" ResourceKey="OmarchySliderStyle" />

	<!-- HyperlinkButton -->
	<StaticResource x:Key="HyperlinkButtonStyle" ResourceKey="OmarchyHyperlinkButtonStyle" />
	<StaticResource x:Key="SecondaryHyperlinkButtonStyle" ResourceKey="OmarchySecondaryHyperlinkButtonStyle" />

	<!-- ListView (OmarchyTile) -->
	<StaticResource x:Key="ListViewStyle" ResourceKey="OmarchyListViewStyle" />
	<StaticResource x:Key="ListViewItemStyle" ResourceKey="OmarchyListViewItemStyle" />

	<!-- ContentDialog (OmarchyDialog) -->
	<StaticResource x:Key="ContentDialogStyle" ResourceKey="OmarchyContentDialogStyle" />

	<!-- NavigationView -->
	<StaticResource x:Key="NavigationViewStyle" ResourceKey="OmarchyNavigationViewStyle" />
	<StaticResource x:Key="NavigationViewItemStyle" ResourceKey="OmarchyNavigationViewItemStyle" />

	<!-- Progress -->
	<StaticResource x:Key="ProgressBarStyle" ResourceKey="OmarchyProgressBarStyle" />
	<StaticResource x:Key="ProgressRingStyle" ResourceKey="OmarchyProgressRingStyle" />

	<!-- Flyouts (OmarchyPopOver / OmarchyContextMenu) -->
	<StaticResource x:Key="FlyoutPresenterStyle" ResourceKey="OmarchyFlyoutPresenterStyle" />
	<StaticResource x:Key="MenuFlyoutPresenterStyle" ResourceKey="OmarchyMenuFlyoutPresenterStyle" />
	<StaticResource x:Key="MenuFlyoutItemStyle" ResourceKey="OmarchyMenuFlyoutItemStyle" />
	<StaticResource x:Key="MenuFlyoutSeparatorStyle" ResourceKey="OmarchyMenuFlyoutSeparatorStyle" />
	<StaticResource x:Key="MenuFlyoutSubItemStyle" ResourceKey="OmarchyMenuFlyoutSubItemStyle" />
	<StaticResource x:Key="ToggleMenuFlyoutItemStyle" ResourceKey="OmarchyToggleMenuFlyoutItemStyle" />
	<StaticResource x:Key="RadioMenuFlyoutItemStyle" ResourceKey="OmarchyRadioMenuFlyoutItemStyle" />

	<!-- FAB: no floating buttons in Omarchy; the outline icon button is the closest widget -->
	<StaticResource x:Key="FabStyle" ResourceKey="OmarchyIconButtonStyle" />
	<StaticResource x:Key="SmallFabStyle" ResourceKey="OmarchyIconButtonStyle" />
	<StaticResource x:Key="LargeFabStyle" ResourceKey="OmarchyIconButtonStyle" />
	<StaticResource x:Key="SecondaryFabStyle" ResourceKey="OmarchyIconButtonMagentaStyle" />
	<StaticResource x:Key="SecondarySmallFabStyle" ResourceKey="OmarchyIconButtonMagentaStyle" />
	<StaticResource x:Key="SecondaryLargeFabStyle" ResourceKey="OmarchyIconButtonMagentaStyle" />
	<StaticResource x:Key="TertiaryFabStyle" ResourceKey="OmarchyIconButtonCyanStyle" />
	<StaticResource x:Key="TertiarySmallFabStyle" ResourceKey="OmarchyIconButtonCyanStyle" />
	<StaticResource x:Key="TertiaryLargeFabStyle" ResourceKey="OmarchyIconButtonCyanStyle" />
	<StaticResource x:Key="SurfaceFabStyle" ResourceKey="OmarchyIconButtonStyle" />
	<StaticResource x:Key="SurfaceSmallFabStyle" ResourceKey="OmarchyIconButtonStyle" />
	<StaticResource x:Key="SurfaceLargeFabStyle" ResourceKey="OmarchyIconButtonStyle" />

	<!-- Typography -->
	<StaticResource x:Key="DisplayLarge" ResourceKey="OmarchyDisplayLarge" />
	<StaticResource x:Key="DisplayMedium" ResourceKey="OmarchyDisplayMedium" />
	<StaticResource x:Key="DisplaySmall" ResourceKey="OmarchyDisplaySmall" />
	<StaticResource x:Key="HeadlineLarge" ResourceKey="OmarchyHeadlineLarge" />
	<StaticResource x:Key="HeadlineMedium" ResourceKey="OmarchyHeadlineMedium" />
	<StaticResource x:Key="HeadlineSmall" ResourceKey="OmarchyHeadlineSmall" />
	<StaticResource x:Key="TitleLarge" ResourceKey="OmarchyTitleLarge" />
	<StaticResource x:Key="TitleMedium" ResourceKey="OmarchyTitleMedium" />
	<StaticResource x:Key="TitleSmall" ResourceKey="OmarchyTitleSmall" />
	<StaticResource x:Key="BodyLarge" ResourceKey="OmarchyBodyLarge" />
	<StaticResource x:Key="BodyMedium" ResourceKey="OmarchyBodyMedium" />
	<StaticResource x:Key="BodySmall" ResourceKey="OmarchyBodySmall" />
	<StaticResource x:Key="LabelLarge" ResourceKey="OmarchyLabelLarge" />
	<StaticResource x:Key="LabelMedium" ResourceKey="OmarchyLabelMedium" />
	<StaticResource x:Key="LabelSmall" ResourceKey="OmarchyLabelSmall" />
	<StaticResource x:Key="LabelExtraSmall" ResourceKey="OmarchyLabelExtraSmall" />
	<StaticResource x:Key="CaptionLarge" ResourceKey="OmarchyCaptionLarge" />
	<StaticResource x:Key="CaptionMedium" ResourceKey="OmarchyCaptionMedium" />
	<StaticResource x:Key="CaptionSmall" ResourceKey="OmarchyCaptionSmall" />

	<!-- Flyout.xaml lightweight resources -->
	<StaticResource x:Key="FlyoutPresenterBorderThickness" ResourceKey="OmarchyBorderThickness" />

	<!-- HyperlinkButton.xaml lightweight resources -->
	<x:Boolean x:Key="HyperlinkUnderlineVisible">True</x:Boolean>

	<!-- NavigationView.xaml lightweight resources -->
	<!-- Compact rail = tile padding + icon + padding (16 + 22 + 16) so the icon is centered in it -->
	<x:Double x:Key="NavigationViewCompactPaneLength">54</x:Double>
	<!-- Read by the NavigationView code (application resources): width reserved for the hamburger in the pane header row -->
	<x:Double x:Key="PaneToggleButtonWidth">54</x:Double>
	<!-- Read by the NavigationView code (application resources): pane header row min height = OmarchyTileHeight -->
	<x:Double x:Key="PaneToggleButtonHeight">56</x:Double>

	<ResourceDictionary.ThemeDictionaries>

		<!-- One palette feeds both theme dictionaries (see specs/08-omarchy-theme/progress.md): identical content. -->
		<ResourceDictionary x:Key="Light">

			<!-- Button.xaml lightweight resources -->
			<!-- filled(blue) -->
			<StaticResource x:Key="FilledButtonBackground" ResourceKey="OmarchyNormalBlueBrush" />
			<StaticResource x:Key="FilledButtonForeground" ResourceKey="OmarchyBrightBlueBrush" />
			<StaticResource x:Key="FilledButtonBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<!-- filled(white) -->
			<StaticResource x:Key="FilledTonalButtonBackground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="FilledTonalButtonForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="FilledTonalButtonBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<!-- outline(white) -->
			<StaticResource x:Key="OutlinedButtonBackground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="OutlinedButtonForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="OutlinedButtonBorderBrush" ResourceKey="OmarchyNormalWhiteBrush" />
			<!-- bar(white) -->
			<StaticResource x:Key="TextButtonBackground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="TextButtonForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<!-- outline(white) with an icon child -->
			<StaticResource x:Key="IconButtonBackground" ResourceKey="OutlinedButtonBackground" />
			<StaticResource x:Key="IconButtonForeground" ResourceKey="OutlinedButtonForeground" />
			<StaticResource x:Key="IconButtonBorderBrush" ResourceKey="OutlinedButtonBorderBrush" />

			<!-- CheckBox.xaml lightweight resources -->
			<StaticResource x:Key="CheckBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="CheckBoxBorderBrushUnchecked" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="CheckBoxBackgroundUnchecked" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- Defaults of the BorderBrush / Background channels (the accent variants replace them) -->
			<StaticResource x:Key="CheckBoxBorderBrushChecked" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="CheckBoxBackgroundChecked" ResourceKey="OmarchyMutedBrush" />
			<!-- The glyph is painted with the BorderBrush channel; this key documents the mapping and is not read by the template -->
			<StaticResource x:Key="CheckBoxGlyphForegroundChecked" ResourceKey="OmarchyForegroundBrush" />

			<!-- ComboBox.xaml lightweight resources -->
			<!-- ComboBox (OmarchyButton outline(white), borderWidth 0) -->
			<StaticResource x:Key="ComboBoxForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<!-- Tint source: the template drives the layer's Opacity, never the brush -->
			<StaticResource x:Key="ComboBoxBackground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="ComboBoxPlaceholderForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ComboBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<!-- Popup (OmarchyPopOverContainer) -->
			<StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="OmarchyAccentBrush" />
			<!-- ComboBoxItem (OmarchyTile) -->
			<StaticResource x:Key="ComboBoxItemForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="OmarchyNormalBlackBrush" />

			<!-- ContentDialog.xaml lightweight resources -->
			<StaticResource x:Key="ContentDialogBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="ContentDialogForeground" ResourceKey="OmarchyForegroundBrush" />
			<!-- theme.colors.border -->
			<StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ContentDialogTitleForeground" ResourceKey="OmarchyForegroundBrush" />
			<!-- OmarchyDivider: normal.black -->
			<StaticResource x:Key="ContentDialogDividerBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- showOmarchyDialog barrierColor -->
			<SolidColorBrush x:Key="ContentDialogSmokeFill"
							 Color="#66000000" />

			<!-- Flyout.xaml lightweight resources -->
			<StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="OmarchyBackgroundBrush" />
			<!-- theme.colors.border -->
			<StaticResource x:Key="FlyoutPresenterBorderBrush" ResourceKey="OmarchyAccentBrush" />

			<!-- HyperlinkButton.xaml lightweight resources -->
			<!-- bar(blue) -->
			<StaticResource x:Key="HyperlinkButtonBackground" ResourceKey="OmarchyNormalBlueBrush" />
			<StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="OmarchyBrightBlueBrush" />
			<!-- bar(white), plain foreground -->
			<StaticResource x:Key="SecondaryHyperlinkButtonBackground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="SecondaryHyperlinkButtonForeground" ResourceKey="OmarchyForegroundBrush" />

			<!-- ListView.xaml lightweight resources -->
			<StaticResource x:Key="ListViewBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="ListViewItemBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="ListViewItemForeground" ResourceKey="OmarchyForegroundBrush" />
			<!-- lighter_background hover layer; opacity comes from OmarchyTileHoverOpacity (hover) / 1 (pressed) -->
			<StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- selectedText -->
			<StaticResource x:Key="ListViewItemForegroundPointerOver" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ListViewItemForegroundDisabled" ResourceKey="OmarchyMutedBrush" />

			<!-- MenuFlyout.xaml lightweight resources -->
			<!-- Presenter (container) -->
			<StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="OmarchyAccentBrush" />
			<!-- Item -->
			<StaticResource x:Key="MenuFlyoutItemBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="OmarchyForegroundBrush" />
			<!-- lighter_background hover layer -->
			<StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- selectedText -->
			<StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="OmarchyMutedBrush" />
			<!-- Sub-menu chevron, toggle check mark / radio bullet -->
			<StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="ToggleMenuFlyoutItemCheckGlyphForeground" ResourceKey="OmarchyAccentBrush" />
			<!-- Separator (OmarchyDivider) -->
			<StaticResource x:Key="MenuFlyoutSeparatorBackground" ResourceKey="OmarchyNormalBlackBrush" />

			<!-- NavigationView.xaml lightweight resources -->
			<!-- Pane, content and top pane surfaces (scaffold.dart: theme.colors.background) -->
			<StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="NavigationViewContentBackground" ResourceKey="OmarchyBackgroundBrush" />
			<!-- Dividers: panel / content split, navigation bar bottom border, item separators (normal.black) -->
			<StaticResource x:Key="NavigationViewDividerBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="NavigationViewItemSeparatorForeground" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="TopNavigationViewItemSeparatorForeground" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- Titles (navigation_bar.dart: theme.text.bold in theme.colors.foreground) and group headers (muted) -->
			<StaticResource x:Key="NavigationViewPaneTitleForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="NavigationViewHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="NavigationViewItemHeaderForeground" ResourceKey="OmarchyMutedBrush" />
			<!-- Bar buttons (button.dart bar style): bright.white glyph, normal.white tint; accent focus stroke -->
			<StaticResource x:Key="NavigationViewButtonForeground" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="NavigationViewButtonBackground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="NavigationViewFocusVisualBrush" ResourceKey="OmarchyAccentBrush" />
			<!-- Items (tile.dart). Background is the hover / pressed surface: its rest opacity is 0 -->
			<StaticResource x:Key="NavigationViewItemForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="NavigationViewItemIconForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="NavigationViewItemBackground" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="OmarchyAccentBrush" />

			<!-- PasswordBox.xaml lightweight resources -->
			<!-- OutlinedPasswordBox (OmarchyInputContainer) -->
			<StaticResource x:Key="OutlinedPasswordBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrushPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrushFocused" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderThickness" ResourceKey="OmarchyBorderThickness" />
			<StaticResource x:Key="OutlinedPasswordBoxPadding" ResourceKey="Space200Thickness" />
			<!-- FilledPasswordBox (bare OmarchyTextInput) -->
			<StaticResource x:Key="FilledPasswordBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledPasswordBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="FilledPasswordBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledPasswordBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<Thickness x:Key="FilledPasswordBoxBorderThickness">0</Thickness>
			<StaticResource x:Key="FilledPasswordBoxPadding" ResourceKey="Space200VerticalThickness" />

			<!-- ProgressBar.xaml lightweight resources -->
			<StaticResource x:Key="ProgressBarForeground" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ProgressBarBackground" ResourceKey="OmarchyNormalBlackBrush" />

			<!-- ProgressRing.xaml lightweight resources -->
			<StaticResource x:Key="ProgressRingForeground" ResourceKey="OmarchyForegroundBrush" />

			<!-- RadioButton.xaml lightweight resources -->
			<StaticResource x:Key="RadioButtonForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="RadioButtonBorderBrushUnchecked" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="RadioButtonBackgroundUnchecked" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- Defaults of the BorderBrush / Background channels (the accent variants replace them) -->
			<StaticResource x:Key="RadioButtonBorderBrushChecked" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="RadioButtonBackgroundChecked" ResourceKey="OmarchyMutedBrush" />
			<!-- The dot is painted with the BorderBrush channel; this key documents the mapping and is not read by the template -->
			<StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="OmarchyForegroundBrush" />

			<!-- Slider.xaml lightweight resources -->
			<StaticResource x:Key="SliderForeground" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="SliderTrackFill" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="SliderTrackValueFillDisabled" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="SliderThumbBackgroundDisabled" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="SliderHeaderForeground" ResourceKey="OmarchyForegroundBrush" />

			<!-- TextBlock.xaml lightweight resources -->
			<StaticResource x:Key="TextBlockForeground" ResourceKey="OmarchyForegroundBrush" />

			<!-- TextBox.xaml lightweight resources -->
			<!-- OutlinedTextBox (OmarchyInputContainer) -->
			<StaticResource x:Key="OutlinedTextBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedTextBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrushPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrushFocused" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="OutlinedTextBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="OutlinedTextBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedTextBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderThickness" ResourceKey="OmarchyBorderThickness" />
			<StaticResource x:Key="OutlinedTextBoxPadding" ResourceKey="Space200Thickness" />
			<!-- FilledTextBox (bare OmarchyTextInput) -->
			<StaticResource x:Key="FilledTextBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledTextBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="FilledTextBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledTextBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<Thickness x:Key="FilledTextBoxBorderThickness">0</Thickness>
			<StaticResource x:Key="FilledTextBoxPadding" ResourceKey="Space200VerticalThickness" />

			<!-- ToggleButton.xaml lightweight resources -->
			<!-- Unchecked -->
			<StaticResource x:Key="TextToggleButtonBackground" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="TextToggleButtonForeground" ResourceKey="OmarchyNormalWhiteBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundPointerOver" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundPointerOver" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundPressed" ResourceKey="TextToggleButtonBackgroundPointerOver" />
			<StaticResource x:Key="TextToggleButtonForegroundPressed" ResourceKey="TextToggleButtonForegroundPointerOver" />
			<!-- Checked (isActive) -->
			<StaticResource x:Key="TextToggleButtonBackgroundChecked" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundChecked" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundCheckedPointerOver" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="TextToggleButtonForegroundCheckedPointerOver" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="TextToggleButtonBackgroundCheckedPressed" ResourceKey="TextToggleButtonBackgroundCheckedPointerOver" />
			<StaticResource x:Key="TextToggleButtonForegroundCheckedPressed" ResourceKey="TextToggleButtonForegroundCheckedPointerOver" />
			<!-- IconToggleButton aliases -->
			<StaticResource x:Key="IconToggleButtonBackground" ResourceKey="TextToggleButtonBackground" />
			<StaticResource x:Key="IconToggleButtonForeground" ResourceKey="TextToggleButtonForeground" />
			<StaticResource x:Key="IconToggleButtonBackgroundPointerOver" ResourceKey="TextToggleButtonBackgroundPointerOver" />
			<StaticResource x:Key="IconToggleButtonForegroundPointerOver" ResourceKey="TextToggleButtonForegroundPointerOver" />
			<StaticResource x:Key="IconToggleButtonBackgroundPressed" ResourceKey="TextToggleButtonBackgroundPressed" />
			<StaticResource x:Key="IconToggleButtonForegroundPressed" ResourceKey="TextToggleButtonForegroundPressed" />
			<StaticResource x:Key="IconToggleButtonBackgroundChecked" ResourceKey="TextToggleButtonBackgroundChecked" />
			<StaticResource x:Key="IconToggleButtonForegroundChecked" ResourceKey="TextToggleButtonForegroundChecked" />
			<StaticResource x:Key="IconToggleButtonBackgroundCheckedPointerOver" ResourceKey="TextToggleButtonBackgroundCheckedPointerOver" />
			<StaticResource x:Key="IconToggleButtonForegroundCheckedPointerOver" ResourceKey="TextToggleButtonForegroundCheckedPointerOver" />
			<StaticResource x:Key="IconToggleButtonBackgroundCheckedPressed" ResourceKey="TextToggleButtonBackgroundCheckedPressed" />
			<StaticResource x:Key="IconToggleButtonForegroundCheckedPressed" ResourceKey="TextToggleButtonForegroundCheckedPressed" />

			<!-- ToggleSwitch.xaml lightweight resources -->
			<StaticResource x:Key="ToggleSwitchForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- Default of the Background channel (the accent variants replace it) -->
			<StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="OmarchyBrightWhiteBrush" />
			<StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="OmarchyNormalWhiteBrush" />
			<!-- Default of the BorderBrush channel (the accent variants replace it) -->
			<StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="OmarchyNormalBlackBrush" />

			<!-- ToolTip.xaml lightweight resources -->
			<StaticResource x:Key="ToolTipBackground" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="ToolTipForeground" ResourceKey="OmarchyBrightWhiteBrush" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="Default">

			<!-- Button.xaml lightweight resources -->
			<!-- filled(blue) -->
			<StaticResource x:Key="FilledButtonBackground" ResourceKey="OmarchyNormalBlueBrush" />
			<StaticResource x:Key="FilledButtonForeground" ResourceKey="OmarchyBrightBlueBrush" />
			<StaticResource x:Key="FilledButtonBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<!-- filled(white) -->
