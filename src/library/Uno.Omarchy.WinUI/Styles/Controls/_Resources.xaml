<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

	<!-- Implicit styles: the flutter_omarchy widget defaults (outline(white) button, neutral checkbox, ...) -->
	<Style BasedOn="{StaticResource OmarchyOutlinedButtonStyle}"
		   TargetType="Button" />
	<Style BasedOn="{StaticResource OmarchyCheckBoxStyle}"
		   TargetType="CheckBox" />
	<Style BasedOn="{StaticResource OmarchyComboBoxStyle}"
		   TargetType="ComboBox" />
	<Style BasedOn="{StaticResource OmarchyComboBoxItemStyle}"
		   TargetType="ComboBoxItem" />
	<Style BasedOn="{StaticResource OmarchyRadioButtonStyle}"
		   TargetType="RadioButton" />
	<Style BasedOn="{StaticResource OmarchyOutlinedTextBoxStyle}"
		   TargetType="TextBox" />
	<Style BasedOn="{StaticResource OmarchyToggleSwitchStyle}"
		   TargetType="ToggleSwitch" />
	<Style BasedOn="{StaticResource OmarchyOutlinedPasswordBoxStyle}"
		   TargetType="PasswordBox" />
	<Style BasedOn="{StaticResource OmarchySliderStyle}"
		   TargetType="Slider" />
	<Style BasedOn="{StaticResource OmarchyToolTipStyle}"
		   TargetType="ToolTip" />
	<Style BasedOn="{StaticResource OmarchyBaseTextBlockStyle}"
		   TargetType="TextBlock" />

	<!-- ListView + ListViewItem (OmarchyTile) -->
	<Style BasedOn="{StaticResource OmarchyListViewItemStyle}"
		   TargetType="ListViewItem" />
	<Style BasedOn="{StaticResource OmarchyListViewStyle}"
		   TargetType="ListView" />

	<!-- ContentDialog (OmarchyDialog) -->
	<Style BasedOn="{StaticResource OmarchyContentDialogStyle}"
		   TargetType="ContentDialog" />

	<!-- MenuFlyout items (OmarchyContextMenu) -->
	<Style BasedOn="{StaticResource OmarchyMenuFlyoutItemStyle}"
		   TargetType="MenuFlyoutItem" />
	<Style BasedOn="{StaticResource OmarchyMenuFlyoutPresenterStyle}"
		   TargetType="MenuFlyoutPresenter" />
	<Style BasedOn="{StaticResource OmarchyMenuFlyoutSeparatorStyle}"
		   TargetType="MenuFlyoutSeparator" />
	<Style BasedOn="{StaticResource OmarchyMenuFlyoutSubItemStyle}"
		   TargetType="MenuFlyoutSubItem" />
	<Style BasedOn="{StaticResource OmarchyToggleMenuFlyoutItemStyle}"
		   TargetType="ToggleMenuFlyoutItem" />

	<!-- ToggleButton (OmarchyTab) -->
	<Style BasedOn="{StaticResource OmarchyTextToggleButtonStyle}"
		   TargetType="ToggleButton" />

	<!-- FlyoutPresenter (OmarchyPopOverContainer) -->
	<Style BasedOn="{StaticResource OmarchyFlyoutPresenterStyle}"
		   TargetType="FlyoutPresenter" />

	<!-- HyperlinkButton -->
	<Style BasedOn="{StaticResource OmarchyHyperlinkButtonStyle}"
		   TargetType="HyperlinkButton" />

	<!-- NavigationView (OmarchyScaffold side panel + OmarchyTile) -->
	<Style BasedOn="{StaticResource OmarchyNavigationViewStyle}"
		   TargetType="muxc:NavigationView" />
	<Style BasedOn="{StaticResource OmarchyNavigationViewItemStyle}"
		   TargetType="muxc:NavigationViewItem" />

	<!-- ProgressBar / ProgressRing (OmarchyProgressBar / OmarchyLoader) -->
	<Style BasedOn="{StaticResource OmarchyProgressBarStyle}"
		   TargetType="muxc:ProgressBar" />
	<Style BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing" />

	<!-- RadioMenuFlyoutItem -->
	<Style BasedOn="{StaticResource OmarchyRadioMenuFlyoutItemStyle}"
		   TargetType="muxc:RadioMenuFlyoutItem" />

</ResourceDictionary>
