<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					mc:Ignorable="">

	<!--
		Omarchy — ContentDialog
		Reproduces flutter_omarchy widgets/dialog.dart (OmarchyDialog / showOmarchyDialog) and
		widgets/divider.dart (the title divider).

		Dialog: background surface with a 2 px border in theme.colors.border (= accent), sharp
		corners, max width 480, padding 16 around the title, the content and the actions. The
		title is the bold face in the foreground color, followed by a full-width 1 px
		normal.black divider (both only when a title is set); the content is body text; the
		actions are right-aligned with an 8 px gap. showOmarchyDialog's barrier is #66000000.

		Actions: the source's confirm dialog pairs filled(accent) for confirm with the default
		outline(white) button for cancel, so PrimaryButton is OmarchyFilledButtonStyle and the
		Secondary / Close buttons are OmarchyOutlinedButtonStyle. The button roles are fixed by
		the style; DefaultButtonStates are kept but do not restyle the buttons.

		Deviations:
		- MinWidth 288 (the WinUI default): the source stretches the dialog to its max width,
		  a WinUI dialog sizes to its content.
		- Edge margin 16 keeps the dialog off the window edges on narrow screens; the source
		  has none (it is centered in the barrier).
		- No fade / scale entrance (120 ms in the source): the theme omits generated durations.
		- The per-dialog accent border has no WinUI counterpart: set BorderBrush on the dialog.
	-->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Lightweight styling ThemeResource aliases -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<ResourceDictionary.ThemeDictionaries>

		<!-- ─── Light (one palette, both dictionaries) ─── -->
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="ContentDialogBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="ContentDialogForeground" ResourceKey="OmarchyForegroundBrush" />
			<!-- theme.colors.border -->
			<StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ContentDialogTitleForeground" ResourceKey="OmarchyForegroundBrush" />
			<!-- OmarchyDivider: normal.black -->
			<StaticResource x:Key="ContentDialogDividerBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<!-- showOmarchyDialog barrierColor -->
			<SolidColorBrush x:Key="ContentDialogSmokeFill"
							 Color="#66000000" />
		</ResourceDictionary>

		<!-- ─── Default ─── -->
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="ContentDialogBackground" ResourceKey="OmarchyBackgroundBrush" />
			<StaticResource x:Key="ContentDialogForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="ContentDialogTitleForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="ContentDialogDividerBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<SolidColorBrush x:Key="ContentDialogSmokeFill"
							 Color="#66000000" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- Sizing / layout constants -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- dialog.dart: maxWidth = 480; the min width is the WinUI default (the source has none) -->
	<x:Double x:Key="OmarchyContentDialogMinWidth">288</x:Double>
	<x:Double x:Key="OmarchyContentDialogMaxWidth">480</x:Double>
	<!-- dialog.dart: padding = EdgeInsets.all(16), applied to the title, the content and the actions separately -->
	<StaticResource x:Key="OmarchyContentDialogPadding" ResourceKey="Space400Thickness" />
	<StaticResource x:Key="OmarchyContentDialogEdgeMargin" ResourceKey="Space400Thickness" />
	<!-- Actions row spacing 8 (Space200) as a GridLength for the spacer columns -->
	<GridLength x:Key="OmarchyContentDialogButtonSpacing">8</GridLength>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- ContentDialog Style (OmarchyDialog) -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<Style x:Key="OmarchyContentDialogStyle"
		   TargetType="ContentDialog">

		<Setter Property="Background" Value="{ThemeResource ContentDialogBackground}" />
		<Setter Property="Foreground" Value="{ThemeResource ContentDialogForeground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ContentDialogBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource OmarchyBorderThickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource OmarchyCornerRadius}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />

		<!-- Defined in Button.xaml: confirm = filled(accent), cancel = outline(white) -->
		<Setter Property="PrimaryButtonStyle" Value="{ThemeResource OmarchyFilledButtonStyle}" />
		<Setter Property="SecondaryButtonStyle" Value="{ThemeResource OmarchyOutlinedButtonStyle}" />
		<Setter Property="CloseButtonStyle" Value="{ThemeResource OmarchyOutlinedButtonStyle}" />

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ContentDialog">
					<Border x:Name="Container">

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="DialogShowingStates">
								<VisualState x:Name="DialogHidden" />
								<VisualState x:Name="DialogShowing">
									<VisualState.Setters>
										<Setter Target="PrimaryButton.IsTabStop" Value="True" />
										<Setter Target="SecondaryButton.IsTabStop" Value="True" />
										<Setter Target="CloseButton.IsTabStop" Value="True" />
										<Setter Target="LayoutRoot.Visibility" Value="Visible" />
										<Setter Target="BackgroundElement.TabFocusNavigation" Value="Cycle" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="DialogShowingWithoutSmokeLayer">
									<VisualState.Setters>
										<Setter Target="PrimaryButton.IsTabStop" Value="True" />
										<Setter Target="SecondaryButton.IsTabStop" Value="True" />
										<Setter Target="CloseButton.IsTabStop" Value="True" />
										<Setter Target="LayoutRoot.Visibility" Value="Visible" />
										<Setter Target="SmokeLayerBackground.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="DialogSizingStates">
								<VisualState x:Name="DefaultDialogSizing" />
								<VisualState x:Name="FullDialogSizing" />
							</VisualStateGroup>

							<VisualStateGroup x:Name="ButtonsVisibilityStates">
								<VisualState x:Name="AllVisible" />
								<VisualState x:Name="NoneVisible">
									<VisualState.Setters>
										<Setter Target="CommandSpace.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PrimaryVisible">
									<VisualState.Setters>
										<Setter Target="FirstSpacer.Width" Value="0" />
										<Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
										<Setter Target="SecondSpacer.Width" Value="0" />
										<Setter Target="CloseButton.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="SecondaryVisible">
									<VisualState.Setters>
										<Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
										<Setter Target="FirstSpacer.Width" Value="0" />
										<Setter Target="SecondSpacer.Width" Value="0" />
										<Setter Target="CloseButton.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CloseVisible">
									<VisualState.Setters>
										<Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
										<Setter Target="FirstSpacer.Width" Value="0" />
										<Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
										<Setter Target="SecondSpacer.Width" Value="0" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PrimaryAndSecondaryVisible">
									<VisualState.Setters>
										<Setter Target="SecondSpacer.Width" Value="0" />
										<Setter Target="CloseButton.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PrimaryAndCloseVisible">
									<VisualState.Setters>
										<Setter Target="FirstSpacer.Width" Value="0" />
										<Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="SecondaryAndCloseVisible">
									<VisualState.Setters>
										<Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
										<Setter Target="FirstSpacer.Width" Value="0" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<!-- The button roles are fixed by PrimaryButtonStyle / SecondaryButtonStyle / CloseButtonStyle -->
							<VisualStateGroup x:Name="DefaultButtonStates">
								<VisualState x:Name="NoDefaultButton" />
								<VisualState x:Name="PrimaryAsDefaultButton" />
								<VisualState x:Name="SecondaryAsDefaultButton" />
								<VisualState x:Name="CloseAsDefaultButton" />
							</VisualStateGroup>

							<VisualStateGroup x:Name="DialogBorderStates" />
						</VisualStateManager.VisualStateGroups>

						<Grid x:Name="LayoutRoot">
							<!-- showOmarchyDialog barrier -->
							<Rectangle x:Name="SmokeLayerBackground"
									   Fill="{ThemeResource ContentDialogSmokeFill}" />

							<Border x:Name="BackgroundElement"
									Background="{TemplateBinding Background}"
									BackgroundSizing="InnerBorderEdge"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}"
									FlowDirection="{TemplateBinding FlowDirection}"
									MaxWidth="{ThemeResource OmarchyContentDialogMaxWidth}"
									Margin="{ThemeResource OmarchyContentDialogEdgeMargin}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center">

								<Grid>
									<Border x:Name="MinSizeHolder"
											MinWidth="{ThemeResource OmarchyContentDialogMinWidth}" />

									<Grid x:Name="DialogSpace">

										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<!-- Title + full-width divider, only when a title is set (dialog.dart) -->
										<Grid Grid.Row="0"
											  Visibility="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">

											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<ContentControl x:Name="Title"
															Grid.Row="0"
															Content="{TemplateBinding Title}"
															ContentTemplate="{TemplateBinding TitleTemplate}"
															Foreground="{ThemeResource ContentDialogTitleForeground}"
															FontFamily="{ThemeResource TitleMediumFontFamily}"
															FontSize="{ThemeResource TitleMediumFontSize}"
															FontWeight="{ThemeResource TitleMediumFontWeight}"
															Margin="{ThemeResource OmarchyContentDialogPadding}"
															HorizontalAlignment="Left"
															VerticalAlignment="Top"
															IsTabStop="False">
												<ContentControl.Template>
													<ControlTemplate TargetType="ContentControl">
														<ContentPresenter Content="{TemplateBinding Content}"
																		  ContentTemplate="{TemplateBinding ContentTemplate}"
																		  ContentTransitions="{TemplateBinding ContentTransitions}"
																		  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
																		  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
																		  MaxLines="2"
																		  TextWrapping="Wrap"
																		  Margin="{TemplateBinding Padding}" />
													</ControlTemplate>
												</ContentControl.Template>
											</ContentControl>

											<!-- OmarchyDivider.horizontal() -->
											<Rectangle Grid.Row="1"
													   Height="{ThemeResource OmarchyDividerWidth}"
													   Fill="{ThemeResource ContentDialogDividerBrush}" />
										</Grid>

										<!-- Content (scrollable; the padding scrolls with it, as in the source) -->
										<ScrollViewer x:Name="ContentScrollViewer"
													  Grid.Row="1"
													  HorizontalScrollBarVisibility="Disabled"
													  VerticalScrollBarVisibility="Disabled"
													  ZoomMode="Disabled"
													  IsTabStop="False">
											<ContentPresenter x:Name="Content"
															  Content="{TemplateBinding Content}"
															  ContentTemplate="{TemplateBinding ContentTemplate}"
															  Foreground="{TemplateBinding Foreground}"
															  FontFamily="{TemplateBinding FontFamily}"
															  FontSize="{TemplateBinding FontSize}"
															  FontWeight="{TemplateBinding FontWeight}"
															  Margin="{ThemeResource OmarchyContentDialogPadding}"
															  TextWrapping="Wrap" />
										</ScrollViewer>

										<!-- Actions: right-aligned, 8 px apart -->
										<Grid x:Name="CommandSpace"
											  Grid.Row="2"
											  Margin="{ThemeResource OmarchyContentDialogPadding}"
											  HorizontalAlignment="Right"
											  VerticalAlignment="Bottom"
											  XYFocusKeyboardNavigation="Enabled">

											<Grid.ColumnDefinitions>
												<ColumnDefinition x:Name="CloseColumn"
																  Width="Auto" />
												<ColumnDefinition x:Name="SecondSpacer"
																  Width="{StaticResource OmarchyContentDialogButtonSpacing}" />
												<ColumnDefinition x:Name="SecondaryColumn"
																  Width="Auto" />
												<ColumnDefinition x:Name="FirstSpacer"
																  Width="{StaticResource OmarchyContentDialogButtonSpacing}" />
												<ColumnDefinition x:Name="PrimaryColumn"
																  Width="Auto" />
											</Grid.ColumnDefinitions>

											<Button x:Name="CloseButton"
													Grid.Column="0"
													Content="{TemplateBinding CloseButtonText}"
													IsTabStop="False"
													ElementSoundMode="FocusOnly"
													Style="{TemplateBinding CloseButtonStyle}" />

											<Button x:Name="SecondaryButton"
													Grid.Column="2"
													Content="{TemplateBinding SecondaryButtonText}"
													IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
													IsTabStop="False"
													ElementSoundMode="FocusOnly"
													Style="{TemplateBinding SecondaryButtonStyle}" />

											<Button x:Name="PrimaryButton"
													Grid.Column="4"
													Content="{TemplateBinding PrimaryButtonText}"
													IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
													IsTabStop="False"
													ElementSoundMode="FocusOnly"
													Style="{TemplateBinding PrimaryButtonStyle}" />
										</Grid>
									</Grid>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
