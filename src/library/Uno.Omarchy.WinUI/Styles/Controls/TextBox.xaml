<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Omarchy TextBox, ported from flutter_omarchy
		(artifacts/flutter_omarchy/packages/flutter_omarchy/lib/src/widgets/input_container.dart and text_input.dart).

		OmarchyOutlinedTextBoxStyle = OmarchyInputContainer + OmarchyTextInput: a 2 px border that is
		normal.black at rest and the accent (theme.colors.border) when focused, 8 px padding all around.
		The source stacks a 1 px normal.white border under the 2 px focus overlay; the overlay covers it
		entirely, so a single 2 px border is the visible result.
		OmarchyFilledTextBoxStyle = bare OmarchyTextInput: no border, no background, the widget's default
		EdgeInsets.symmetric(vertical: 8) padding.

		Text is theme.text.normal in foreground, the placeholder is bright.black (muted) and the selection
		is theme.colors.selectedText.

		Deviations from the source:
		- No hover visuals (none in the source either); the *PointerOver keys only exist for lightweight styling.
		- Disabled: the source has no disabled visuals; the whole control is dimmed to OmarchyBorderOpacityDisabled.
		- Caret: cursorColor = selectedText (accent) cannot be expressed, WinUI has no caret brush.
		- Header and DeleteButton have no source equivalent (WinUI-only parts): header = body text in
		  foreground, delete button = a muted glyph that turns accent on hover, no background, no border.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- Omarchy has a single palette: Light and Default are identical -->
		<ResourceDictionary x:Key="Light">

			<!-- OutlinedTextBox (OmarchyInputContainer) -->
			<StaticResource x:Key="OutlinedTextBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedTextBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrushPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrushFocused" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="OutlinedTextBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="OutlinedTextBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedTextBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderThickness" ResourceKey="OmarchyBorderThickness" />
			<StaticResource x:Key="OutlinedTextBoxPadding" ResourceKey="Space200Thickness" />

			<!-- FilledTextBox (bare OmarchyTextInput) -->
			<StaticResource x:Key="FilledTextBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledTextBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="FilledTextBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledTextBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<Thickness x:Key="FilledTextBoxBorderThickness">0</Thickness>
			<StaticResource x:Key="FilledTextBoxPadding" ResourceKey="Space200VerticalThickness" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="Default">

			<!-- OutlinedTextBox (OmarchyInputContainer) -->
			<StaticResource x:Key="OutlinedTextBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedTextBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrushPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderBrushFocused" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="OutlinedTextBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="OutlinedTextBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedTextBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<StaticResource x:Key="OutlinedTextBoxBorderThickness" ResourceKey="OmarchyBorderThickness" />
			<StaticResource x:Key="OutlinedTextBoxPadding" ResourceKey="Space200Thickness" />

			<!-- FilledTextBox (bare OmarchyTextInput) -->
			<StaticResource x:Key="FilledTextBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledTextBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledTextBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="FilledTextBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledTextBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<Thickness x:Key="FilledTextBoxBorderThickness">0</Thickness>
			<StaticResource x:Key="FilledTextBoxPadding" ResourceKey="Space200VerticalThickness" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- Segoe MDL2 / Uno Fluent "Cancel" glyph -->
	<x:String x:Key="OmarchyTextBoxDeleteGlyph">&#xE711;</x:String>

	<!-- DeleteButton (no source equivalent): muted glyph, accent on hover / pressed, no background, no border -->
	<Style x:Key="OmarchyTextBoxDeleteButtonStyle"
		   TargetType="Button">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyMutedBrush}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="MinWidth" Value="{ThemeResource IconSizeMedium}" />
		<Setter Property="MinHeight" Value="{ThemeResource IconSizeMedium}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Background="{TemplateBinding Background}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="GlyphElement.Foreground" Value="{ThemeResource OmarchyAccentBrush}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="GlyphElement.Foreground" Value="{ThemeResource OmarchyAccentBrush}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Disabled" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<FontIcon x:Name="GlyphElement"
								  Glyph="{StaticResource OmarchyTextBoxDeleteGlyph}"
								  FontFamily="{ThemeResource SymbolThemeFontFamily}"
								  FontSize="{ThemeResource IconSizeSmall}"
								  Foreground="{TemplateBinding Foreground}"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  AutomationProperties.AccessibilityView="Raw" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- OmarchyOutlinedTextBoxStyle: OmarchyInputContainer (OutlinedTextBox* keys) -->
	<Style x:Key="OmarchyOutlinedTextBoxStyle"
		   TargetType="TextBox">
		<Setter Property="Foreground" Value="{ThemeResource OutlinedTextBoxForeground}" />
		<Setter Property="Background" Value="{ThemeResource OutlinedTextBoxBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OutlinedTextBoxBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource OutlinedTextBoxBorderThickness}" />
		<Setter Property="Padding" Value="{ThemeResource OutlinedTextBoxPadding}" />
		<Setter Property="SelectionHighlightColor" Value="{ThemeResource OutlinedTextBoxSelectionHighlightColor}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<!-- Focus is the accent border, not the system focus rectangle -->
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Grid x:Name="RootGrid">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource OutlinedTextBoxBorderBrushPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<!-- OmarchyFocusBorder: the 2 px overlay switches from normal.black to the accent -->
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource OutlinedTextBoxBorderBrushFocused}" />
									</VisualState.Setters>
								</VisualState>

								<!-- No disabled visuals in the source: dim the whole control like a disabled outline border -->
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="RootGrid.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ButtonStates">
								<VisualState x:Name="ButtonVisible">
									<VisualState.Setters>
										<Setter Target="DeleteButton.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="ButtonCollapsed" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- Header -->
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  FontFamily="{ThemeResource BodyLargeFontFamily}"
										  FontSize="{ThemeResource BodyLargeFontSize}"
										  FontWeight="{ThemeResource BodyLargeFontWeight}"
										  Foreground="{ThemeResource OutlinedTextBoxHeaderForeground}"
										  Margin="{ThemeResource Space100BottomThickness}"
										  TextWrapping="Wrap"
										  Visibility="Collapsed"
										  x:DeferLoadStrategy="Lazy" />

						<!-- Input field -->
						<Grid Grid.Row="1">

							<Border x:Name="BackgroundElement"
									Background="{TemplateBinding Background}" />

							<!-- DefaultPadding(8) wraps the whole input row, delete button included -->
							<Grid Padding="{TemplateBinding Padding}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<ContentControl x:Name="PlaceholderElement"
												Content="{TemplateBinding PlaceholderText}"
												Foreground="{ThemeResource OutlinedTextBoxPlaceholderForeground}"
												FontFamily="{TemplateBinding FontFamily}"
												FontSize="{TemplateBinding FontSize}"
												FontWeight="{TemplateBinding FontWeight}"
												HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
												Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToVisibleConverter}}"
												IsHitTestVisible="False"
												IsTabStop="False" />

								<ScrollViewer x:Name="ContentElement"
											  HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
											  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
											  VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
											  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											  IsHorizontalRailEnabled="False"
											  IsVerticalRailEnabled="False"
											  IsTabStop="False"
											  ZoomMode="Disabled"
											  AutomationProperties.AccessibilityView="Raw" />

								<Button x:Name="DeleteButton"
										Grid.Column="1"
										Style="{StaticResource OmarchyTextBoxDeleteButtonStyle}"
										Margin="{ThemeResource Space200LeftThickness}"
										VerticalAlignment="Center"
										Visibility="Collapsed"
										IsTabStop="False"
										AutomationProperties.AccessibilityView="Raw" />
							</Grid>

							<!-- OmarchyFocusBorder overlay: sits on top of the content so it never pushes it -->
							<Border x:Name="BorderElement"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- OmarchyFilledTextBoxStyle: bare OmarchyTextInput (FilledTextBox* keys) -->
	<Style x:Key="OmarchyFilledTextBoxStyle"
		   TargetType="TextBox">
		<Setter Property="Foreground" Value="{ThemeResource FilledTextBoxForeground}" />
		<Setter Property="Background" Value="{ThemeResource FilledTextBoxBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource FilledTextBoxBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource FilledTextBoxBorderThickness}" />
		<Setter Property="Padding" Value="{ThemeResource FilledTextBoxPadding}" />
		<Setter Property="SelectionHighlightColor" Value="{ThemeResource FilledTextBoxSelectionHighlightColor}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<!-- The bare input has no focus visual in the source; keep the system one off for consistency -->
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Grid x:Name="RootGrid">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource FilledTextBoxBorderBrushPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource FilledTextBoxBorderBrushFocused}" />
									</VisualState.Setters>
								</VisualState>

								<!-- No disabled visuals in the source: dim the whole control like a disabled outline border -->
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="RootGrid.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ButtonStates">
								<VisualState x:Name="ButtonVisible">
									<VisualState.Setters>
										<Setter Target="DeleteButton.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="ButtonCollapsed" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- Header -->
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  FontFamily="{ThemeResource BodyLargeFontFamily}"
										  FontSize="{ThemeResource BodyLargeFontSize}"
										  FontWeight="{ThemeResource BodyLargeFontWeight}"
										  Foreground="{ThemeResource FilledTextBoxHeaderForeground}"
										  Margin="{ThemeResource Space100BottomThickness}"
										  TextWrapping="Wrap"
										  Visibility="Collapsed"
										  x:DeferLoadStrategy="Lazy" />

						<!-- Input field -->
						<Grid Grid.Row="1">

							<Border x:Name="BackgroundElement"
									Background="{TemplateBinding Background}" />

							<!-- EdgeInsets.symmetric(vertical: 8) wraps the whole input row, delete button included -->
							<Grid Padding="{TemplateBinding Padding}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<ContentControl x:Name="PlaceholderElement"
												Content="{TemplateBinding PlaceholderText}"
												Foreground="{ThemeResource FilledTextBoxPlaceholderForeground}"
												FontFamily="{TemplateBinding FontFamily}"
												FontSize="{TemplateBinding FontSize}"
												FontWeight="{TemplateBinding FontWeight}"
												HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
												Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToVisibleConverter}}"
												IsHitTestVisible="False"
												IsTabStop="False" />

								<ScrollViewer x:Name="ContentElement"
											  HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
											  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
											  VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
											  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											  IsHorizontalRailEnabled="False"
											  IsVerticalRailEnabled="False"
											  IsTabStop="False"
											  ZoomMode="Disabled"
											  AutomationProperties.AccessibilityView="Raw" />

								<Button x:Name="DeleteButton"
										Grid.Column="1"
										Style="{StaticResource OmarchyTextBoxDeleteButtonStyle}"
										Margin="{ThemeResource Space200LeftThickness}"
										VerticalAlignment="Center"
										Visibility="Collapsed"
										IsTabStop="False"
										AutomationProperties.AccessibilityView="Raw" />
							</Grid>

							<!-- Border overlay (transparent, 0 px by default; honours lightweight-styled borders) -->
							<Border x:Name="BorderElement"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
