<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Omarchy PasswordBox, ported from flutter_omarchy
		(artifacts/flutter_omarchy/packages/flutter_omarchy/lib/src/widgets/input_container.dart and text_input.dart,
		obscureText: true). Same two visuals as TextBox.xaml:

		OmarchyOutlinedPasswordBoxStyle = OmarchyInputContainer + OmarchyTextInput: a 2 px border that is
		normal.black at rest and the accent (theme.colors.border) when focused, 8 px padding all around.
		OmarchyFilledPasswordBoxStyle = bare OmarchyTextInput: no border, no background, vertical 8 px padding.

		Deviations from the source:
		- No hover visuals (none in the source either); the *PointerOver keys only exist for lightweight styling.
		- Disabled: the source has no disabled visuals; the whole control is dimmed to OmarchyBorderOpacityDisabled.
		- Caret: cursorColor = selectedText (accent) cannot be expressed, WinUI has no caret brush.
		- Header and RevealButton have no source equivalent (WinUI-only parts): header = body text in
		  foreground, reveal button = a muted glyph that turns accent on hover, no background, no border.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- Omarchy has a single palette: Light and Default are identical -->
		<ResourceDictionary x:Key="Light">

			<!-- OutlinedPasswordBox (OmarchyInputContainer) -->
			<StaticResource x:Key="OutlinedPasswordBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrushPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrushFocused" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderThickness" ResourceKey="OmarchyBorderThickness" />
			<StaticResource x:Key="OutlinedPasswordBoxPadding" ResourceKey="Space200Thickness" />

			<!-- FilledPasswordBox (bare OmarchyTextInput) -->
			<StaticResource x:Key="FilledPasswordBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledPasswordBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="FilledPasswordBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledPasswordBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<Thickness x:Key="FilledPasswordBoxBorderThickness">0</Thickness>
			<StaticResource x:Key="FilledPasswordBoxPadding" ResourceKey="Space200VerticalThickness" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="Default">

			<!-- OutlinedPasswordBox (OmarchyInputContainer) -->
			<StaticResource x:Key="OutlinedPasswordBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrush" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrushPointerOver" ResourceKey="OmarchyNormalBlackBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderBrushFocused" ResourceKey="OmarchyAccentBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<StaticResource x:Key="OutlinedPasswordBoxBorderThickness" ResourceKey="OmarchyBorderThickness" />
			<StaticResource x:Key="OutlinedPasswordBoxPadding" ResourceKey="Space200Thickness" />

			<!-- FilledPasswordBox (bare OmarchyTextInput) -->
			<StaticResource x:Key="FilledPasswordBoxForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledPasswordBoxBackground" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="FilledPasswordBoxPlaceholderForeground" ResourceKey="OmarchyMutedBrush" />
			<StaticResource x:Key="FilledPasswordBoxHeaderForeground" ResourceKey="OmarchyForegroundBrush" />
			<StaticResource x:Key="FilledPasswordBoxSelectionHighlightColor" ResourceKey="OmarchySelectionBrush" />
			<Thickness x:Key="FilledPasswordBoxBorderThickness">0</Thickness>
			<StaticResource x:Key="FilledPasswordBoxPadding" ResourceKey="Space200VerticalThickness" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- Segoe MDL2 / Uno Fluent "reveal" (eye) glyph -->
	<x:String x:Key="OmarchyPasswordBoxRevealGlyph">&#xE052;</x:String>

	<!-- RevealButton (no source equivalent): muted glyph, accent on hover / pressed, no background, no border -->
	<Style x:Key="OmarchyPasswordBoxRevealButtonStyle"
		   TargetType="Button">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyMutedBrush}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="MinWidth" Value="{ThemeResource IconSizeMedium}" />
		<Setter Property="MinHeight" Value="{ThemeResource IconSizeMedium}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Background="{TemplateBinding Background}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="GlyphElement.Foreground" Value="{ThemeResource OmarchyAccentBrush}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="GlyphElement.Foreground" Value="{ThemeResource OmarchyAccentBrush}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Disabled" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<FontIcon x:Name="GlyphElement"
								  Glyph="{StaticResource OmarchyPasswordBoxRevealGlyph}"
								  FontFamily="{ThemeResource SymbolThemeFontFamily}"
								  FontSize="{ThemeResource IconSizeSmall}"
								  Foreground="{TemplateBinding Foreground}"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  AutomationProperties.AccessibilityView="Raw" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- OmarchyOutlinedPasswordBoxStyle: OmarchyInputContainer (OutlinedPasswordBox* keys) -->
	<Style x:Key="OmarchyOutlinedPasswordBoxStyle"
		   TargetType="PasswordBox">
		<Setter Property="Foreground" Value="{ThemeResource OutlinedPasswordBoxForeground}" />
		<Setter Property="Background" Value="{ThemeResource OutlinedPasswordBoxBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OutlinedPasswordBoxBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource OutlinedPasswordBoxBorderThickness}" />
		<Setter Property="Padding" Value="{ThemeResource OutlinedPasswordBoxPadding}" />
		<Setter Property="SelectionHighlightColor" Value="{ThemeResource OutlinedPasswordBoxSelectionHighlightColor}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<!-- Focus is the accent border, not the system focus rectangle -->
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="PasswordBox">
					<Grid x:Name="RootGrid">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource OutlinedPasswordBoxBorderBrushPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<!-- OmarchyFocusBorder: the 2 px overlay switches from normal.black to the accent -->
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource OutlinedPasswordBoxBorderBrushFocused}" />
									</VisualState.Setters>
								</VisualState>

								<!-- No disabled visuals in the source: dim the whole control like a disabled outline border -->
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="RootGrid.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ButtonStates">
								<VisualState x:Name="ButtonVisible">
									<VisualState.Setters>
										<Setter Target="RevealButton.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="ButtonCollapsed" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- Header -->
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  FontFamily="{ThemeResource BodyLargeFontFamily}"
										  FontSize="{ThemeResource BodyLargeFontSize}"
										  FontWeight="{ThemeResource BodyLargeFontWeight}"
										  Foreground="{ThemeResource OutlinedPasswordBoxHeaderForeground}"
										  Margin="{ThemeResource Space100BottomThickness}"
										  TextWrapping="Wrap"
										  Visibility="Collapsed"
										  x:DeferLoadStrategy="Lazy" />

						<!-- Input field -->
						<Grid Grid.Row="1">

							<Border x:Name="BackgroundElement"
									Background="{TemplateBinding Background}" />

							<!-- DefaultPadding(8) wraps the whole input row, reveal button included -->
							<Grid Padding="{TemplateBinding Padding}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<ContentControl x:Name="PlaceholderElement"
												Content="{TemplateBinding PlaceholderText}"
												Foreground="{ThemeResource OutlinedPasswordBoxPlaceholderForeground}"
												FontFamily="{TemplateBinding FontFamily}"
												FontSize="{TemplateBinding FontSize}"
												FontWeight="{TemplateBinding FontWeight}"
												HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
												Visibility="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToVisibleConverter}}"
												IsHitTestVisible="False"
												IsTabStop="False" />

								<ScrollViewer x:Name="ContentElement"
											  HorizontalScrollMode="Auto"
											  HorizontalScrollBarVisibility="Hidden"
											  VerticalScrollMode="Disabled"
											  VerticalScrollBarVisibility="Hidden"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											  IsHorizontalRailEnabled="False"
											  IsVerticalRailEnabled="False"
											  IsTabStop="False"
											  ZoomMode="Disabled"
											  AutomationProperties.AccessibilityView="Raw" />

								<Button x:Name="RevealButton"
										Grid.Column="1"
										Style="{StaticResource OmarchyPasswordBoxRevealButtonStyle}"
										Margin="{ThemeResource Space200LeftThickness}"
										VerticalAlignment="Center"
										Visibility="Collapsed"
										IsTabStop="False"
										AutomationProperties.AccessibilityView="Raw" />
							</Grid>

							<!-- OmarchyFocusBorder overlay: sits on top of the content so it never pushes it -->
							<Border x:Name="BorderElement"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- OmarchyFilledPasswordBoxStyle: bare OmarchyTextInput (FilledPasswordBox* keys) -->
	<Style x:Key="OmarchyFilledPasswordBoxStyle"
		   TargetType="PasswordBox">
		<Setter Property="Foreground" Value="{ThemeResource FilledPasswordBoxForeground}" />
		<Setter Property="Background" Value="{ThemeResource FilledPasswordBoxBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource FilledPasswordBoxBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource FilledPasswordBoxBorderThickness}" />
		<Setter Property="Padding" Value="{ThemeResource FilledPasswordBoxPadding}" />
		<Setter Property="SelectionHighlightColor" Value="{ThemeResource FilledPasswordBoxSelectionHighlightColor}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyLargeFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<!-- The bare input has no focus visual in the source; keep the system one off for consistency -->
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="PasswordBox">
					<Grid x:Name="RootGrid">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />

								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource FilledPasswordBoxBorderBrushPointerOver}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="BorderElement.BorderBrush" Value="{ThemeResource FilledPasswordBoxBorderBrushFocused}" />
									</VisualState.Setters>
								</VisualState>

								<!-- No disabled visuals in the source: dim the whole control like a disabled outline border -->
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="RootGrid.Opacity" Value="{ThemeResource OmarchyBorderOpacityDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ButtonStates">
								<VisualState x:Name="ButtonVisible">
									<VisualState.Setters>
										<Setter Target="RevealButton.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="ButtonCollapsed" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- Header -->
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  FontFamily="{ThemeResource BodyLargeFontFamily}"
										  FontSize="{ThemeResource BodyLargeFontSize}"
										  FontWeight="{ThemeResource BodyLargeFontWeight}"
										  Foreground="{ThemeResource FilledPasswordBoxHeaderForeground}"
										  Margin="{ThemeResource Space100BottomThickness}"
										  TextWrapping="Wrap"
										  Visibility="Collapsed"
										  x:DeferLoadStrategy="Lazy" />

						<!-- Input field -->
						<Grid Grid.Row="1">

							<Border x:Name="BackgroundElement"
									Background="{TemplateBinding Background}" />

							<!-- EdgeInsets.symmetric(vertical: 8) wraps the whole input row, reveal button included -->
							<Grid Padding="{TemplateBinding Padding}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<ContentControl x:Name="PlaceholderElement"
												Content="{TemplateBinding PlaceholderText}"
												Foreground="{ThemeResource FilledPasswordBoxPlaceholderForeground}"
												FontFamily="{TemplateBinding FontFamily}"
												FontSize="{TemplateBinding FontSize}"
												FontWeight="{TemplateBinding FontWeight}"
												HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
												Visibility="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToVisibleConverter}}"
												IsHitTestVisible="False"
												IsTabStop="False" />

								<ScrollViewer x:Name="ContentElement"
											  HorizontalScrollMode="Auto"
											  HorizontalScrollBarVisibility="Hidden"
											  VerticalScrollMode="Disabled"
											  VerticalScrollBarVisibility="Hidden"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											  IsHorizontalRailEnabled="False"
											  IsVerticalRailEnabled="False"
											  IsTabStop="False"
											  ZoomMode="Disabled"
											  AutomationProperties.AccessibilityView="Raw" />

								<Button x:Name="RevealButton"
										Grid.Column="1"
										Style="{StaticResource OmarchyPasswordBoxRevealButtonStyle}"
										Margin="{ThemeResource Space200LeftThickness}"
										VerticalAlignment="Center"
										Visibility="Collapsed"
										IsTabStop="False"
										AutomationProperties.AccessibilityView="Raw" />
							</Grid>

							<!-- Border overlay (transparent, 0 px by default; honours lightweight-styled borders) -->
							<Border x:Name="BorderElement"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
