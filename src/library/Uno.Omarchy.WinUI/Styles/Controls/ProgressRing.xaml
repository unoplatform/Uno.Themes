<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
					xmlns:not_win="http://uno.ui/not_win"
					mc:Ignorable="d not_win">

	<!--
		OmarchyLoader (flutter_omarchy: lib/src/widgets/loader.dart).

		An 18 px square (1.2 x the 14 px body size, rounded to an even number): a square
		outline whose stroke is size / 10 (2 px) and whose opacity pulses 0.1 -> 0.3 -> 0.1
		over the 2 s period (Flutter easeIn up, the same curve mirrored down), plus an inner
		square inset by 4 px filled with the color (theme foreground by default, bright.{ansi}
		for the variants), which travels through Foreground.

		Approximation: the source fills the inner square with a radial gradient whose centre
		orbits the square five times per period, eased so it lingers then whips around.
		Storyboards cannot move a gradient centre, so the inner square's opacity pulses
		1 -> 0.1 -> 1 five times per period instead (0.4 s per lap: a 0.3 s eased fade,
		then a 0.1 s rise), which reads as the same 2.5 Hz shimmer at 18 px.

		Deviations:
		- The stroke is the 2 px border token, not size / 10: it does not scale with Width / Height.
		- The source has no determinate mode: DeterminateActive shows the square at rest.
		- No Lottie: plain XAML driven by Storyboards; the key splines are Flutter's easeIn
		  (0.42, 0, 1, 1) and its mirror.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="ProgressRingForeground" ResourceKey="OmarchyForegroundBrush" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="ProgressRingForeground" ResourceKey="OmarchyForegroundBrush" />
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- loader.dart: size = fontSize (14) * 1.2, margin = 4 -->
	<x:Double x:Key="OmarchyProgressRingSize">18</x:Double>
	<Thickness x:Key="OmarchyProgressRingInnerMargin">4</Thickness>

	<Style x:Key="OmarchyProgressRingStyle"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource ProgressRingForeground}" />
		<Setter Property="Width" Value="{ThemeResource OmarchyProgressRingSize}" />
		<Setter Property="Height" Value="{ThemeResource OmarchyProgressRingSize}" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="IsHitTestVisible" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Maximum" Value="100" />

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="muxc:ProgressRing">
					<Grid x:Name="LayoutRoot">

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Inactive">
									<VisualState.Setters>
										<Setter Target="LayoutRoot.Opacity" Value="0" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="DeterminateActive" />

								<VisualState x:Name="Active">
									<Storyboard RepeatBehavior="Forever">
										<!-- Outline: 0.1 + 0.2 * easeIn(t) up, mirrored down -->
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="OuterSquare"
																	   Storyboard.TargetProperty="Opacity">
											<LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.1" />
											<SplineDoubleKeyFrame KeyTime="0:0:1" KeySpline="0.42, 0.0, 1.0, 1.0" Value="0.3" />
											<SplineDoubleKeyFrame KeyTime="0:0:2" KeySpline="0.0, 0.0, 0.58, 1.0" Value="0.1" />
										</DoubleAnimationUsingKeyFrames>
										<!-- Centre: five 0.4 s laps -->
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerSquare"
																	   Storyboard.TargetProperty="Opacity">
											<LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
											<SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.42, 0.0, 1.0, 1.0" Value="0.1" />
											<LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
											<SplineDoubleKeyFrame KeyTime="0:0:0.7" KeySpline="0.42, 0.0, 1.0, 1.0" Value="0.1" />
											<LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="1" />
											<SplineDoubleKeyFrame KeyTime="0:0:1.1" KeySpline="0.42, 0.0, 1.0, 1.0" Value="0.1" />
											<LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
											<SplineDoubleKeyFrame KeyTime="0:0:1.5" KeySpline="0.42, 0.0, 1.0, 1.0" Value="0.1" />
											<LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
											<SplineDoubleKeyFrame KeyTime="0:0:1.9" KeySpline="0.42, 0.0, 1.0, 1.0" Value="0.1" />
											<LinearDoubleKeyFrame KeyTime="0:0:2" Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<!-- Outline at the pulse peak while idle (DeterminateActive) -->
						<Border x:Name="OuterSquare"
								BorderBrush="{TemplateBinding Foreground}"
								BorderThickness="{ThemeResource OmarchyBorderThickness}"
								Opacity="0.3" />
						<Border x:Name="InnerSquare"
								Margin="{ThemeResource OmarchyProgressRingInnerMargin}"
								Background="{TemplateBinding Foreground}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- OmarchyLoader(accent: AnsiColor.x): color = bright.x -->
	<Style x:Key="OmarchyProgressRingBlackStyle"
		   BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyBrightBlackBrush}" />
	</Style>

	<Style x:Key="OmarchyProgressRingWhiteStyle"
		   BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyBrightWhiteBrush}" />
	</Style>

	<Style x:Key="OmarchyProgressRingRedStyle"
		   BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyBrightRedBrush}" />
	</Style>

	<Style x:Key="OmarchyProgressRingGreenStyle"
		   BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyBrightGreenBrush}" />
	</Style>

	<Style x:Key="OmarchyProgressRingYellowStyle"
		   BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyBrightYellowBrush}" />
	</Style>

	<Style x:Key="OmarchyProgressRingBlueStyle"
		   BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyBrightBlueBrush}" />
	</Style>

	<Style x:Key="OmarchyProgressRingMagentaStyle"
		   BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyBrightMagentaBrush}" />
	</Style>

	<Style x:Key="OmarchyProgressRingCyanStyle"
		   BasedOn="{StaticResource OmarchyProgressRingStyle}"
		   TargetType="muxc:ProgressRing">
		<Setter Property="Foreground" Value="{ThemeResource OmarchyBrightCyanBrush}" />
	</Style>

</ResourceDictionary>
