<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Omarchy design tokens. Every value is taken from the flutter_omarchy widgets
		(artifacts/flutter_omarchy/packages/flutter_omarchy/lib/src/widgets/*.dart).

		Omarchy derives hover / pressed / disabled visuals from ONE color per role and an alpha:
		the templates layer a Border fed by the control's Background brush and drive that layer's
		Opacity from the tokens below, instead of declaring a brush per state.
	-->

	<!-- Tint layer (button.dart: filled / outline / bar styles) -->
	<x:Double x:Key="OmarchyTintOpacity">0.15</x:Double>
	<x:Double x:Key="OmarchyTintOpacityPointerOver">0.25</x:Double>
	<x:Double x:Key="OmarchyTintOpacityPressed">0.35</x:Double>
	<x:Double x:Key="OmarchyTintOpacityDisabled">0.02</x:Double>

	<!-- Disabled: filled foreground is the normal color at 0.3; outline border is the normal color at 0.5 -->
	<x:Double x:Key="OmarchyForegroundOpacityDisabled">0.3</x:Double>
	<x:Double x:Key="OmarchyBorderOpacityDisabled">0.5</x:Double>
	<!--
		Disabled outline / bar buttons switch their foreground from the bright to the normal
		color in the source. There is no per-state brush in the tint model, so the content is
		dimmed instead; 0.6 approximates the bright -> normal step of the stock palettes.
	-->
	<x:Double x:Key="OmarchyMutedForegroundOpacity">0.6</x:Double>

	<!-- Focused filled button: bright border at 0.5 -->
	<x:Double x:Key="OmarchyFocusBorderOpacity">0.5</x:Double>

	<!-- checkbox.dart / radio.dart: accent fill at 0.4; hover multiplies border and fill by 0.6 (0.9 when checked) -->
	<x:Double x:Key="OmarchyCheckFillOpacity">0.4</x:Double>
	<x:Double x:Key="OmarchyCheckFillOpacityHighlighted">0.24</x:Double>
	<x:Double x:Key="OmarchyHighlightOpacity">0.6</x:Double>
	<x:Double x:Key="OmarchyHighlightSelectedOpacity">0.9</x:Double>

	<!-- slider.dart -->
	<x:Double x:Key="OmarchySliderTrackOpacity">0.6</x:Double>
	<x:Double x:Key="OmarchySliderThumbOpacity">0.9</x:Double>

	<!-- tile.dart: hover is lighter_background at 0.5, pressed at 1 -->
	<x:Double x:Key="OmarchyTileHoverOpacity">0.5</x:Double>

	<!-- Strokes: 2 px borders everywhere (buttons, inputs, dialogs, pop-overs); 1 px dividers -->
	<x:Double x:Key="OmarchyBorderWidth">2</x:Double>
	<Thickness x:Key="OmarchyBorderThickness">2</Thickness>
	<x:Double x:Key="OmarchyDividerWidth">1</x:Double>
	<Thickness x:Key="OmarchyDividerThickness">1</Thickness>

	<!-- Sharp corners are the identity of the theme; only the toggle knob is rounded (1-2 px) -->
	<CornerRadius x:Key="OmarchyCornerRadius">0</CornerRadius>

	<!-- tile.dart / navigation_bar.dart: 4 x the 14 px body size -->
	<x:Double x:Key="OmarchyTileHeight">56</x:Double>

	<!-- Every state transition in the source animates over 120 ms -->
	<x:Double x:Key="OmarchyAnimationDuration">0.12</x:Double>
	<x:String x:Key="OmarchyAnimationDurationTimeSpan">0:0:0.12</x:String>

</ResourceDictionary>
