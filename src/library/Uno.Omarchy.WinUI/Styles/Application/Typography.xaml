<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Omarchy — Semantic Typography

		Reproduces theme/text.dart: one monospace face (CaskaydiaMono Nerd Font Mono) at 14 px in
		three cuts — normal, bold and italic. The slot -> face mapping (bold for titles, italic for
		captions, regular otherwise) lives in Common/Fonts.xaml; this file only sets sizes, weights
		and letter spacing, then declares the Omarchy{Slot} TextBlock styles.

		Omarchy uses two sizes (14 for everything, 12 for descriptions); sizes above 14 and below
		12 are an extension so the semantic scale stays distinguishable:
		  Display   Bold    32 / 28 / 24
		  Headline  Bold    20 / 18 / 16
		  Title     Bold    16 / 14 / 14
		  Body      Normal  14 / 14 / 12
		  Label     Normal  14 / 12 / 12 (ExtraSmall 11)
		  Caption   Normal  12 / 12 / 11 (italic cut)

		Deviations: the source has no letter spacing (monospace), so CharacterSpacing is 0 for every
		slot, overriding the Material-derived shared defaults. The Caption styles set
		FontStyle="Italic" on top of the italic font file so the cut is honoured even when the
		family cannot be resolved. Light and Default are identical: Omarchy has one palette.
	-->

	<!-- The per-slot FontSize / FontWeight / CharacterSpacing values live in Common/TypeScale.xaml (merged after SharedTypography.xaml). -->

	<!--
		Omarchy{Slot} TextBlock styles. All are BasedOn OmarchyBaseTextBlockStyle (Controls/TextBlock.xaml)
		and are exposed under the theme-agnostic keys (DisplayLarge, BodyMedium, ...) by _Resources.xaml.
	-->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- DISPLAY -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->

	<!-- Display Large -->
	<Style x:Key="OmarchyDisplayLarge"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource OmarchyBaseTextBlockStyle}">
		<Setter Property="FontFamily" Value="{ThemeResource DisplayLargeFontFamily}" />
		<Setter Property="FontWeight" Value="{ThemeResource DisplayLargeFontWeight}" />
		<Setter Property="FontSize" Value="{ThemeResource DisplayLargeFontSize}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource DisplayLargeCharacterSpacing}" />
	</Style>

