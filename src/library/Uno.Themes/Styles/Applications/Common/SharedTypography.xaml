<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Shared Typography Tokens
		
		This file defines the canonical set of semantic typography tokens.
		The key names follow the Material Design 3 type scale and are used
		by control templates across all themes.
		
		ROOT TYPEFACE TOKEN
		===================
		DefaultFontFamily - the single root typeface every type scale derives from.
		Per-scale variation is expressed through the *FontWeight tokens, not through
		separate font families: the font's weights are resolved from a single
		FontFamily reference (via a variable font, or a font manifest on platforms
		without variable-font support).
		
		Overriding DefaultFontFamily at app level cascades to all type scales,
		enabling a single-key font swap.
		
		Each theme (Material, Simple, Cupertino) overrides this root token in its
		own Fonts file. The value here serves as a baseline fallback using Segoe UI.
		The Material and Simple Typography files repeat the slot aliases below so
		each of their appearance blocks is self-contained; keep them in step
		(specs/lessons.md).
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- DARK THEME (Default) -->
		<ResourceDictionary x:Key="Default">

			<!-- Root Typeface Token -->
			<FontFamily x:Key="DefaultFontFamily">Segoe UI</FontFamily>

			<!-- DISPLAY -->
			<StaticResource x:Key="DisplayLargeFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="DisplayLargeFontWeight">Normal</x:String>
			<x:Double x:Key="DisplayLargeFontSize">57</x:Double>
			<x:Int32 x:Key="DisplayLargeCharacterSpacing">-17</x:Int32>

			<StaticResource x:Key="DisplayMediumFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="DisplayMediumFontWeight">Normal</x:String>
			<x:Double x:Key="DisplayMediumFontSize">45</x:Double>

			<StaticResource x:Key="DisplaySmallFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="DisplaySmallFontWeight">Normal</x:String>
			<x:Double x:Key="DisplaySmallFontSize">36</x:Double>

			<!-- HEADLINE -->
			<StaticResource x:Key="HeadlineLargeFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="HeadlineLargeFontWeight">Normal</x:String>
			<x:Double x:Key="HeadlineLargeFontSize">32</x:Double>

			<StaticResource x:Key="HeadlineMediumFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="HeadlineMediumFontWeight">Normal</x:String>
			<x:Double x:Key="HeadlineMediumFontSize">28</x:Double>

			<StaticResource x:Key="HeadlineSmallFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="HeadlineSmallFontWeight">Normal</x:String>
			<x:Double x:Key="HeadlineSmallFontSize">24</x:Double>

			<!-- TITLE -->
			<StaticResource x:Key="TitleLargeFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="TitleLargeFontWeight">Normal</x:String>
			<x:Double x:Key="TitleLargeFontSize">22</x:Double>

			<StaticResource x:Key="TitleMediumFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="TitleMediumFontWeight">Medium</x:String>
			<x:Double x:Key="TitleMediumFontSize">16</x:Double>

			<StaticResource x:Key="TitleSmallFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="TitleSmallFontWeight">Medium</x:String>
			<x:Double x:Key="TitleSmallFontSize">14</x:Double>

			<!-- LABEL -->
			<StaticResource x:Key="LabelLargeFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="LabelLargeFontWeight">Medium</x:String>
			<x:Double x:Key="LabelLargeFontSize">14</x:Double>
			<x:Int32 x:Key="LabelLargeCharacterSpacing">7</x:Int32>

			<StaticResource x:Key="LabelMediumFontFamily" ResourceKey="DefaultFontFamily" />
			<x:String x:Key="LabelMediumFontWeight">Medium</x:String>
			<x:Double x:Key="LabelMediumFontSize">12</x:Double>
			<x:Int32 x:Key="LabelMediumCharacterSpacing">41</x:Int32>

			<StaticResource x:Key="LabelSmallFontFamily" ResourceKey="DefaultFontFamily" />
