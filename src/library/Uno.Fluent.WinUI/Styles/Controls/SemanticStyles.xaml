<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:fluent="using:Uno.Fluent">

	<!--
		Semantic aliases (design-system-agnostic) -> built-in Fluent styles.
		Kept out of the XamlMerge bundle (see fluent-common.props) and merged by FluentTheme as a
		SemanticResources dictionary, like Simple's. No implicit styles: Fluent already is the implicit
		default. Every alias targets a concrete key (alias-of-alias does not resolve on Uno); keys for
		Material-only concepts (FAB, Elevated) map to the nearest Fluent neighbor.
	-->

	<!-- Button -->
	<StaticResource x:Key="FilledButtonStyle" ResourceKey="AccentButtonStyle" />
	<!-- Fluent has no elevation; the standard button is the functional neighbor (D8) -->
	<StaticResource x:Key="ElevatedButtonStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="FilledTonalButtonStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="OutlinedButtonStyle" ResourceKey="DefaultButtonStyle" />

	<!--
		Fluent "subtle button": the built-in Button template (no Template setter), transparent at rest,
		with the subtle fills (SubtleFillColorSecondary / Tertiary) on hover and press instead of the
		standard button's fill and elevation border. Defined here, not aliased: an alias to a style of
		this library would resolve against the application scope only.
	-->
	<Style x:Key="TextButtonStyle"
		   TargetType="Button"
		   BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="fluent:FluentResources.Merged">
			<Setter.Value>
				<ResourceDictionary>
					<ResourceDictionary.ThemeDictionaries>
						<ResourceDictionary x:Key="Light">
							<SolidColorBrush x:Key="ButtonBackgroundPointerOver"
											 Color="#09000000" />
							<SolidColorBrush x:Key="ButtonBackgroundPressed"
											 Color="#06000000" />
							<SolidColorBrush x:Key="ButtonBackgroundDisabled"
											 Color="Transparent" />
							<SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
											 Color="Transparent" />
							<SolidColorBrush x:Key="ButtonBorderBrushPressed"
											 Color="Transparent" />
							<SolidColorBrush x:Key="ButtonBorderBrushDisabled"
											 Color="Transparent" />
						</ResourceDictionary>
						<ResourceDictionary x:Key="Default">
							<SolidColorBrush x:Key="ButtonBackgroundPointerOver"
											 Color="#0FFFFFFF" />
							<SolidColorBrush x:Key="ButtonBackgroundPressed"
											 Color="#0AFFFFFF" />
							<SolidColorBrush x:Key="ButtonBackgroundDisabled"
											 Color="Transparent" />
							<SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
											 Color="Transparent" />
							<SolidColorBrush x:Key="ButtonBorderBrushPressed"
											 Color="Transparent" />
							<SolidColorBrush x:Key="ButtonBorderBrushDisabled"
											 Color="Transparent" />
						</ResourceDictionary>
					</ResourceDictionary.ThemeDictionaries>
				</ResourceDictionary>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Subtle icon button: square padding, secondary text color at rest -->
	<Style x:Key="IconButtonStyle"
		   TargetType="Button"
		   BasedOn="{StaticResource TextButtonStyle}">
		<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
		<Setter Property="Padding" Value="8" />
		<Setter Property="MinWidth" Value="40" />
		<Setter Property="MinHeight" Value="40" />
	</Style>


	<!-- FAB (Material-only concept; no size differentiation — Fluent buttons size to content) -->
	<StaticResource x:Key="FabStyle" ResourceKey="AccentButtonStyle" />
	<StaticResource x:Key="SmallFabStyle" ResourceKey="AccentButtonStyle" />
	<StaticResource x:Key="LargeFabStyle" ResourceKey="AccentButtonStyle" />
	<StaticResource x:Key="SecondaryFabStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="SecondarySmallFabStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="SecondaryLargeFabStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="TertiaryFabStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="TertiarySmallFabStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="TertiaryLargeFabStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="SurfaceFabStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="SurfaceSmallFabStyle" ResourceKey="DefaultButtonStyle" />
	<StaticResource x:Key="SurfaceLargeFabStyle" ResourceKey="DefaultButtonStyle" />

	<!-- ToggleButton -->
	<StaticResource x:Key="TextToggleButtonStyle" ResourceKey="DefaultToggleButtonStyle" />
	<StaticResource x:Key="IconToggleButtonStyle" ResourceKey="DefaultToggleButtonStyle" />

	<!-- TextBox (the Fluent TextBox — fill + underline — serves both variants) -->
	<StaticResource x:Key="FilledTextBoxStyle" ResourceKey="DefaultTextBoxStyle" />
	<StaticResource x:Key="OutlinedTextBoxStyle" ResourceKey="DefaultTextBoxStyle" />

	<!-- PasswordBox -->
	<StaticResource x:Key="FilledPasswordBoxStyle" ResourceKey="DefaultPasswordBoxStyle" />
	<StaticResource x:Key="OutlinedPasswordBoxStyle" ResourceKey="DefaultPasswordBoxStyle" />

	<!-- ComboBox -->
	<StaticResource x:Key="ComboBoxStyle" ResourceKey="DefaultComboBoxStyle" />
	<StaticResource x:Key="ComboBoxItemStyle" ResourceKey="DefaultComboBoxItemStyle" />

	<!-- CheckBox / RadioButton / ToggleSwitch / Slider -->
	<StaticResource x:Key="CheckBoxStyle" ResourceKey="DefaultCheckBoxStyle" />
	<StaticResource x:Key="RadioButtonStyle" ResourceKey="DefaultRadioButtonStyle" />
	<StaticResource x:Key="ToggleSwitchStyle" ResourceKey="DefaultToggleSwitchStyle" />
	<StaticResource x:Key="SliderStyle" ResourceKey="DefaultSliderStyle" />

	<!-- HyperlinkButton -->
	<StaticResource x:Key="HyperlinkButtonStyle" ResourceKey="DefaultHyperlinkButtonStyle" />
	<StaticResource x:Key="SecondaryHyperlinkButtonStyle" ResourceKey="DefaultHyperlinkButtonStyle" />

	<!-- ListView (ListViewStyle: gap key, see below) -->
	<StaticResource x:Key="ListViewItemStyle" ResourceKey="DefaultListViewItemStyle" />

	<!-- ContentDialog -->
	<StaticResource x:Key="ContentDialogStyle" ResourceKey="DefaultContentDialogStyle" />

	<!-- AppBarButton (CommandBarStyle: gap key, see below) -->
	<StaticResource x:Key="AppBarButtonStyle" ResourceKey="DefaultAppBarButtonStyle" />

	<!-- CalendarView / DatePicker (CalendarDatePickerStyle: gap key, see below) -->
	<StaticResource x:Key="CalendarViewStyle" ResourceKey="DefaultCalendarViewStyle" />
	<StaticResource x:Key="DatePickerStyle" ResourceKey="DefaultDatePickerStyle" />

	<!-- ProgressBar (ProgressRingStyle: gap key, see below) -->
	<StaticResource x:Key="ProgressBarStyle" ResourceKey="DefaultProgressBarStyle" />

	<!-- MediaTransportControls -->
	<StaticResource x:Key="MediaTransportControlsStyle" ResourceKey="DefaultMediaTransportControlsStyle" />

	<!-- Flyout / MenuFlyout (MenuFlyoutSeparatorStyle: gap key, see below) -->
	<StaticResource x:Key="FlyoutPresenterStyle" ResourceKey="DefaultFlyoutPresenterStyle" />
	<StaticResource x:Key="MenuFlyoutPresenterStyle" ResourceKey="DefaultMenuFlyoutPresenterStyle" />
	<StaticResource x:Key="MenuFlyoutItemStyle" ResourceKey="DefaultMenuFlyoutItemStyle" />
	<StaticResource x:Key="MenuFlyoutSubItemStyle" ResourceKey="DefaultMenuFlyoutSubItemStyle" />
	<StaticResource x:Key="ToggleMenuFlyoutItemStyle" ResourceKey="DefaultToggleMenuFlyoutItemStyle" />
	<StaticResource x:Key="RadioMenuFlyoutItemStyle" ResourceKey="DefaultRadioMenuFlyoutItemStyle" />

	<!--
		Keys whose Fluent style has no public XamlControlsResources key on Uno: empty styles, so the
		key resolves and the control keeps its built-in default template and appearance.
	-->
	<Style x:Key="ProgressRingStyle"
		   TargetType="ProgressRing" />
	<Style x:Key="ListViewStyle"
		   TargetType="ListView" />
	<Style x:Key="CommandBarStyle"
		   TargetType="CommandBar" />
	<Style x:Key="CalendarDatePickerStyle"
		   TargetType="CalendarDatePicker" />
	<Style x:Key="DatePickerFlyoutPresenterStyle"
		   TargetType="DatePickerFlyoutPresenter" />
	<Style x:Key="PipsPagerStyle"
		   TargetType="PipsPager" />
	<Style x:Key="RatingControlStyle"
		   TargetType="RatingControl" />
	<Style x:Key="MenuFlyoutSeparatorStyle"
		   TargetType="MenuFlyoutSeparator" />
	<Style x:Key="NavigationViewStyle"
		   TargetType="NavigationView" />
	<Style x:Key="NavigationViewItemStyle"
		   TargetType="NavigationViewItem" />

	<!-- Typography: the Fluent ramp values (Typography.xaml); no Foreground, Fluent's own text defaults apply -->

	<Style x:Key="DisplayLarge"
		   TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{ThemeResource DisplayLargeFontFamily}" />
		<Setter Property="FontWeight" Value="{ThemeResource DisplayLargeFontWeight}" />
		<Setter Property="FontSize" Value="{ThemeResource DisplayLargeFontSize}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource DisplayLargeCharacterSpacing}" />
	</Style>

	<Style x:Key="DisplayMedium"
		   TargetType="TextBlock">
