<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Fluent — TextBlock Typography Styles

		The 19 semantic TextBlock styles, carrying the Fluent type-ramp values
		from Typography.xaml. Each style sets only FontFamily / FontWeight /
		FontSize (and CharacterSpacing where the shared layer defines a key) —
		no Foreground, no implicit style (spec 05, D9): Fluent's own text
		defaults stay in charge.

		The unprefixed semantic keys (DisplayLarge, BodyMedium, ...) are resolved
		late-bound in code (FluentTheme._bundleStyleAliases) — a XAML alias cannot
		see this bundle's own keys when the theme sits below app scope. XCR's own
		ramp styles (BodyTextBlockStyle, ...) remain untouched and usable
		side-by-side.
	-->

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- DISPLAY -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->

	<Style x:Key="FluentDisplayLarge"
		   TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{ThemeResource DisplayLargeFontFamily}" />
		<Setter Property="FontWeight" Value="{ThemeResource DisplayLargeFontWeight}" />
		<Setter Property="FontSize" Value="{ThemeResource DisplayLargeFontSize}" />
		<Setter Property="CharacterSpacing" Value="{ThemeResource DisplayLargeCharacterSpacing}" />
	</Style>

	<Style x:Key="FluentDisplayMedium"
		   TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{ThemeResource DisplayMediumFontFamily}" />
		<Setter Property="FontWeight" Value="{ThemeResource DisplayMediumFontWeight}" />
		<Setter Property="FontSize" Value="{ThemeResource DisplayMediumFontSize}" />
	</Style>

	<Style x:Key="FluentDisplaySmall"
		   TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{ThemeResource DisplaySmallFontFamily}" />
		<Setter Property="FontWeight" Value="{ThemeResource DisplaySmallFontWeight}" />
		<Setter Property="FontSize" Value="{ThemeResource DisplaySmallFontSize}" />
	</Style>

