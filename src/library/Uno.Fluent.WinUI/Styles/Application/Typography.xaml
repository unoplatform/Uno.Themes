<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Fluent — Semantic Typography Overrides

		Maps the 19 semantic type slots to the Fluent (WinUI) type ramp per the
		hybrid rule of spec 05, D7: where Fluent has a counterpart slot, adopt its
		size/weight; where it doesn't, keep the shared (M3) size and apply Fluent
		weight conventions (SemiBold for Display/Headline/Title/Label emphasis
		slots, Regular for Body/Caption).

		Fluent ramp anchors:
		Display     (68, SemiBold) -> DisplayLarge
		Title Large (40, SemiBold) -> DisplaySmall
		Title       (28, SemiBold) -> HeadlineMedium
		Subtitle    (20, SemiBold) -> TitleLarge
		Body Strong (14, SemiBold) -> TitleSmall / LabelLarge
		Body Large  (18, Regular)  -> BodyLarge
		Body        (14, Regular)  -> BodyMedium
		Caption     (12, Regular)  -> CaptionMedium

		DisplayMedium (54) is interpolated: 68 x (45/57) — no Fluent slot exists
		between Display (68) and Title Large (40).

		Fluent does not use letter-spacing: CharacterSpacing is 0 for every slot
		that the shared layer defines a *CharacterSpacing key for.

		Font family: platform default for every slot (ContentControlThemeFontFamily,
		spec 05 D11) — aliased DIRECTLY (never via TypefacePlain/TypefaceBrand;
		alias chaining does not resolve on Uno, D16). The same mappings are
		duplicated in Fonts.xaml, merged after SharedTypography.xaml — that
		duplication is load-bearing (specs/lessons.md); keep both in sync.

		LOAD PATH (specs/lessons.md): this file is EXCLUDED from the XamlMerge
		bundle and merged by BaseDictionaries.xaml via its ms-appx Source, after
		SharedTypography.xaml — theme-branch resources inside the merged bundle
		do not resolve reliably in Release builds, while Source-merged standalone
		dictionaries do.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- ═══════════════════════════════════════════════════════════════ -->
		<!-- DARK THEME (Default) -->
		<!-- ═══════════════════════════════════════════════════════════════ -->
		<ResourceDictionary x:Key="Default">

			<!-- DISPLAY -->

			<!-- Display Large — Fluent Display (68, SemiBold) -->
			<StaticResource x:Key="DisplayLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<x:String x:Key="DisplayLargeFontWeight">SemiBold</x:String>
			<x:Double x:Key="DisplayLargeFontSize">68</x:Double>
			<x:Int32 x:Key="DisplayLargeCharacterSpacing">0</x:Int32>

			<!-- Display Medium — interpolated 68 x (45/57) ≈ 54; no Fluent slot -->
			<StaticResource x:Key="DisplayMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<x:String x:Key="DisplayMediumFontWeight">SemiBold</x:String>
			<x:Double x:Key="DisplayMediumFontSize">54</x:Double>

			<!-- Display Small — Fluent Title Large (40, SemiBold) -->
			<StaticResource x:Key="DisplaySmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />
