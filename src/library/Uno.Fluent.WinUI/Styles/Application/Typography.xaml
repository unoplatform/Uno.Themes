			<x:String x:Key="LabelLargeFontWeight">SemiBold</x:String>
			<x:Double x:Key="LabelLargeFontSize">14</x:Double>
			<x:Int32 x:Key="LabelLargeCharacterSpacing">0</x:Int32>

			<!-- Label Medium — Fluent Caption size + emphasis weight -->
