<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Fluent — Font Family Mappings

		Every semantic slot uses the platform-default Fluent font via
		ContentControlThemeFontFamily (Segoe UI (Variable) on Windows, the
		platform/Uno default elsewhere — spec 05, D11). No font package ships.

		LOAD-BEARING (specs/lessons.md): this file is merged AFTER
		SharedTypography.xaml inside BaseDictionaries.xaml so the root token and
		the slot->family mappings deterministically win over the shared Segoe UI
		baseline.

		Unlike Material/Simple, which declare only the DefaultFontFamily root and
		let SharedTypography.xaml's slot aliases (slot -> DefaultFontFamily)
		cascade from it, Fluent's root is itself an ALIAS (to the platform token),
		and an alias whose target is another alias does not resolve on Uno
		(spec 05 D16, Given_FluentAliasResolution.When_AliasOfAlias_DoesNotResolve).
		Every slot is therefore re-declared here aliased DIRECTLY to
		ContentControlThemeFontFamily. The root token is declared too so a direct
		DefaultFontFamily lookup under FluentTheme yields the platform font, and
		so BaseTheme.DefaultFontFamily (a runtime setting) has a key to shadow —
		its generated layer is merged above this dictionary and wins for every
		key below.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- DARK THEME (Default) -->
		<ResourceDictionary x:Key="Default">

			<!-- Root Typeface Token (platform default; slots below alias the target directly, see header) -->
			<StaticResource x:Key="DefaultFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- DISPLAY -->
			<StaticResource x:Key="DisplayLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="DisplayMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="DisplaySmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- HEADLINE -->
			<StaticResource x:Key="HeadlineLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="HeadlineMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="HeadlineSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- TITLE -->
			<StaticResource x:Key="TitleLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="TitleMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="TitleSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- BODY -->
			<StaticResource x:Key="BodyLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="BodyMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="BodySmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- LABEL -->
			<StaticResource x:Key="LabelLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="LabelMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="LabelSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="LabelExtraSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- CAPTION -->
			<StaticResource x:Key="CaptionLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="CaptionMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="CaptionSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

		</ResourceDictionary>

		<!-- LIGHT THEME -->
		<ResourceDictionary x:Key="Light">

			<!-- Root Typeface Token (platform default; slots below alias the target directly, see header) -->
			<StaticResource x:Key="DefaultFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- DISPLAY -->
			<StaticResource x:Key="DisplayLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="DisplayMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="DisplaySmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- HEADLINE -->
			<StaticResource x:Key="HeadlineLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="HeadlineMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="HeadlineSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- TITLE -->
			<StaticResource x:Key="TitleLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="TitleMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="TitleSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- BODY -->
			<StaticResource x:Key="BodyLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="BodyMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="BodySmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- LABEL -->
			<StaticResource x:Key="LabelLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="LabelMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="LabelSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="LabelExtraSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

			<!-- CAPTION -->
			<StaticResource x:Key="CaptionLargeFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="CaptionMediumFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<StaticResource x:Key="CaptionSmallFontFamily" ResourceKey="ContentControlThemeFontFamily" />

		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
